{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    // Imports from scripts/*.mjs are allowed but not checked here — tsconfig.scripts.json
    // checks those, with settings suited to orchestration code.
    "allowJs": true
  },
  "include": ["test/**/*.ts", "vitest.config.ts", "vitest.db.config.ts"]
}
