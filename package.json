{
  "name": "mbele",
  "private": true,
  "version": "0.0.0",
  "description": "Africa-first builder opportunity platform. Brand name is a config token (PRODUCT_SPEC.md \u00a71).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace @mbele/web",
    "dev": "npm run dev --workspace @mbele/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json && tsc -p tsconfig.scripts.json",
    "budget": "node scripts/byte-budget.mjs",
    "budget:selftest": "node scripts/byte-budget.mjs --selftest",
    "og:card": "node scripts/og-card.mjs",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:rollback": "node scripts/migrate.mjs down",
    "db:status": "node scripts/migrate.mjs status",
    "db:seed": "node scripts/migrate.mjs seed",
    "verify": "npm run typecheck && npm run secretscan && npm run budget:selftest && npm run build && npm test && npm run budget",
    "verify:deployment": "node --experimental-strip-types scripts/verify-deployment.mjs",
    "secretscan": "bash scripts/secret-scan.sh",
    "db:test": "bash scripts/db-test.sh",
    "parity": "vitest run --config vitest.db.config.ts test/engine-parity.test.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "secret:set": "node scripts/set-service-secret.mjs",
    "notify": "node scripts/notify.mjs",
    "ingest": "node scripts/ingest.mjs",
    "reverify": "node scripts/reverify.mjs",
    "sources:check": "node scripts/check-source.mjs",
    "backup": "node scripts/backup.mjs",
    "golden:record": "node scripts/record-golden.mjs",
    "embed": "node scripts/embed.mjs",
    "recommend": "node scripts/recommend.mjs",
    "match:projects": "node scripts/match-projects.mjs",
    "projects:sweep": "node scripts/match-projects.mjs --sweep"
  },
  "devDependencies": {
    "@huggingface/transformers": "^4.2.0",
    "@types/pg": "^8.23.1",
    "axe-core": "^4.13.0",
    "jsdom": "^30.0.1",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
