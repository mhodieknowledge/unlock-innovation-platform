{
  "name": "mbele",
  "private": true,
  "version": "0.0.0",
  "description": "Africa-first builder opportunity platform. Brand name is a config token (PRODUCT_SPEC.md §1).",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "npm run build --workspace @mbele/web",
    "dev": "npm run dev --workspace @mbele/web",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc -p tsconfig.tools.json",
    "budget": "node scripts/byte-budget.mjs",
    "budget:selftest": "node scripts/byte-budget.mjs --selftest",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:rollback": "node scripts/migrate.mjs down",
    "db:status": "node scripts/migrate.mjs status",
    "db:seed": "node scripts/migrate.mjs seed",
    "verify": "npm run typecheck && npm run secretscan && npm run budget:selftest && npm run build && npm test && npm run budget",
    "secretscan": "bash scripts/secret-scan.sh",
    "db:test": "bash scripts/db-test.sh",
    "parity": "vitest run --config vitest.parity.config.ts",
    "secret:set": "node scripts/set-service-secret.mjs"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "pg": "8.23.0",
    "typescript": "6.0.3",
    "vitest": "5.0.0"
  }
}
