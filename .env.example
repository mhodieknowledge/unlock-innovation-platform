# Template only. Names, never values.
#
# This repository is PUBLIC. Never commit a filled-in copy of this file.
# Copy to .env.local for local development (.env.local is gitignored).
#
# Each variable is annotated with where the real value belongs:
#   [GHA] GitHub Actions secret  — repo Settings > Secrets and variables > Actions
#   [CF]  Cloudflare             — Workers & Pages > project > Settings > Variables and Secrets
#   [CF-PUBLIC]                  — Cloudflare plain variable, safe to expose
#   [SUPA-UI] Supabase dashboard — Authentication > Providers (not an env var at all)

# ── Brand (config, not secret — PRODUCT_SPEC.md §1) ───────────────────────────
# The name is a configuration token until trademark and domain checks pass.
BRAND_NAME=
BRAND_DOMAIN=
BRAND_HANDLE=

# ── Supabase ──────────────────────────────────────────────────────────────────
# [CF-PUBLIC] Also exposed to the browser as NEXT_PUBLIC_SUPABASE_URL.
SUPABASE_URL=
# [CF-PUBLIC] NOT a secret. Ships to the browser by design; RLS protects the data.
SUPABASE_ANON_KEY=
# [GHA] ONLY. Bypasses RLS. Never in a Worker reachable from the edge, never in
# client code, never here with a value. See SECURITY.md §2, DATA_MODEL.md §15.
SUPABASE_SERVICE_ROLE_KEY=
# [GHA] Migrations and nightly pg_dump backups. Contains the database password.
#
# MUST be the connection POOLER string, not the direct db.<ref>.supabase.co one.
# The direct endpoint is IPv6-only and GitHub Actions runners have no IPv6 route,
# so CI migrations fail with ENETUNREACH. Get it from the Supabase dashboard:
#   Connect > Connection pooling > Session mode  (port 5432, not 6543)
# Shape: postgresql://postgres.<ref>:<password>@<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL=

# ── Cloudflare (deploy credentials) ───────────────────────────────────────────
# [GHA] Used by the deploy workflow only. Not needed at runtime.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── LLM providers (AI_SYSTEM.md §3 — ordered fallback chain) ──────────────────
# Never hard-code a model name; models are configuration rows. IMPLEMENTATION_PLAN.md §16 rule 7.
# [GHA] Batch-tier extraction and rule derivation.
# [CF]  Also needed at the edge for the cached query compiler — the one LLM call
#       permitted in a request handler (rule 8).
GROQ_API_KEY=
# [GHA] Long-document extraction and the Brief Decoder.
GEMINI_API_KEY=
# [GHA] Third fallback in the chain.
CEREBRAS_API_KEY=
# Workers AI needs no key — it is a Worker binding declared in wrangler config.

# ── Email (NOTIFICATIONS.md §4 — 280/day budget) ──────────────────────────────
# [GHA] Digest assembly and the budgeted dispatcher.
BREVO_API_KEY=

# ── Telegram (NOTIFICATIONS.md §2 — the PRIMARY push channel) ─────────────────
# [CF] and [GHA]. The bot serves reads at the edge and sends pushes from the batch
# tier, so both tiers need the token.
# From @BotFather: /newbot, then /setcommands. Free and unmetered.
TELEGRAM_BOT_TOKEN=
# [CF] Passed to setWebhook as secret_token and checked on every update. Without
# it, anyone who learns the webhook URL can impersonate Telegram. Any random 32+
# characters: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=
# [CF] and [GHA]. NOT a database key. This unlocks exactly five SECURITY DEFINER
# functions (bot_redeem_link, bot_pause, bot_unlink, bot_tracker_summary,
# bot_verdicts) and reaches nothing else — which is how the bot personalises
# replies without a service key at the edge (SECURITY.md §2).
#
# Generate with `openssl rand -hex 32`, set it here AND install its digest in the
# database with `npm run secret:set telegram_bot` (run once, and again on rotate).
TELEGRAM_BOT_SECRET=

# ── Model names are CONFIGURATION, never code (AI_SYSTEM.md §2 guardrail 6) ──
# Absent means that capability is simply off, which is a supported degraded state:
# no query compiler falls back to the deterministic heuristic (§7), and no query
# embedding falls back to full-text search only (§6.2). Neither shows the user an
# error. Free catalogues rename models without notice, so there is no default here.
#
# [CF] The one LLM call permitted in a request handler, and only because its result
#      is cached in KV for 7 days. A Groq model id, e.g. a small instant llama.
QUERY_COMPILER_MODEL=
# [CF] A Workers AI text-embedding model producing 384 dimensions, to match the
#      halfvec(384) column. A wider model fails the query rather than silently
#      returning worse results.
QUERY_EMBEDDING_MODEL=
# [GHA] The local embedding model for the batch tier. Runs inside GitHub Actions with
#       no API and no quota (AI_SYSTEM.md §3.3), so this one has a working default in
#       scripts/embed.mjs and only needs setting to change it.
EMBEDDING_MODEL=

# ── Link safety (SECURITY.md §4 — fail closed) ────────────────────────────────
# [GHA] The verify-links job. [CF] if checks also run at render time.
GOOGLE_SAFE_BROWSING_API_KEY=

# ── Error tracking (optional until pre-launch) ────────────────────────────────
SENTRY_DSN=

# ── OAuth: NOT env vars ───────────────────────────────────────────────────────
# [SUPA-UI] These four go into the Supabase dashboard under
# Authentication > Providers, not into any env file:
#   GITHUB_OAUTH_CLIENT_ID / GITHUB_OAUTH_CLIENT_SECRET  -> GitHub provider
#   GOOGLE_OAUTH_CLIENT_ID / GOOGLE_OAUTH_CLIENT_SECRET  -> Google provider
# Paste the callback URL Supabase shows you back into each OAuth app.
