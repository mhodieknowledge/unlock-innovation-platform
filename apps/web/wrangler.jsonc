{
  // Cloudflare Workers deployment. SYSTEM_ARCHITECTURE.md §2: Cloudflare edge is
  // the request tier. ADR 0001 replaced OpenNext with @astrojs/cloudflare; the
  // host is unchanged.
  //
  // `main` and `assets.directory` are deliberately NOT set here. Since
  // @astrojs/cloudflare 14 the adapter runs through @cloudflare/vite-plugin,
  // which validates this file at config-resolution time — pointing `main` at the
  // build output fails before the build has produced it. The adapter supplies
  // both.
  //
  // No secrets in this file: it is committed and the repository is public
  // (invariant 11). Secrets are set with `wrangler secret put`, or in the
  // dashboard under Settings > Variables and Secrets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbele-web",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  "vars": {
    // Non-secret configuration only. PRODUCT_SPEC.md §1 keeps the brand name a
    // config token; it is provisional until the checks in README.md §6 item 1.
    "BRAND_NAME": "Mbele",
    "ENVIRONMENT": "production"
  },

  "env": {
    "preview": {
      "name": "mbele-web-preview",
      "vars": {
        "BRAND_NAME": "Mbele",
        "ENVIRONMENT": "preview"
      }
    }
  }
}
