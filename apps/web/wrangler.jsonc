{
  // Cloudflare Workers deployment. SYSTEM_ARCHITECTURE.md §2: Cloudflare edge is
  // the request tier. ADR 0001 replaced OpenNext with @astrojs/cloudflare; the
  // host is unchanged.
  //
  // `main` and `assets.directory` are deliberately NOT set here. Since
  // @astrojs/cloudflare 14 the adapter runs through @cloudflare/vite-plugin,
  // which validates this file at config-resolution time — pointing `main` at the
  // build output fails before the build has produced it. The adapter supplies
  // both.
  //
  // No secrets in this file: it is committed and the repository is public
  // (invariant 11). Secrets are set with `wrangler secret put`, or in the
  // dashboard under Settings > Variables and Secrets.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mbele-web",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],

  "observability": { "enabled": true },

  // `directory` is the adapter's to set (see above); this is only about how a path maps onto a
  // file it has already written.
  //
  // Every internal link and every canonical URL in this app is written without a trailing
  // slash — `/privacy`, not `/privacy/`. Cloudflare's default for a prerendered
  // `privacy/index.html` is the opposite: serve it at `/privacy/` and answer `/privacy` with a
  // 307 to it. So the footer link on every page, and the URL search engines were told is
  // canonical, both cost a redirect before the HTML arrives — on a 2G connection an extra
  // round trip, and for a crawler an extra hop to the page it was told not to use.
  //
  // `drop-trailing-slash` inverts it: `/privacy` serves the file, `/privacy/` redirects to
  // `/privacy`. The build output is untouched; only the mapping changes. It also puts the
  // prerendered pages in agreement with the dynamic ones, which have never had a trailing
  // slash to drop.
  "assets": {
    "html_handling": "drop-trailing-slash"
  },

  "vars": {
    // Non-secret configuration only. PRODUCT_SPEC.md §1 keeps the brand name a
    // config token; it is provisional until the checks in README.md §6 item 1.
    "BRAND_NAME": "Mbele",
    "ENVIRONMENT": "production"
  },

  "env": {
    "preview": {
      "name": "mbele-web-preview",
      "vars": {
        "BRAND_NAME": "Mbele",
        "ENVIRONMENT": "preview"
      }
    }
  }
}
