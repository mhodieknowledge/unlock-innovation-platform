---
// The page for an address that does not exist.
//
// Prerendered, so Cloudflare serves it for any unmatched path without waking a Worker — and so
// it still works when the data layer does not. There is nothing on it that needs a query.
//
// It is a real 404: SEO.md cares because a "soft 404" (a 200 response saying "not found")
// teaches a crawler that every wrong URL is a real page, and it costs a reader the one signal
// that tells them to check the link rather than wait.

import Base from "../layouts/Base.astro";

export const prerender = true;
---

<Base title="Not found" noindex>
  <div class="mx-auto flex min-h-[55vh] max-w-md flex-col items-center py-14 text-center">
    <h1 class="text-title font-bold tracking-[-0.015em]">There's nothing at this address</h1>

    <p class="prose-measure mt-3 text-dense text-ink-2">
      The link may be mistyped, or the thing it pointed at may have been merged into another
      listing. Nothing is broken on your side.
    </p>

    <a
      href="/opportunities"
      class="mt-6 inline-flex min-h-12 items-center rounded-row bg-brand px-6 text-dense font-semibold text-surface no-underline hover:bg-brand-ink"
    >
      Browse opportunities
    </a>

    <p class="mt-5 flex flex-wrap items-center justify-center gap-x-4 gap-y-2 text-meta">
      <a href="/countries" class="font-semibold text-brand no-underline hover:underline">Browse by country</a>
      <a href="/categories" class="font-semibold text-brand no-underline hover:underline">Browse by kind</a>
      <a href="/" class="font-semibold text-brand no-underline hover:underline">Start from the board</a>
    </p>
  </div>
</Base>
