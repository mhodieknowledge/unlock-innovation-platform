---
// The category index. SEO.md §1, priority 0.7.
//
// Every active category, with a live count. A category with nothing open is shown with a zero
// rather than hidden: the taxonomy is a claim about what this product covers, and quietly
// dropping the empty ones would make the coverage look more even than it is.

import Base from "../../layouts/Base.astro";
import { cachePolicyFor, getSessionUser } from "../../lib/auth";
import { getCategoryCounts } from "../../lib/db";
import { resolveLowData } from "../../lib/lowdata";
import { breadcrumb, itemList } from "../../lib/seo";
import { BRAND } from "@mbele/config";
import { runtimeEnv } from "~/lib/runtime";

export const prerender = false;

const env = runtimeEnv();

/**
 * The header has to know who is reading. `cachePolicyFor` below makes sure that
 * never reaches a shared cache — one without the other is the bug this fixes.
 */
const user = await getSessionUser(Astro.cookies, env);
const categories = await getCategoryCounts(env);
const open = categories.reduce((sum, row) => sum + row.open_count, 0);

cachePolicyFor(Astro.response, user, "public, s-maxage=900, stale-while-revalidate=3600");
Astro.response.headers.append("vary", "Save-Data, Cookie");

const lowData = resolveLowData({ cookies: Astro.cookies, request: Astro.request }).on;

const jsonLd = [
  breadcrumb([{ name: BRAND.name, path: "/" }, { name: "Kinds", path: "/categories" }], Astro.url),
  itemList(
    "Kinds of opportunity",
    categories.map((row) => ({ name: row.name, path: `/categories/${row.slug}` })),
    Astro.url,
  ),
];
---

<Base
  user={user}
  title="Opportunities by kind"
  description="Hackathons, grants, fellowships, scholarships and the rest — what is open in each, right now."
  canonical="/categories"
  lowData={lowData}
  jsonLd={jsonLd}
>
  <h1 class="text-title font-bold tracking-[-0.015em]">Opportunities by kind</h1>
  <p class="prose-measure mt-2 text-dense text-ink-2">
    {
      open > 0
        ? "Every kind we cover, with what is open in it now."
        : "Every kind we cover. Nothing is published yet, so every number here is zero."
    }
  </p>

  <div class="mt-6 grid grid-cols-2 gap-3 md:grid-cols-3 lg:grid-cols-4">
    {
      categories.map((row) => (
        <a
          href={`/categories/${row.slug}`}
          class="flex flex-col gap-1 rounded-sheet border border-line bg-surface p-4 text-ink no-underline transition-colors hover:border-line-strong hover:bg-sunken"
        >
          <span class="text-dense font-semibold">{row.name}</span>
          <span class="text-meta text-ink-3">
            {row.open_count === 0 ? "Nothing open yet" : `${row.open_count} open`}
          </span>
        </a>
      ))
    }
  </div>
</Base>
