---
// In-app messages. NOTIFICATIONS.md §2, and §10's invariant.
//
// "Every notification is always written in-app, regardless of whether any push
// channel delivers it. A user who never links Telegram and whose email is deferred
// still sees everything when they open the app. Nothing is lost, only delayed."
//
// That promise needs somewhere to be kept. This page is it: the record, in order,
// with the reason each message was sent and what actually happened to each push —
// because "we tried to email you and the budget said no" is more useful to a
// reader than silence, and it is the truth.
//
// Deliberately NOT here: an unread badge that nags, a count in the title, or any
// reason to come back other than something new having happened. §1.3 rules out
// engagement bait, and a messages page is where that temptation lives.

import Base from "../../layouts/Base.astro";
import { createAuthClient, getSessionUser } from "../../lib/auth";
import { reportError } from "../../lib/errors";
import { runtimeEnv } from "~/lib/runtime";

export const prerender = false;

const env = runtimeEnv();
const user = await getSessionUser(Astro.cookies, env);

if (!user) {
  return Astro.redirect(`/signin?returnTo=${encodeURIComponent(Astro.url.pathname)}`, 302);
}

const client = createAuthClient(Astro.cookies, env);
let failed = false;

interface Row {
  id: string;
  type: string;
  payload: Record<string, unknown>;
  reason: string;
  priority: number;
  read_at: string | null;
  created_at: string;
}

let rows: Row[] = [];

if (client) {
  try {
    // Marking everything read on view, before the read. Opening the page IS having
    // seen them, and a separate "mark as read" control would be a chore invented
    // to fill a page.
    if (Astro.request.method === "POST") {
      await client
        .from("notifications")
        .update({ read_at: new Date().toISOString() })
        .is("read_at", null);
    }

    const { data, error } = await client
      .from("notifications")
      .select("id, type, payload, reason, priority, read_at, created_at")
      .order("created_at", { ascending: false })
      .limit(100);

    if (error) throw new Error(error.message);
    rows = (data ?? []) as unknown as Row[];
  } catch (err) {
    await reportError(err, { route: "/you/inbox" }, env);
    failed = true;
  }
}

const unread = rows.filter((r) => r.read_at === null).length;

/** Plain-language headings, the same vocabulary the settings page uses. */
const TYPE_LABELS: Record<string, string> = {
  deadline_reminder: "Deadline",
  digest: "Digest",
  opportunity_changed: "Something changed",
  opportunity_closed: "Closed",
  request_received: "Someone asked to join",
  request_accepted: "Request accepted",
  request_declined: "Request declined",
  team_update: "Team update",
  project_match: "New match",
  moderation_outcome: "Report outcome",
  security: "Security",
  system: "Service message",
};

const dateTime = (iso: string) =>
  new Date(iso).toLocaleString("en-GB", {
    dateStyle: "medium",
    timeStyle: "short",
    timeZone: user.timezone,
  });

function headline(row: Row): string {
  const p = row.payload ?? {};
  if (typeof p["title"] === "string" && p["title"]) return p["title"];
  if (row.type === "digest") {
    const sections = Array.isArray(p["sections"]) ? (p["sections"] as { items?: unknown[] }[]) : [];
    const n = sections.reduce((sum, s) => sum + (s.items?.length ?? 0), 0);
    return n > 0 ? `${n} thing${n === 1 ? "" : "s"} worth knowing about` : "Your digest";
  }
  return TYPE_LABELS[row.type] ?? "Message";
}

function link(row: Row): string | null {
  const payload = row.payload ?? {};

  // A collaboration message is useless without the action it refers to. §5.1 says the
  // owner "gets a notification" — a notification they cannot act on is a notification that
  // makes the request expire politely.
  const threadId = payload["thread_id"];
  if (typeof threadId === "string" && threadId) return `/threads/${threadId}`;
  if (typeof payload["request_id"] === "string" && payload["request_id"]) return "/requests";

  const slug = payload["slug"];
  return typeof slug === "string" && slug ? `/opportunities/${slug}` : null;
}
---

<Base title="Your messages" noindex user={user} unread={unread}>
  <h1 class="text-title font-bold tracking-[-0.015em]">Your messages</h1>
  <p class="mt-2 max-w-prose text-dense text-ink-2">
    Everything we have sent you, whether or not it reached you by Telegram or email. Nothing here is
    ever only a push — the record is written first, so nothing is lost when a channel is off, paused
    or out of budget.
  </p>

  {
    failed && (
      <p class="mt-4 max-w-prose rounded-sheet border border-danger/30 bg-noteligible-wash p-4 text-dense text-danger">
        We couldn't load your messages just now. Nothing has been deleted — try again in a moment.
      </p>
    )
  }

  {
    !failed && rows.length === 0 && (
      <div class="mt-6 max-w-prose rounded-sheet border border-line bg-surface p-5">
        <p class="text-dense font-semibold">Nothing yet.</p>
        <p class="mt-1 text-dense text-ink-2">
          Save something to your tracker and we will remind you before it closes. That is the only
          thing we will message you about unprompted.
        </p>
        <p class="mt-3">
          <a href="/opportunities" class="font-semibold text-brand no-underline hover:underline">Find something to save</a>
        </p>
      </div>
    )
  }

  {
    unread > 0 && (
      <form method="post" class="mt-4">
        <button type="submit" class="min-h-11 rounded-row border border-line-strong bg-surface px-4 text-dense font-semibold text-ink hover:bg-sunken">
          Mark {unread} as read
        </button>
      </form>
    )
  }

  {
    rows.length > 0 && (
      <ul class="mt-6 flex max-w-prose flex-col gap-3">
        {rows.map((row) => (
          <li class={`rounded-sheet border bg-surface p-4 ${row.read_at === null ? "border-brand/30" : "border-line"}`}>
            <p class="eyebrow text-ink-3">
              {row.read_at === null && <span class="mr-1 inline-block size-[6px] rounded-full bg-brand align-middle" aria-hidden="true" />}
              {TYPE_LABELS[row.type] ?? "Message"} · {dateTime(row.created_at)}
            </p>
            <p class="mt-1 text-dense font-semibold">{headline(row)}</p>
            {/* §1.1: the reason is a required field, "rendered in the message". */}
            <p class="mt-1 text-dense text-ink-2">{row.reason}</p>
            {link(row) && (
              <p class="mt-2">
                <a href={link(row)!} class="text-dense font-semibold text-brand no-underline hover:underline">
                  Open it
                </a>
              </p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-8 text-micro text-ink-2">
    <a href="/you/notifications" class="font-semibold text-brand no-underline hover:underline">Choose what we send and when</a>
  </p>
</Base>
