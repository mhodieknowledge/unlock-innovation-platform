---
// The signed-in home. PRODUCT_SPEC.md §14.1 and §14.2, both `[PR]`.
//
// This page replaces the infinite feed, and the two surfaces on it are deliberately
// SMALL. §14.1 caps "Your window" at 8 items; §14.2 caps the action list at 5. A feed
// optimises for time spent; a bounded, dated list optimises for something being done —
// and on a metered connection, the second is the only defensible choice.
//
// Everything here is precomputed (§8: "Zero compute at request time") or derived from
// deterministic rules over the user's own state (§14.2: "not from an LLM"). No island,
// no JavaScript: both surfaces are text and links.

import Base from "../../layouts/Base.astro";
import { createAuthClient, getSessionUser } from "../../lib/auth";
import { deadlineFacts, countdownLabel } from "../../lib/deadline";
import { reportError } from "../../lib/errors";
import { resolveLowData } from "../../lib/lowdata";
import { SURFACE_CAPS } from "@mbele/config";

export const prerender = false;

const env = (Astro.locals as { runtime?: { env?: Record<string, string> } }).runtime?.env ?? {};
const user = await getSessionUser(Astro.cookies, env);

if (!user) {
  return Astro.redirect(`/signin?returnTo=${encodeURIComponent(Astro.url.pathname)}`, 302);
}

const client = createAuthClient(Astro.cookies, env);

// DESIGN_SYSTEM.md §10. The account preference is available here because the page already
// has the session, so a reader who set low-data on their phone gets it on this page too.
const lowData = resolveLowData({
  cookies: Astro.cookies,
  request: Astro.request,
  accountPreference: user.low_data_mode,
}).on;

interface WindowItem {
  source: string;
  slug: string;
  title: string;
  deadline_at: string | null;
  deadline_precision: string;
  is_rolling: boolean;
  cost: string;
  organisation_name: string | null;
  category_name: string | null;
  verdict: string | null;
  reasons: string[];
}

interface Action {
  kind: string;
  headline: string;
  reason: string;
  href: string;
  priority: number;
}

let windowItems: WindowItem[] = [];
let actions: Action[] = [];
let pendingRequests = 0;
let failed = false;

if (client) {
  try {
    const [windowResult, actionResult, requestResult] = await Promise.all([
      client.rpc("your_window", { p_user_id: user.id, p_limit: SURFACE_CAPS.yourWindow }),
      client.rpc("next_actions_capped", { p_user_id: user.id, p_limit: SURFACE_CAPS.nextActions }),
      // Someone waiting for an answer is the one collaboration thing that belongs on this
      // page: another person's next fortnight depends on it, and a request nobody sees
      // expires (COLLABORATION_SYSTEM.md §2.3). Not a badge, not a count in the title —
      // one line, and only when there is something behind it.
      client.rpc("my_requests", { p_direction: "in" }),
    ]);
    if (windowResult.error) throw new Error(windowResult.error.message);
    if (actionResult.error) throw new Error(actionResult.error.message);
    windowItems = (windowResult.data ?? []) as unknown as WindowItem[];
    actions = (actionResult.data ?? []) as unknown as Action[];
    // A failure here must not cost the page: the two capped surfaces above are the point
    // of §14, and this line is an aside.
    pendingRequests = requestResult.error
      ? 0
      : ((requestResult.data ?? []) as { state: string }[]).filter((r) => r.state === "pending")
          .length;
  } catch (err) {
    await reportError(err, { route: "/you" }, env);
    failed = true;
  }
}

// §8 `[PR]`: the fallback is shown with an HONEST label, never dressed up as a
// personalised recommendation.
const isColdStart = windowItems.length > 0 && windowItems[0]!.source === "country_board";

const verdictWord = (verdict: string | null) => {
  switch (verdict) {
    case "eligible":
      return "You're eligible";
    case "likely_eligible":
      return "Likely eligible";
    case "not_eligible":
      return "Not eligible";
    default:
      return null;
  }
};

const today = new Date().toLocaleDateString("en-GB", {
  dateStyle: "long",
  timeZone: user.timezone,
});
---

<Base title="Your window" noindex user={user} lowData={lowData} offlineCapable>
  <h1 class="text-title font-semibold">Your window</h1>

  {
    /* §14.1: "States what it is doing and why each item is there." */
    !failed && (
      <p class="mt-2 max-w-prose text-dense text-ink-2">
        {isColdStart
          ? `Closing soon, from the whole catalogue — as of ${today}. We have nothing personal to show you yet: fill in your eligibility details and this becomes a list of things you can actually enter.`
          : `Up to ${SURFACE_CAPS.yourWindow} things closing in the next 30 days that you can enter, as of ${today}. Nothing else — this is not a feed.`}
      </p>
    )
  }

  {
    failed && (
      <p class="mt-4 max-w-prose border-l-[3px] border-danger bg-noteligible-wash p-3 text-dense">
        We couldn't build your window just now. Nothing is lost — your tracker and your
        saved items are unaffected. Try again in a moment.
      </p>
    )
  }

  {
    /* §14.2 first, because an action is more useful than a list. UX_FLOWS.md §7 puts it
       at the top of the signed-in home for the same reason. */
    actions.length > 0 && (
      <section class="mt-6 max-w-prose" aria-labelledby="next">
        <h2 id="next" class="text-subtitle font-semibold">What to do next</h2>
        <ul class="mt-3 divide-y divide-line border-y border-line">
          {actions.map((action) => (
            <li class="py-3">
              <a href={action.href} class="text-dense font-semibold text-ink no-underline hover:underline">
                {action.headline}
              </a>
              {/* §14.2 `[PR]`: "Each item states the reason... No motivational filler." */}
              <p class="mt-1 text-dense text-ink-2">{action.reason}</p>
            </li>
          ))}
        </ul>
        <p class="mt-2 text-micro text-ink-2">
          At most {SURFACE_CAPS.nextActions}, worked out from your own saved items and
          details. Never from an AI.
        </p>
      </section>
    )
  }

  {
    windowItems.length > 0 && (
      <section class="mt-8" aria-labelledby="window">
        <h2 id="window" class="text-subtitle font-semibold">
          {isColdStart ? "Closing soon" : "Closing in the next 30 days"}
        </h2>

        <ul class="mt-3 divide-y divide-line border-y border-line">
          {windowItems.map((item) => {
            const facts = deadlineFacts({
              deadline_at: item.deadline_at,
              deadline_precision: item.deadline_precision as never,
              opens_at: null,
              is_rolling: item.is_rolling,
            });
            const verdict = verdictWord(item.verdict);
            return (
              <li class="py-4">
                <a
                  href={`/opportunities/${item.slug}`}
                  class="text-body font-semibold text-ink no-underline hover:underline"
                >
                  {item.title}
                </a>
                <p class="mt-1 text-dense text-ink-2">
                  {[countdownLabel(facts), item.organisation_name, item.category_name]
                    .filter(Boolean)
                    .join(" · ")}
                </p>
                {/* §14.3 `[PR]`: the explanation is templated from matched rules and
                    overlapping tags. Never free-generated. */}
                {item.reasons.length > 0 && (
                  <p class="mt-1 text-dense">
                    {verdict && <strong class="font-semibold">{verdict}. </strong>}
                    {item.reasons.join(" · ")}
                  </p>
                )}
                {item.reasons.length === 0 && verdict && (
                  <p class="mt-1 text-dense font-semibold">{verdict}</p>
                )}
              </li>
            );
          })}
        </ul>

        <p class="mt-3 text-micro text-ink-2">
          {isColdStart ? (
            <>
              This is the whole catalogue's closing-soon list, not a personalised one.
              <a href="/you/eligibility" class="ml-1 text-brand">Add your details</a> and it
              becomes personal.
            </>
          ) : (
            <>
              Capped at {SURFACE_CAPS.yourWindow}. Worked out overnight from your eligibility
              details and what you have saved — <a href="/opportunities" class="text-brand">browse everything</a>.
            </>
          )}
        </p>
      </section>
    )
  }

  {
    !failed && windowItems.length === 0 && (
      <div class="mt-6 max-w-prose rounded-sheet border border-line bg-surface p-4">
        <p class="text-dense font-semibold">Nothing is open that we can show you yet.</p>
        <p class="mt-1 text-dense text-ink-2">
          That is the honest answer rather than an error. The catalogue is still small, and
          we would rather show you nothing than pad this out with things that are not for
          you.
        </p>
        <p class="mt-3">
          <a href="/opportunities" class="text-brand">See everything we have →</a>
        </p>
      </div>
    )
  }

  {
    pendingRequests > 0 && (
      <p class="mt-8 max-w-prose border-l-[3px] border-brand bg-brand-wash p-3 text-dense">
        <a href="/requests" class="text-brand font-semibold">
          {pendingRequests} {pendingRequests === 1 ? "person is" : "people are"} waiting for your
          answer →
        </a>
      </p>
    )
  }

  <p class="mt-8 text-micro text-ink-2">
    <a href="/tracker" class="underline">Your tracker</a> ·
    <a href="/you/projects" class="underline">Your projects</a> ·
    <a href="/you/eligibility" class="underline">Your eligibility details</a> ·
    <a href="/you/notifications" class="underline">What we send you</a>
  </p>
</Base>
