---
// Notification settings. NOTIFICATIONS.md §8 and UX_FLOWS.md §14.
//
// "A type × channel matrix at /you/notifications, with plain-language rows ('When
// something I saved is about to close') rather than system type names."
//
// The caps are stated on the page, visibly, and that is not decoration: §8 says
// "stating the limit is itself a trust signal, and it sets an expectation the
// system is architecturally obliged to keep." The obligation is enforced in
// enqueue_notification, so this page is describing the system rather than making a
// promise about it.
//
// No island. Every control is a form post, so the page costs no JavaScript at all
// — which is the right trade on a metered connection for a screen visited rarely.

import Base from "../../layouts/Base.astro";
import { createAuthClient, getSessionUser, personalWritesAllowed } from "../../lib/auth";
import { reportError } from "../../lib/errors";
import { runtimeEnv } from "~/lib/runtime";

export const prerender = false;

const env = runtimeEnv();
const user = await getSessionUser(Astro.cookies, env);

if (!user) {
  return Astro.redirect(`/signin?returnTo=${encodeURIComponent(Astro.url.pathname)}`, 302);
}

const client = createAuthClient(Astro.cookies, env);
let flash = "";
let flashKind: "ok" | "error" = "ok";

/**
 * §8: plain-language rows, not system type names. The order is the order someone
 * would care about them in, not the enum's order.
 *
 * `security` is deliberately absent: §9 forbids unsubscribing from it, so offering
 * a switch that does nothing would be a lie about what the page controls.
 */
const ROWS: { type: string; label: string; detail: string; channels: string[] }[] = [
  {
    type: "deadline_reminder",
    label: "When something I saved is about to close",
    detail: "7 days, and again near the deadline. Driven by your tracker, not by browsing.",
    channels: ["telegram", "email"],
  },
  {
    type: "opportunity_changed",
    label: "When a deadline or the rules change on something I saved",
    detail: "Shows the old value and the new one.",
    channels: ["telegram", "email"],
  },
  {
    type: "opportunity_closed",
    label: "When something I saved closes",
    detail: "So your tracker does not quietly go stale.",
    channels: ["telegram"],
  },
  {
    type: "digest",
    label: "A digest of what is closing and what is new",
    detail: "Skipped entirely when there is not enough worth sending.",
    channels: ["telegram", "email"],
  },
  {
    type: "request_received",
    label: "When someone asks to join something with me",
    detail: "Person-to-person and time-sensitive, so this one is not rate-limited.",
    channels: ["telegram"],
  },
  {
    type: "team_update",
    label: "When a team I am in changes",
    detail: "In-app only. It is rarely urgent.",
    channels: [],
  },
  {
    type: "moderation_outcome",
    label: "The outcome of something I reported",
    detail: "Always sent, so a report never disappears into silence.",
    channels: ["email"],
  },
];

const CHANNEL_LABELS: Record<string, string> = { telegram: "Telegram", email: "Email" };

if (client && Astro.request.method === "POST" && personalWritesAllowed(user)) {
  try {
    const form = await Astro.request.formData();
    const action = String(form.get("action") ?? "matrix");

    if (action === "matrix") {
      const rows: { user_id: string; type: string; channel: string; enabled: boolean }[] = [];
      for (const row of ROWS) {
        for (const channel of row.channels) {
          rows.push({
            user_id: user.id,
            type: row.type,
            channel,
            // An absent checkbox means off. Writing the row either way means the
            // stored value is always explicit rather than "absent, so default".
            enabled: form.get(`pref:${row.type}:${channel}`) === "on",
          });
        }
      }
      const { error } = await client
        .from("notification_preferences")
        .upsert(rows, { onConflict: "user_id,type,channel" });
      if (error) throw new Error(error.message);
      flash = "Saved.";
    } else if (action === "settings") {
      const hour = (k: string, fallback: number) => {
        const v = Number(String(form.get(k) ?? ""));
        return Number.isInteger(v) && v >= 0 && v <= 23 ? v : fallback;
      };
      const frequency = String(form.get("digest_frequency") ?? "weekly");
      const { error } = await client.from("user_notification_settings").upsert(
        {
          user_id: user.id,
          digest_frequency: ["daily", "weekly", "off"].includes(frequency) ? frequency : "weekly",
          quiet_hours_start: hour("quiet_hours_start", 21),
          quiet_hours_end: hour("quiet_hours_end", 7),
          updated_at: new Date().toISOString(),
        },
        { onConflict: "user_id" },
      );
      if (error) throw new Error(error.message);
      flash = "Saved.";
    } else if (action === "pause_all") {
      const { error } = await client.from("user_notification_settings").upsert(
        {
          user_id: user.id,
          paused_until: new Date(Date.now() + 30 * 86_400_000).toISOString(),
          updated_at: new Date().toISOString(),
        },
        { onConflict: "user_id" },
      );
      if (error) throw new Error(error.message);
      flash = "Paused for 30 days. Your account and everything you saved are untouched.";
    } else if (action === "resume_all") {
      const { error } = await client
        .from("user_notification_settings")
        .upsert(
          { user_id: user.id, paused_until: null, updated_at: new Date().toISOString() },
          { onConflict: "user_id" },
        );
      if (error) throw new Error(error.message);
      flash = "Messages are on again.";
    } else if (action === "unlink_telegram") {
      const { error } = await client
        .from("notification_channels")
        .delete()
        .eq("user_id", user.id)
        .eq("channel", "telegram");
      if (error) throw new Error(error.message);
      flash = "Telegram unlinked. Send /link with a fresh code to connect it again.";
    }
  } catch (err) {
    await reportError(err, { route: "/you/notifications" }, env);
    flashKind = "error";
    flash = "We couldn't save that. Nothing was changed — try again.";
  }
}

const { data: prefRows } = client
  ? await client.from("notification_preferences").select("type, channel, enabled").eq("user_id", user.id)
  : { data: null };

const { data: settingsRow } = client
  ? await client
      .from("user_notification_settings")
      .select("digest_frequency, quiet_hours_start, quiet_hours_end, paused_until")
      .eq("user_id", user.id)
      .maybeSingle()
  : { data: null };

const { data: telegramRow } = client
  ? await client
      .from("notification_channels")
      .select("address, verified_at, is_active, paused_until")
      .eq("user_id", user.id)
      .eq("channel", "telegram")
      .maybeSingle()
  : { data: null };

const prefs = new Map<string, boolean>(
  ((prefRows ?? []) as { type: string; channel: string; enabled: boolean }[]).map((r) => [
    `${r.type}:${r.channel}`,
    r.enabled,
  ]),
);
// Absent means the default, and the default is on (§3's default channels).
const isOn = (type: string, channel: string) => prefs.get(`${type}:${channel}`) !== false;

const settings = (settingsRow ?? {}) as {
  digest_frequency?: string;
  quiet_hours_start?: number;
  quiet_hours_end?: number;
  paused_until?: string | null;
};
const telegram = telegramRow as { address?: string; is_active?: boolean } | null;

const pausedUntil = settings.paused_until ? new Date(settings.paused_until) : null;
const isPaused = pausedUntil !== null && pausedUntil > new Date();

// Set by the link-code endpoint on its way back here.
const issuedCode = Astro.url.searchParams.get("code");
const linkError = Astro.url.searchParams.get("link");
const botHandle = env["TELEGRAM_BOT_HANDLE"] ?? null;
const HOURS = Array.from({ length: 24 }, (_, h) => h);
const pad = (h: number) => `${String(h).padStart(2, "0")}:00`;
---

<Base title="Notifications" noindex user={user}>
  <h1 class="text-title font-bold tracking-[-0.015em]">Notifications</h1>

  <!-- §8: the caps, stated visibly. -->
  <p class="mt-3 max-w-prose rounded-sheet border border-brand/30 bg-brand-wash p-4 text-dense">
    At most <strong class="font-semibold">one digest a day</strong> and
    <strong class="font-semibold">three other messages</strong>. We never send anything to get your
    attention back — no streaks, no unread counts, no notifications about other people's activity
    you did not ask about. Every message says why it was sent.
  </p>

  {
    flash && (
      <p
        class={`mt-3 max-w-prose rounded-sheet border p-4 text-dense font-medium ${
          flashKind === "ok"
            ? "border-eligible/30 bg-eligible-wash text-eligible"
            : "border-danger/30 bg-noteligible-wash text-danger"
        }`}
        role="status"
      >
        {flash}
      </p>
    )
  }

  {
    isPaused && (
      <div class="mt-3 max-w-prose rounded-sheet border border-unclear/30 bg-unclear-wash p-4 text-dense">
        <p>
          Everything is paused until {pausedUntil!.toLocaleDateString("en-GB", { dateStyle: "long" })}.
          You will still see everything in the app, and security messages still come through.
        </p>
        <form method="post" class="mt-2">
          <input type="hidden" name="action" value="resume_all" />
          <button type="submit" class="inline-flex min-h-11 items-center font-semibold underline">Turn messages back on</button>
        </form>
      </div>
    )
  }

  <!-- ── Telegram ────────────────────────────────────────────────────────── -->
  <section class="mt-8 max-w-prose rounded-sheet border border-line bg-surface p-5" aria-labelledby="telegram">
    <h2 id="telegram" class="text-subtitle font-semibold">Telegram</h2>
    <p class="mt-1 text-dense text-ink-2">
      Free to receive, and it does not use your email allowance. It is also a full read client —
      ask it what is closing this week without opening the site.
    </p>

    {
      telegram?.address ? (
        <div class="mt-3">
          <p class="text-dense">
            Linked{telegram.is_active === false ? " — but pushes are off after three failed sends. Send /start to the bot to turn them back on." : "."}
          </p>
          <form method="post" class="mt-2">
            <input type="hidden" name="action" value="unlink_telegram" />
            <button type="submit" class="min-h-11 rounded-row border border-line-strong bg-surface px-4 text-dense font-semibold text-ink hover:bg-sunken">
              Unlink Telegram
            </button>
          </form>
        </div>
      ) : (
        <div class="mt-3">
          {issuedCode ? (
            <div>
              <p class="text-dense">
                Send this to the bot{botHandle ? ` (${botHandle})` : ""} within 15 minutes:
              </p>
              <p class="mt-2 select-all rounded-row bg-sunken px-3 py-2 font-mono text-subtitle">
                /link {issuedCode}
              </p>
              <p class="mt-2 text-micro text-ink-2">
                One use, then it expires. If it stops working, generate another.
              </p>
            </div>
          ) : (
            <form method="post" action="/api/v1/telegram/link-code">
              <button type="submit" class="min-h-11 rounded-row bg-brand px-4 font-semibold text-surface hover:bg-brand-ink">
                Get a link code
              </button>
            </form>
          )}
          {linkError && (
            <p class="mt-2 text-dense text-danger">
              We couldn't generate a code just now. Nothing was changed — try again.
            </p>
          )}
        </div>
      )
    }
  </section>

  <!-- ── The matrix ──────────────────────────────────────────────────────── -->
  <form method="post" class="mt-8 max-w-prose rounded-sheet border border-line bg-surface p-5">
    <input type="hidden" name="action" value="matrix" />
    <h2 class="text-subtitle font-semibold">What we send</h2>
    <p class="mt-1 text-dense text-ink-2">
      Everything is always written in the app, whatever you switch off here. Turning a channel off
      stops the push, never the record.
    </p>

    <ul class="mt-4 flex flex-col gap-3">
      {
        ROWS.map((row) => (
          <li class="rounded-row bg-sunken p-3">
            <p class="text-dense font-semibold">{row.label}</p>
            <p class="text-micro text-ink-2">{row.detail}</p>
            {row.channels.length === 0 ? (
              <p class="mt-1 text-micro text-ink-2">In the app only.</p>
            ) : (
              <div class="mt-2 flex flex-wrap gap-4">
                {row.channels.map((channel) => (
                  <label class="flex items-center gap-2 text-dense">
                    <input
                      type="checkbox"
                      name={`pref:${row.type}:${channel}`}
                      checked={isOn(row.type, channel)}
                      class="h-4 w-4 accent-brand"
                    />
                    {CHANNEL_LABELS[channel]}
                  </label>
                ))}
              </div>
            )}
          </li>
        ))
      }
    </ul>

    <p class="mt-4 text-micro text-ink-2">
      Security messages — a new sign-in, an email change — are always sent. There is no switch for
      them on purpose.
    </p>

    <button type="submit" class="mt-4 min-h-12 rounded-row bg-brand px-5 font-semibold text-surface hover:bg-brand-ink">
      Save what we send
    </button>
  </form>

  <!-- ── Frequency and quiet hours ───────────────────────────────────────── -->
  <form method="post" class="mt-10 max-w-prose space-y-5 rounded-sheet border border-line bg-surface p-5">
    <input type="hidden" name="action" value="settings" />
    <h2 class="text-subtitle font-semibold">When we send</h2>

    <label class="block">
      <span class="block text-meta font-semibold text-ink">Digest</span>
      <select
        name="digest_frequency"
        class="mt-1 h-12 w-full rounded-row border border-line-strong bg-surface px-3 text-dense focus:border-brand"
      >
        <option value="weekly" selected={(settings.digest_frequency ?? "weekly") === "weekly"}>
          Weekly — the default, and the one most worth reading
        </option>
        <option value="daily" selected={settings.digest_frequency === "daily"}>Daily</option>
        <option value="off" selected={settings.digest_frequency === "off"}>Off</option>
      </select>
      <span class="mt-1 block text-micro text-ink-2">
        A digest with fewer than two things in it is not sent at all.
      </span>
    </label>

    <fieldset>
      <legend class="text-meta font-semibold text-ink">
        Quiet hours ({user.timezone})
      </legend>
      <div class="mt-1 flex items-center gap-2">
        <select
          name="quiet_hours_start"
          aria-label="Quiet hours start"
          class="h-12 rounded-row border border-line-strong bg-surface px-3 text-dense focus:border-brand"
        >
          {HOURS.map((h) => (
            <option value={h} selected={(settings.quiet_hours_start ?? 21) === h}>
              {pad(h)}
            </option>
          ))}
        </select>
        <span class="text-dense text-ink-2">to</span>
        <select
          name="quiet_hours_end"
          aria-label="Quiet hours end"
          class="h-12 rounded-row border border-line-strong bg-surface px-3 text-dense focus:border-brand"
        >
          {HOURS.map((h) => (
            <option value={h} selected={(settings.quiet_hours_end ?? 7) === h}>
              {pad(h)}
            </option>
          ))}
        </select>
      </div>
      <p class="mt-1 text-micro text-ink-2">
        Nothing is pushed during these hours. The single exception is a deadline within six hours on
        something you saved — missing that costs more than being woken.
      </p>
    </fieldset>

    <button type="submit" class="min-h-12 rounded-row bg-brand px-5 font-semibold text-surface hover:bg-brand-ink">
      Save when we send
    </button>
  </form>

  {
    !isPaused && (
      <form method="post" class="mt-10 max-w-prose rounded-sheet border border-line bg-surface p-5">
        <input type="hidden" name="action" value="pause_all" />
        <h2 class="text-subtitle font-semibold">Pause everything</h2>
        <p class="mt-1 text-dense text-ink-2">
          Stops every message for 30 days without changing anything else. Your account, your tracker
          and your saved items are untouched.
        </p>
        <button type="submit" class="mt-3 min-h-11 rounded-row border border-line-strong bg-surface px-4 text-dense font-semibold text-ink hover:bg-sunken">
          Pause for 30 days
        </button>
      </form>
    )
  }

  <p class="mt-8 text-micro text-ink-2">
    <a href="/you/account" class="font-semibold text-brand no-underline hover:underline">Your account, export and deletion</a>
  </p>
</Base>
