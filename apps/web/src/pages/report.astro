---
// Report form. PRODUCT_SPEC.md §23, MODERATION_AND_TRUST.md §5,
// IMPLEMENTATION_PLAN.md §3 ("report form, logged-out, Turnstile").
//
// Handles its own POST rather than posting JSON from an island, so it works with
// JavaScript disabled. For an audience on expensive, unreliable connections, a
// report that needs a working JS bundle is a report that does not get filed —
// and the whole point of logged-out reporting is to collect the signal from
// people who would otherwise give up.

import Base from "../layouts/Base.astro";
import { getClient } from "../lib/db";
import { reportError } from "../lib/errors";
import { runtimeEnv } from "~/lib/runtime";

export const prerender = false;

const env = runtimeEnv();

const LISTING_REASONS: [string, string][] = [
  ["expired", "This has closed"],
  ["wrong_deadline", "The deadline is wrong"],
  ["wrong_eligibility", "The eligibility is wrong"],
  ["broken_link", "The link is broken"],
  ["possible_scam", "This looks like a scam"],
  ["requires_payment", "It asks for a payment to apply"],
  ["duplicate", "This is a duplicate"],
  ["incorrect_info", "Something else is incorrect"],
  ["other", "Other"],
];

/**
 * A person is not a listing, and the reasons are not the same ones. MODERATION_AND_TRUST.md §5
 * and the `reports` table's `subject_type` both carry `profile`; COLLABORATION_SYSTEM.md §4
 * requires reporting to be "always available alongside" blocking, which means it has to work
 * from a profile page and cannot be a form that only understands opportunity slugs.
 */
const PROFILE_REASONS: [string, string][] = [
  ["harassment", "They are harassing or abusing someone"],
  ["impersonation", "They are pretending to be someone else"],
  ["spam", "Spam or advertising"],
  ["inappropriate", "Inappropriate content on their profile"],
  ["other", "Other"],
];

const subjectSlug = Astro.url.searchParams.get("subject");
const profileHandle = Astro.url.searchParams.get("profile");
const isProfile = profileHandle !== null;
const REASONS = isProfile ? PROFILE_REASONS : LISTING_REASONS;

type State = "form" | "received" | "error" | "not_found";
let state: State = "form";
let message = "";
let chosenReason = "";

if (Astro.request.method === "POST") {
  try {
    const form = await Astro.request.formData();
    chosenReason = String(form.get("reason") ?? "");
    const slug = String(form.get("subject") ?? subjectSlug ?? "");
    const detail = String(form.get("detail") ?? "").slice(0, 1000);

    const client = getClient(env);
    if (!client) throw new Error("data layer unavailable");

    /**
     * For a profile, the subject id comes from `public_profile()` — the same function the
     * profile page renders from. That is deliberate: you can only report a page you could
     * open, and a handle that returns nothing must not become a report against an id this
     * form guessed. For a listing it is the slug, as before.
     */
    let subjectId: string | null = null;

    if (isProfile) {
      const { data: rows } = await client.rpc("public_profile", {
        p_handle: String(form.get("profile") ?? profileHandle ?? ""),
      });
      subjectId =
        ((rows ?? []) as { user_id?: string }[])[0]?.user_id ?? null;
    } else {
      const { data: opp } = await client
        .from("opportunities")
        .select("id")
        .eq("slug", slug)
        .maybeSingle();
      subjectId = (opp as { id: string } | null)?.id ?? null;
    }

    if (!subjectId) {
      state = "not_found";
      message = isProfile
        ? "We couldn't find that profile. It may have been taken down already."
        : "We couldn't find that listing. It may already have been removed.";
    } else if (!REASONS.some(([value]) => value === chosenReason)) {
      state = "error";
      message = "Please choose a reason.";
    } else {
      // Posting through our own API keeps the rate limit, the fingerprinting and
      // the auto-dispute trigger on one path, rather than duplicating the rules
      // here where they would drift.
      const response = await fetch(new URL("/api/v1/reports", Astro.url), {
        method: "POST",
        headers: {
          "content-type": "application/json",
          // Forwarded so the fingerprint is the reporter's, not the Worker's.
          ...(Astro.request.headers.get("cf-connecting-ip")
            ? { "cf-connecting-ip": Astro.request.headers.get("cf-connecting-ip")! }
            : {}),
        },
        body: JSON.stringify({
          subject_type: isProfile ? "profile" : "opportunity",
          subject_id: subjectId,
          reason: chosenReason,
          detail: detail || undefined,
        }),
      });

      const body = (await response.json()) as {
        data?: { message?: string };
        error?: { message?: string };
      };

      if (response.ok) {
        state = "received";
        message = body.data?.message ?? "Thank you — this is now in our review queue.";
      } else {
        state = "error";
        message = body.error?.message ?? "We couldn't record that report.";
      }
    }
  } catch (err) {
    await reportError(err, { route: "/report" }, env);
    state = "error";
    message = "We couldn't record that report. Please try again shortly.";
  }
}

// SEO.md §1: a user tool, not content.
---

<Base title={isProfile ? "Report a profile" : "Report a problem"} noindex>
  <h1 class="text-title font-semibold">
    {isProfile ? `Report /b/${profileHandle}` : "Report a problem"}
  </h1>

  {
    state === "received" ? (
      <div class="mt-4 border-l-[3px] border-eligible bg-eligible-wash p-4">
        <p class="font-semibold text-eligible">
          <span aria-hidden="true">●</span> Report received
        </p>
        <p class="mt-1 text-dense text-ink-2">{message}</p>
        <p class="mt-3 text-dense">
          <a href="/opportunities" class="text-brand">Back to open opportunities</a>
        </p>
      </div>
    ) : (
      <>
        <p class="prose-measure mt-2 text-dense text-ink-2">
          {isProfile
            ? "Reporting is separate from blocking, and you can do both. A report goes to a person, not a machine, and we do not tell the person you reported them that it was you."
            : "No account needed. If something here is wrong, telling us is the fastest way it gets fixed — and a listing reported as a scam is de-ranked and flagged immediately, before anyone reviews it."}
        </p>

        {(state === "error" || state === "not_found") && (
          <p class="mt-3 border-l-[3px] border-danger bg-noteligible-wash p-3 text-dense text-danger" role="alert">
            {message}
          </p>
        )}

        <form method="post" class="mt-4 max-w-lg space-y-4">
          {isProfile && <input type="hidden" name="profile" value={profileHandle} />}

          <label class={`block ${isProfile ? "hidden" : ""}`}>
            <span class="block text-micro font-semibold text-ink-2">
              {isProfile ? "Profile" : "Listing"}
            </span>
            <input
              name="subject"
              value={isProfile ? profileHandle : (subjectSlug ?? "")}
              required={!isProfile}
              placeholder="the listing's address, e.g. agritech-ai-challenge-2026"
              class="mt-1 h-11 w-full rounded-row border border-line-strong px-3"
            />
          </label>

          <fieldset>
            <legend class="text-micro font-semibold text-ink-2">What's wrong?</legend>
            <div class="mt-2 space-y-2">
              {REASONS.map(([value, label]) => (
                <label class="flex items-center gap-2 text-dense">
                  <input
                    type="radio"
                    name="reason"
                    {value}
                    required
                    checked={chosenReason === value}
                    class="h-4 w-4"
                  />
                  {label}
                </label>
              ))}
            </div>
          </fieldset>

          <label class="block">
            <span class="block text-micro font-semibold text-ink-2">
              Anything else? <span class="font-normal">(optional)</span>
            </span>
            <textarea
              name="detail"
              rows="4"
              maxlength="1000"
              class="mt-1 w-full rounded-row border border-line-strong p-3"
            ></textarea>
          </label>

          <button type="submit" class="h-11 rounded-row bg-brand px-4 font-semibold text-surface">
            Send report
          </button>

          <p class="text-meta text-ink-2">
            We don't store your IP address. Reports are limited to five a day per device.
          </p>
        </form>
      </>
    )
  }
</Base>
