---
// Opportunity discovery. UX_FLOWS.md §3.
//
// Filters are URL state and nothing else, so the view is shareable, the back
// button is correct, and the server can render it (PRODUCT_SPEC.md §13.1).
//
// No infinite scroll. UX_FLOWS.md §3 is explicit and marks it `[PR]`: an explicit
// "Show more" button, because infinite scroll on metered data spends the user's
// money without asking.

import Base from "../../layouts/Base.astro";
import OpportunityRow from "../../components/OpportunityRow.astro";
import { getOpportunitiesByIds, searchOpportunities } from "../../lib/db";
import {
  activeChips,
  compiledToParams,
  hasAnyFilter,
  parseFilters,
  toSearchParams,
} from "../../lib/filters";
import { getSessionUser } from "../../lib/auth";
import { search } from "../../lib/search";

export const prerender = false;

const env = (Astro.locals as { runtime?: { env?: Record<string, string> } }).runtime?.env ?? {};
const filters = parseFilters(Astro.url);

// The viewer, for the eligibility boost in ranking (§6.1). Their profile never leaves the
// database: the verdict is computed there and only the word comes back.
const viewer = filters.q ? await getSessionUser(Astro.cookies, env) : null;

// Hybrid retrieval when there is something to search for; the plain filtered list
// otherwise. Two paths rather than one because §13.4 makes urgency the default ORDER for
// browsing, and running a ranking formula over an unqueried list would reorder it by
// relevance to nothing.
const hybrid = filters.q
  ? await search(
      {
        q: filters.q,
        country: filters.country,
        category: filters.category,
        mode: filters.mode,
        cost: filters.cost,
        team: filters.team,
        hasPrize: filters.hasPrize,
        limit: filters.limit,
        userId: viewer?.id ?? null,
      },
      env,
    )
  : null;

const listed = hybrid
  ? await getOpportunitiesByIds(
      hybrid.rows.map((row) => row.id),
      env,
    )
  : null;

const fallback =
  hybrid && hybrid.ok
    ? null
    : await searchOpportunities(
        {
          q: filters.q,
          country: filters.country,
          category: filters.category,
          mode: filters.mode,
          team: filters.team,
          cost: filters.cost,
          hasPrize: filters.hasPrize,
          organisation: filters.organisation,
          verification: filters.verification,
          sort: filters.sort,
          limit: filters.limit,
        },
        env,
      );

// SEO.md §1: filtered and paginated views are `noindex, follow` — they are user
// tools, not content, and indexing them creates thin-content duplication at scale.
const isFiltered = hasAnyFilter(filters);

const rows = listed ?? (fallback?.ok ? fallback.data.rows : []);
const total = fallback?.ok ? fallback.data.total : null;
const chips = activeChips(filters);
const degraded = hybrid ? !hybrid.ok && !fallback?.ok : !fallback?.ok;

/**
 * AI_SYSTEM.md §7 `[PR]`: the compiler outputs "filter chips only", and "the user always
 * sees and can edit the chips". Only chips the URL does not already carry are shown —
 * once a filter is URL state it is rendered by activeChips above, and showing it twice
 * would make removing it look like it had not worked.
 */
const compiledChips = (hybrid?.compiled?.chips ?? []).filter((chip) => {
  switch (chip.kind) {
    case "country":
      return !filters.country;
    case "category":
      return !filters.category;
    case "mode":
      return !filters.mode;
    case "cost":
      return !filters.cost;
    case "team":
      return !filters.team;
    default:
      return true;
  }
});

const compiledHref = (without?: { kind: string; value: string }) =>
  `/opportunities?${compiledToParams(hybrid?.compiled ?? { chips: [], keywords: "" }, without)}`;

const moreHref = (() => {
  const params = toSearchParams({ ...filters, limit: filters.limit + 20 });
  return `/opportunities?${params}`;
})();

const hasMore = rows.length >= filters.limit;

Astro.response.headers.set(
  "cache-control",
  degraded ? "public, s-maxage=30" : "public, s-maxage=300, stale-while-revalidate=600",
);

const SORT_LABELS: [string, string][] = [
  ["urgency", "Closing soonest"],
  ["newest", "Newest"],
  ["prize", "Largest prize"],
];
---

<Base
  title="Open opportunities"
  description="Hackathons, grants, fellowships and scholarships open to builders across Africa, with an eligibility verdict for your country."
  noindex={isFiltered}
>
  <h1 class="text-title font-semibold">Open opportunities</h1>

  <form method="get" action="/opportunities" class="mt-4">
    <label class="block">
      <span class="sr-only">Search opportunities</span>
      <input
        type="search"
        name="q"
        value={filters.q ?? ""}
        placeholder="remote AI hackathons open to Zimbabwe"
        class="h-11 w-full rounded-row border border-line bg-surface px-3"
      />
    </label>

    <!-- Filters that survive without JavaScript. UX_FLOWS.md §1: no page needs
         JS to display its content, and these are plain form controls. -->
    <div class="mt-2 flex flex-wrap gap-2">
      <label class="text-meta">
        <span class="sr-only">Country</span>
        <input
          name="country"
          value={filters.country ?? ""}
          maxlength="2"
          placeholder="Country"
          class="h-11 w-24 rounded-row border border-line px-2 uppercase"
        />
      </label>
      <label class="text-meta">
        <span class="sr-only">Format</span>
        <select name="mode" class="h-11 rounded-row border border-line bg-surface px-2">
          <option value="">Any format</option>
          <option value="online" selected={filters.mode === "online"}>Remote</option>
          <option value="in_person" selected={filters.mode === "in_person"}>In person</option>
          <option value="hybrid" selected={filters.mode === "hybrid"}>Hybrid</option>
        </select>
      </label>
      <label class="text-meta">
        <span class="sr-only">Cost</span>
        <select name="cost" class="h-11 rounded-row border border-line bg-surface px-2">
          <option value="">Any cost</option>
          <option value="free" selected={filters.cost === "free"}>Free to enter</option>
        </select>
      </label>
      <label class="text-meta">
        <span class="sr-only">Sort by</span>
        <select name="sort" class="h-11 rounded-row border border-line bg-surface px-2">
          {
            SORT_LABELS.map(([value, label]) => (
              <option {value} selected={filters.sort === value}>
                {label}
              </option>
            ))
          }
        </select>
      </label>
      <button type="submit" class="h-11 rounded-row bg-brand px-4 font-semibold text-surface">
        Apply
      </button>
    </div>
  </form>

  {
    compiledChips.length > 0 && (
      <div class="mt-3">
        <p class="text-meta text-ink-2">
          We read that as — remove anything we got wrong:
        </p>
        <div class="mt-1 flex flex-wrap items-center gap-2">
          {compiledChips.map((chip) => (
            <a
              href={compiledHref(chip)}
              class="inline-flex min-h-11 items-center gap-1 rounded-row border border-brand bg-brand-wash px-3 text-meta text-brand no-underline"
              title={`From "${chip.from}"`}
            >
              {chip.label}
              <span aria-hidden="true">×</span>
              <span class="sr-only">Remove this filter</span>
            </a>
          ))}
          <a href={compiledHref()} class="text-meta text-brand">Keep these as filters</a>
        </div>
      </div>
    )
  }

  {
    chips.length > 0 && (
      <div class="mt-3 flex flex-wrap items-center gap-2">
        {chips.map((chip) => (
          <a
            href={chip.removeHref}
            class="inline-flex items-center gap-1 rounded-row bg-brand-wash px-2 py-1 text-meta text-brand no-underline"
          >
            {chip.label}
            <span aria-hidden="true">×</span>
            <span class="sr-only">Remove this filter</span>
          </a>
        ))}
        <a href="/opportunities" class="text-meta text-brand">Clear all</a>
      </div>
    )
  }

  <p class="mt-4 text-meta text-ink-2" aria-live="polite">
    {
      degraded
        ? "Showing what we can right now."
        : total !== null
          ? `${total} open ${total === 1 ? "opportunity" : "opportunities"}`
          : `${rows.length} shown`
    }
    {
      /* UX_FLOWS.md §3: degradation is a quiet note, never an error page. */
      degraded && <span> Search is limited at the moment.</span>
    }
  </p>

  {
    rows.length > 0 ? (
      <>
        <div class="mt-3 border-t border-line">
          {rows.map((o) => (
            <OpportunityRow opportunity={o} />
          ))}
        </div>

        {hasMore && (
          <p class="mt-4">
            <a
              href={moreHref}
              rel="nofollow"
              class="inline-flex min-h-11 items-center rounded-row border border-line-strong bg-surface px-4 font-semibold no-underline"
              >Show 20 more</a
            >
          </p>
        )}
      </>
    ) : (
      /* Empty states: one sentence naming the situation, one action
         (DESIGN_SYSTEM.md §6.4). Never an illustration, never "Nothing here yet!". */
      <div class="mt-6 border border-line bg-surface p-4">
        {degraded ? (
          <>
            <p class="font-semibold">We can't search right now.</p>
            <p class="mt-1 text-dense text-ink-2">
              Nothing is wrong with what you typed. Try again shortly.
            </p>
          </>
        ) : isFiltered ? (
          <>
            <p class="font-semibold">No open opportunities match these filters.</p>
            <p class="mt-2 flex flex-wrap gap-3 text-dense">
              <a href="/opportunities" class="text-brand">Clear filters</a>
              <a href="/opportunities?region=africa_wide" class="text-brand"
                >Search all of Africa</a
              >
            </p>
          </>
        ) : (
          <>
            <p class="font-semibold">Nothing is published yet.</p>
            <p class="mt-1 text-dense text-ink-2">
              The catalogue is still being built. We would rather show you an empty page than
              pad it with listings we cannot stand behind.
            </p>
          </>
        )}
      </div>
    )
  }
</Base>
