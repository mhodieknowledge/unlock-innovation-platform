---
// Opportunity detail. UX_FLOWS.md §4, IMPLEMENTATION_PLAN.md §15 step 3.
// "The most important page in the product, and the main SEO landing page."
//
// Rendered on demand and edge-cached rather than prerendered: the deadline state
// is a function of now(), so a build-time snapshot would go stale and the
// freshness promise is the product's central claim. Cache-Control matches
// SYSTEM_ARCHITECTURE.md §3.2 (15 min) and API_SPEC.md §1.4.

import Base from "../../layouts/Base.astro";
import { verificationLabel } from "../../lib/verification";
import { cachePolicyFor, getSessionUser } from "../../lib/auth";
import EligibilityCheck from "../../components/EligibilityCheck.svelte";
import { getClient, getCountryNames, getOpportunity } from "../../lib/db";
import { getIntentCount, getRoomState } from "../../lib/rooms";
import { getRelatedProjects, stateLabel, type RelatedProject } from "../../lib/projects";
import { countdownLabel, countdownWeight, deadlineFacts, freshnessLabel } from "../../lib/deadline";
import { RULE_OUTCOME_GLYPH } from "../../lib/verdict";
import { resolveLowData } from "../../lib/lowdata";
import {
  breadcrumb,
  opportunityDescription,
  opportunityJsonLd,
  opportunityTitle,
} from "../../lib/seo";
import { BRAND, NO_FEE_STATEMENT } from "@mbele/config";
import { runtimeEnv } from "~/lib/runtime";

export const prerender = false;

const { slug } = Astro.params;
const env = runtimeEnv();

/**
 * The header has to know who is reading. `cachePolicyFor` below makes sure that
 * never reaches a shared cache — one without the other is the bug this fixes.
 */
const user = await getSessionUser(Astro.cookies, env);

const found = await getOpportunity(slug!, env);

// 410 GONE for a merged record, never a silent redirect — a merged record is not
// the same content, and a shared link should stay honest (SEO.md §5).
if (!found.ok && found.reason === "gone") {
  const target = "mergedInto" in found ? found.mergedInto : null;
  Astro.response.status = 410;
  cachePolicyFor(Astro.response, user, "public, s-maxage=3600");
  return Astro.rewrite(target ? `/opportunities/${target}?merged=1` : "/opportunities");
}

if (!found.ok && found.reason === "not_found") {
  Astro.response.status = 404;
}

cachePolicyFor(
  Astro.response,
  user,
  found.ok ? "public, s-maxage=900, stale-while-revalidate=3600" : "public, s-maxage=60",
);

/**
 * DESIGN_SYSTEM.md §10, resolved from the cookie and the `Save-Data` header only — this page
 * deliberately does not read the session (it is the same for every reader, which is what
 * makes it edge-cacheable), so the account preference cannot reach it and does not need to.
 *
 * `Vary` declares the two headers the response depends on. Cloudflare's cache honours `Vary`
 * for very little, so a shared cache may hand a reader the other variant — which is why
 * low-data mode is only ever allowed to change the WEIGHT of a page and never its content.
 * A mis-served variant is then a page with two fact cells instead of four, not a page
 * carrying something that was not meant for the person reading it.
 */
const lowData = resolveLowData({ cookies: Astro.cookies, request: Astro.request }).on;
Astro.response.headers.append("vary", "Save-Data, Cookie");

const detail = found.ok ? found.data : null;
const opp = detail?.opportunity ?? null;
const rules = detail?.rules ?? [];

/**
 * SEO.md §3's structured data, and §4's title and description.
 *
 * This is the page the whole SEO strategy rests on — §1 calls it "Yes — primary" — and the two
 * things that make it rank are the ones the incumbents cannot copy: a title that names the
 * organisation and the closing date, and markup typed by what the thing actually IS.
 *
 * The country names are fetched because `eligibleRegion` needs names rather than ISO codes. A
 * record with no explicit country list (africa_wide, global) fetches nothing — PRODUCT_SPEC.md
 * §28 forbids naming "Africa" as a single origin, so there is nothing to name.
 */
const countryNames = detail
  ? await getCountryNames(detail.opportunity.eligible_countries.slice(0, 12), env)
  : [];

const structured = detail ? opportunityJsonLd(detail.opportunity, Astro.url, countryNames) : null;
const graphs = detail
  ? [
      breadcrumb(
        [
          { name: BRAND.name, path: "/" },
          { name: "Opportunities", path: "/opportunities" },
          ...(detail.opportunity.categories
            ? [
                {
                  name: detail.opportunity.categories.name,
                  path: `/categories/${detail.opportunity.categories.slug}`,
                },
              ]
            : []),
          { name: detail.opportunity.title, path: `/opportunities/${detail.opportunity.slug}` },
        ],
        Astro.url,
      ),
      ...(structured ? [structured] : []),
    ]
  : [];


/**
 * The room entry point, and the CTA that stands in for it below the floor.
 *
 * Both halves of PRODUCT_SPEC.md §24 are decided in the database: room_state() returns
 * `disabled` when the feature flag is off and `below_floor` until there are 3 intents or 1
 * team, so this page renders an entry point, a single CTA, or nothing at all — never an
 * empty room and never a count that flatters the product (§2.3 `[PR]`: no number below 5).
 *
 * Read with the anon client, because none of it depends on who is reading: the state and
 * the count are the same for everybody, so this page stays edge-cacheable.
 */
const anon = getClient(env);
const room =
  opp && anon
    ? await getRoomState(anon, opp.id)
    : { state: "disabled" as const, intent_count: 0, team_count: 0, reason: "unavailable" };
const intentCount = opp && anon && room.state !== "disabled" ? await getIntentCount(anon, opp.id) : null;

/**
 * §1.6: matching PUBLIC projects, "only at a density floor of 3 matching public projects.
 * Below that, the section does not exist."
 *
 * The floor is enforced in projects_for_opportunity, which returns NOTHING below it rather
 * than a short list — so this page cannot render two projects and call it a section.
 */
const relatedProjects: RelatedProject[] =
  opp && anon ? await getRelatedProjects(anon, opp.id) : [];

const facts = opp
  ? deadlineFacts({
      deadline_at: opp.deadline_at,
      deadline_precision: opp.deadline_precision as never,
      opens_at: opp.opens_at,
      is_rolling: opp.is_rolling,
    })
  : null;

const isExpired = opp?.status === "expired" || facts?.state === "closed";
const isDisputed = opp?.verification === "disputed";
const isStale = opp?.verification === "stale";

const prize =
  opp?.prize_amount && opp.prize_currency
    ? `${opp.prize_currency} ${Number(opp.prize_amount).toLocaleString("en")}`
    : null;

const teamLabel =
  opp?.team_size_min && opp?.team_size_max
    ? `${opp.team_size_min}–${opp.team_size_max}`
    : opp?.team_required === false
      ? "Individual"
      : null;

/**
 * The facts worth a cell, and `Closes` is deliberately not among them.
 *
 * The countdown is rendered beside this grid at `countdown-lg` in black — §1.2 makes it "the
 * single most typographically prominent thing" on the page — so a `Closes` cell printed the
 * same deadline twice, a centimetre apart. Worse, `capitalize` on the cell turned
 * `countdownLabel`'s "14 days left" into "14 Days Left", which is a value the product does not
 * say anywhere else. The row component reached the same conclusion for the same reason.
 */
const factGrid: [string, string][] = opp
  ? ([
      [
        "Format",
        opp.participation_mode === "unknown"
          ? "Not stated"
          : opp.participation_mode.replace(/_/g, " ").replace(/^./, (c) => c.toUpperCase()),
      ],
      teamLabel ? ["Team", teamLabel] : null,
      prize ? ["Prize", prize] : null,
      ["Cost", opp.cost === "free" ? "Free to enter" : opp.cost === "paid" ? "Has a cost" : "Not stated"],
      ["Category", opp.categories?.name ?? "—"],
    ].filter(Boolean) as [string, string][])
  : [];
---

{
  !opp ? (
    <Base user={user} title="Not found" noindex>
      <h1 class="text-display font-bold">
        {found.ok === false && found.reason === "unavailable"
          ? "We can't load this right now"
          : "That opportunity isn't here"}
      </h1>
      <p class="prose-measure mt-3 text-body text-ink-2">
        {found.ok === false && found.reason === "unavailable"
          ? "Something on our side is unavailable. Nothing is wrong with the link — try again shortly."
          : "It may have been merged into another listing, or removed."}
      </p>
      <p class="mt-4"><a href="/opportunities" class="text-brand">Browse what's open</a></p>
    </Base>
  ) : (
    <Base
      user={user}
      title={opportunityTitle(opp)}
      description={opportunityDescription(opp, countryNames)}
      noindex={isExpired}
      canonical={`/opportunities/${opp.slug}`}
      lowData={lowData}
      offlineCapable
      ogType="article"
      jsonLd={graphs}
    >
      {
        isDisputed && (
          <div class="mb-4 border-l-[3px] border-noteligible bg-noteligible-wash p-4">
            <p class="font-semibold text-noteligible">
              Someone reported a problem with this. We're checking.
            </p>
            <p class="mt-1 text-dense text-ink-2">
              Until we've confirmed it, treat the details below with caution and verify on the
              official page.
            </p>
          </div>
        )
      }

      {
        isExpired && (
          <div class="mb-4 border-l-[3px] border-line-strong bg-sunken p-4">
            <p class="font-semibold">This has closed.</p>
            <p class="mt-1 text-dense text-ink-2">
              It's kept here for reference, and stays on the organisation's page as history.
            </p>
          </div>
        )
      }

      {/*
        EDITORIAL HIERARCHY, not one enormous line. The title was `text-display` at every
        width, which on a phone spent three lines and the whole first screen on the one thing
        the reader already knew — they clicked it. The category above and the organisation
        below do the work a 34px line was being asked to do alone, and the title steps up to
        display only where there is room for it.
      */}
      <p class="text-micro font-semibold uppercase tracking-[0.08em] text-ink-3">
        {opp.categories?.name ?? "Opportunity"}
      </p>

      <h1 class="mt-1 text-title font-bold text-balance md:text-display">{opp.title}</h1>

      <p class="mt-1 text-meta text-ink-2">
        {
          opp.organisations ? (
            <a href={`/organisations/${opp.organisations.slug}`} class="text-brand"
              >{opp.organisations.name}</a
            >
          ) : (
            <span>Organisation not identified</span>
          )
        }
        <span aria-hidden="true"> · </span>
        <span class="rounded-[2px] bg-sunken px-[6px] py-[2px] text-micro font-semibold">
          {verificationLabel(opp.verification) ?? opp.verification}
        </span>
      </p>

      {
        opp.summary && (
          <>
                        <p class="prose-measure mt-4 text-body text-ink-2">{opp.summary}</p>
          </>
        )
      }

      {/*
        THE DECISION BLOCK. Countdown, the facts it turns on, then the two things a reader
        can do — all before the eligibility island. The island used to come first, so the
        page asked for a country, a student status and a birth year before it had said what
        the opportunity was or when it closed.
      */}
      <!-- Countdown: black, tabular, weight by urgency. The one piece of
           expressive typography in the system (DESIGN_SYSTEM.md §2.2). -->
      <p
        class="mt-4 text-countdown-lg text-absolute"
        style={`font-weight:${countdownWeight(facts?.daysRemaining ?? null)}`}
      >
        {facts ? countdownLabel(facts) : "Deadline not stated"}
      </p>

      {
        opp.deadline_at && (
          <p class="text-meta text-ink-2">
            <time datetime={opp.deadline_at}>
              {new Date(opp.deadline_at).toLocaleDateString("en-GB", {
                day: "numeric",
                month: "long",
                year: "numeric",
              })}
            </time>
            {
              /* PRODUCT_SPEC.md §11.3: when precision is coarser than exact_time,
                 always show the raw source string so the reader can see exactly
                 what the source said rather than only our narrowed reading. */
              opp.deadline_raw && facts?.narrowed && (
                <span> · &ldquo;{opp.deadline_raw}&rdquo;</span>
              )
            }
          </p>
        )
      }

      <!-- Fact grid: labelled cells separated by hairlines, not a middle-dot
           string (DESIGN_SYSTEM.md §5.6). -->
      <dl class="mt-6 grid grid-cols-2 border-t border-line md:grid-cols-4">
        {
          factGrid.map(([label, value]) => (
            <div class="border-b border-r border-line px-3 py-2">
              <dt class="text-micro font-semibold text-ink-2">{label}</dt>
              <dd class="text-dense">{value}</dd>
            </div>
          ))
        }
      </dl>

      <p class="mt-6 flex flex-wrap gap-3">
        {
          opp.apply_url && !isExpired && (
            <a
              href={opp.apply_url}
              rel="noopener noreferrer nofollow ugc"
              target="_blank"
              class={`inline-flex min-h-11 items-center rounded-row px-4 font-semibold ${
                isDisputed
                  ? "border border-line-strong bg-surface text-ink"
                  : "bg-brand text-surface"
              }`}
            >
              Apply on official site
            </a>
          )
        }
        <!-- ?add=<slug> carries the intent through sign-in, so the save completes
             on arrival rather than being lost (UX_FLOWS.md §17, and Phase 2's
             "sign-in completes in under 3 taps FROM A SAVE ACTION"). -->
        <a
          href={`/tracker?add=${opp.slug}`}
          class="inline-flex min-h-11 items-center rounded-row border border-line-strong bg-surface px-4 font-semibold"
          >Save opportunity</a
        >
      </p>

      <!-- The personal verdict. One island; the page HTML above and below is
           identical for every viewer and stays cacheable. -->
      <EligibilityCheck
        client:idle
        opportunityId={opp.id}
        officialUrl={opp.official_url ?? opp.source_url ?? ""}
      />

      {
        /* §2.3 `[PR]`: the count appears at 5 or more and NOT AT ALL below that.
           intent_count_public() returns NULL rather than a number below the floor, so
           there is no small number here to render by accident. */
        intentCount !== null && (
          <p class="mt-4 text-dense">
            {intentCount} builders have said they're going for this.
          </p>
        )
      }

      {
        !isExpired && room.state === "open" && (
          <p class="mt-4">
            <a href={`/opportunities/${opp.slug}/room`} class="text-brand font-semibold"
              >Team room — see who else is going</a
            >
          </p>
        )
      }

      {
        !isExpired && room.state === "below_floor" && (
          /* The room route rewrites HERE when it is below its floor, so this is the
             "single CTA" the acceptance criterion asks for. One line, one action, no
             empty list, and no count of how few people are here. */
          <p class="mt-4">
            <a href={`/opportunities/${opp.slug}/intent`} class="text-brand font-semibold"
              >No one has said they're going for this yet. Say you're going</a
            >
          </p>
        )
      }

      {
        rules.length > 0 && (
          <>
            <h2 class="mt-8 text-subtitle font-semibold">Eligibility rules in full</h2>
            <ul class="mt-3 space-y-4">
              {rules.map((rule) => (
                <li>
                  <p class="text-dense font-semibold">
                    {rule.rule_type.replace(/_/g, " ")}
                  </p>
                  <p class="mt-1 border-l border-line-strong pl-3 text-meta text-ink-2">
                    &ldquo;{rule.source_quote}&rdquo;
                  </p>
                </li>
              ))}
            </ul>
          </>
        )
      }

      {
        rules.length === 0 && (
          <p class="mt-8 text-dense text-ink-2">
            <span aria-hidden="true">{RULE_OUTCOME_GLYPH.unparsed}</span>
            We haven't confirmed the eligibility rules for this one. Check the official page.
          </p>
        )
      }

      <!-- Freshness and provenance. Always visible, deliberately quiet
           (DESIGN_SYSTEM.md §1.2, MODERATION_AND_TRUST.md §1). -->
      <h2 class="mt-8 text-subtitle font-semibold">Freshness and source</h2>
      <p class="mt-2 text-meta text-ink-2">
        {freshnessLabel(opp.last_verified_at)}
        {
          isStale && (
            <span> · We haven't been able to re-check this recently.</span>
          )
        }
        {
          (opp.source_url || opp.official_url) && (
            <>
              <span aria-hidden="true"> · </span>
              <a
                href={opp.official_url ?? opp.source_url ?? "#"}
                rel="noopener noreferrer nofollow ugc"
                target="_blank"
                class="text-brand">Official source</a
              >
            </>
          )
        }
      </p>

      {
        /* §1.6. Absent below three matching public projects, and absent entirely while its
           flag is off — both halves, never either (§24). */
        relatedProjects.length > 0 && (
          <>
            <h2 class="mt-8 text-subtitle font-semibold">Projects aiming at this</h2>
            <p class="mt-1 text-meta text-ink-2">
              Public projects whose subject overlaps this call. Their owners chose to show them.
            </p>
            <ul class="mt-3 divide-y divide-line border-t border-line">
              {relatedProjects.map((project) => (
                <li class="py-3">
                  <a href={`/projects/${project.slug}`} class="text-dense font-semibold text-brand"
                    >{project.title}</a
                  >
                  <p class="text-micro text-ink-2">
                    {stateLabel(project.state)}
                    {project.country_iso2 ? ` · ${project.country_iso2}` : ""}
                    {project.roles_needed.length > 0
                      ? ` · looking for ${project.roles_needed.slice(0, 3).join(", ")}`
                      : ""}
                  </p>
                  {project.pitch && <p class="mt-1 text-dense">{project.pitch}</p>}
                </li>
              ))}
            </ul>
          </>
        )
      }

      <p class="mt-6 text-meta text-ink-2">{NO_FEE_STATEMENT}</p>

      <p class="mt-2 text-meta">
        <a href={`/report?subject=${opp.slug}`} class="text-brand"
          >Report a problem with this listing</a
        >
      </p>
    </Base>
  )
}
