---
// The board. UX_FLOWS.md §2.
//
// "The most characteristic thing in this product's world is a live list of things about to
// close. Showing it IS the hero." So there is no hero: one line of what this is, a search
// field, and then eight rows, soonest deadline first, server-rendered above the fold.
//
// Deliberately absent, per §2: hero image, illustration, gradient, animated statistic,
// testimonials, fabricated community numbers, and any count this product cannot verify.
// CONTENT_AND_LAUNCH.md §1: every number shown is true and computed live — which is why the
// counts at the foot of this page come from two queries and disappear when they come back
// empty, rather than being padded to look like a launch.

import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import OpportunityRow from "../components/OpportunityRow.astro";
import {
  getCategoryCounts,
  getCountry,
  getEntryPoints,
  getLastVerifiedAt,
  getPublishedCount,
  listOpportunities,
} from "../lib/db";
import { getResidenceCountry, getSessionUser } from "../lib/auth";
import { freshnessLabel } from "../lib/deadline";
import { resolveLowData } from "../lib/lowdata";
import { itemList, website } from "../lib/seo";
import { BRAND, NO_FEE_STATEMENT } from "@mbele/config";
import { runtimeEnv } from "~/lib/runtime";

export const prerender = false;

const env = runtimeEnv();

/** §2 item 3: 8 rows. Not 10, not 20 — enough to prove the board is alive, above the fold. */
const BOARD_SIZE = 8;

const user = await getSessionUser(Astro.cookies, env);

const lowData = resolveLowData({
  cookies: Astro.cookies,
  request: Astro.request,
  accountPreference: user?.low_data_mode ?? null,
}).on;

/**
 * Which country the board is for, in priority order: the URL, then the signed-in profile,
 * then the edge's coarse country hint.
 *
 * `?country=all` is the "not your country?" escape hatch and means *show everything* — a
 * distinct value is needed because an empty parameter would simply fall through to the
 * profile and the hint again, and the control would look broken.
 *
 * ANALYTICS.md §3 allows a country "from profile or coarse edge geolocation"; the hint is
 * read from the request header, used for this render, and stored nowhere. The same section
 * forbids capturing IP addresses at all, and this code never sees one.
 */
const requested = (Astro.url.searchParams.get("country") ?? "").trim().toUpperCase();
const showAll = requested === "ALL";
const hint = (Astro.request.headers.get("cf-ipcountry") ?? "").trim().toUpperCase();

const resolved = showAll
  ? { iso2: null as string | null, source: "explicit" as const }
  : /^[A-Z]{2}$/.test(requested)
    ? { iso2: requested, source: "url" as const }
    : await (async () => {
        const profile = user ? await getResidenceCountry(Astro.cookies, env) : null;
        if (profile) return { iso2: profile, source: "profile" as const };
        // XX and T1 are Cloudflare's "unknown" and "Tor" answers, not countries.
        if (/^[A-Z]{2}$/.test(hint) && hint !== "XX" && hint !== "T1") {
          return { iso2: hint, source: "hint" as const };
        }
        return { iso2: null as string | null, source: "none" as const };
      })();

const country = resolved.iso2 ? await getCountry(resolved.iso2, env) : null;

// An unknown code is not a country. Falling back to the whole board is better than an
// "Open to ZZ" strip, and better than an error for something the reader did not do wrong.
const countryIso2 = country?.iso2 ?? undefined;

const [board, entryPoints, published, lastVerifiedAt, categoryCounts] = await Promise.all([
  listOpportunities({ limit: BOARD_SIZE, countryIso2 }, env),
  getEntryPoints(env),
  getPublishedCount(env),
  getLastVerifiedAt(env),
  // design/Main.body.html's Explore list shows "41 open" beside each kind. A category
  // index without counts asks the reader to open four pages to find the one with
  // anything in it.
  getCategoryCounts(env),
]);

const rows = board.ok ? board.data : [];
const degraded = !board.ok;

/**
 * Who may cache this, and for how long.
 *
 * The board is identical for everyone EXCEPT when it was shaped by something only this
 * request carries — a session or the edge country hint. Both produce a page at the URL `/`
 * that is not `/` for the next reader, so those responses are private. A country in the URL
 * is part of the cache key and shares safely, which is also why the "not your country?"
 * control navigates rather than setting a preference.
 */
const shareable = user === null && resolved.source !== "profile" && resolved.source !== "hint";
Astro.response.headers.set(
  "cache-control",
  degraded
    ? "public, s-maxage=30"
    : shareable
      ? "public, s-maxage=300, stale-while-revalidate=600"
      : "private, max-age=0, must-revalidate",
);
// Declared on every response, not only the private ones: even a shareable board depends on
// these two headers for its WEIGHT (low-data mode), and the honest declaration is the same
// either way. See the note on the detail page about what Cloudflare does with `Vary`.
Astro.response.headers.append("vary", "Save-Data, Cookie");

/**
 * §2's offline state: "cached board with 'Last updated' line". The line is rendered on every
 * response, because the service worker serves this HTML back unchanged — a timestamp written
 * at render time is the only one that is still true when the page comes out of a cache.
 */
const builtAt = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
}).format(new Date());

/**
 * SEO.md §3: "`WebSite` with `SearchAction` on the homepage." That is the markup that lets a
 * search engine offer a search box for this site directly in its results, and it is the only
 * structured data on this page that is about the site rather than about a list.
 *
 * The board itself is an ItemList — but only when there is a board. Marking up an empty list
 * would be a claim that there is nothing here, made in a machine-readable way.
 */
const jsonLd = [
  website(Astro.url),
  ...(rows.length > 0
    ? [
        itemList(
          "Closing soonest",
          rows.map((row) => ({ name: row.title, path: `/opportunities/${row.slug}` })),
          Astro.url,
        ),
      ]
    : []),
];

const scopeLine = country
  ? `Open to ${country.name}, and open to everyone.`
  : "Open to builders in all 54 African countries.";
---

<Base
  title={BRAND.name}
  description="Find opportunities open to your country, and know whether you can apply before you spend the data finding out."
  user={user}
  lowData={lowData}
  offlineCapable
  flush
  canonical="/"
  jsonLd={jsonLd}
  feed={{ path: "/feeds/closing-soon.xml", title: "Closing this week" }}
>
  {/* ── MASTHEAD ──────────────────────────────────────────────────────────────
      design/Main.body.html: "one sentence, one search, four paths. Deliberately NOT a
      marketing hero: 270px total, so the first live row is still above the fold."

      UX_FLOWS.md §2 lists a hero image and a marketing hero among the things this page
      deliberately does not have, because the live closing list IS the hero — and
      home-route.test.ts asserts the board renders in the HTML rather than after a
      script. The masthead earns its height by carrying the search and the four ways in,
      not by carrying a picture. */}
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-[1160px] px-4 pt-[22px] pb-5">
      <h1 class="text-display text-balance font-bold tracking-[-0.02em]">
        Opportunities worth your time.
      </h1>
      <p class="prose-measure mt-2 text-meta text-ink-2">
        Scholarships, fellowships, hackathons and grants open to Africa — each one checked
        against its own source, with the deadline up front.
      </p>

      {/* A plain GET form to the list page: no JS, no autocomplete request, nothing
          typed leaves the device until the reader presses the button. */}
      <form method="get" action="/opportunities" class="mt-4 flex gap-2">
        <label class="relative flex-1">
          <span class="sr-only">Search opportunities</span>
          <Icon
            name="search"
            size={20}
            class="pointer-events-none absolute top-1/2 left-[14px] h-[18px] w-[18px] -translate-y-1/2 text-ink-3"
          />
          <input
            type="search"
            name="q"
            placeholder="remote AI hackathons open to Zimbabwe"
            class="h-12 w-full rounded-row border border-line-strong bg-surface pr-3 pl-[42px] text-[15px]"
          />
        </label>
        <button
          type="submit"
          class="h-12 shrink-0 rounded-row bg-brand px-[18px] text-dense font-semibold text-surface"
        >
          Search
        </button>
      </form>

      {/* The four paths. Chips rather than a second list: §5.4's shape, sized to §8's
          44px target, and they disappear entirely when no category has anything in it. */}
      {
        entryPoints.categories.length > 0 && (
          <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
            {entryPoints.categories.slice(0, 4).map((category) => (
              <li>
                <a
                  href={`/categories/${category.slug}`}
                  class="inline-flex min-h-11 items-center rounded-monogram border border-line-strong bg-surface px-3 text-meta font-medium text-ink no-underline hover:bg-sunken"
                >
                  {category.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  {/* ── COUNTRY SCOPE — "quiet, correctable, never a modal." ──────────────── */}
  {
    country && (
      <div class="border-b border-line bg-sunken">
        {/* Stacked until `md`, not `sm`. §4.2 puts sm at 381px — BELOW a 390px phone —
            so an `sm:flex-row` here still ran side by side on the device this is designed
            for, and squeezed the sentence into a four-word column beside a control whose
            words the specification fixes. md is 600px, which is where there is room. */}
        <div class="mx-auto flex max-w-[1160px] flex-col gap-1 px-4 py-[10px] md:flex-row md:items-center md:gap-[10px]">
          <p class="flex-1 text-meta">
            <strong class="font-semibold">Open to {country.name}</strong>
            <span class="text-ink-2"> — plus everything open Africa-wide.</span>
          </p>
          {/* UX_FLOWS.md §2 item 4 quotes this control's words — 'a visible "not your
              country?" control' — so they are kept verbatim even though the canvas
              shortens them to "Change". The strip's shape is the redesign's; the
              wording is the specification's. */}
          <a href="/?country=all" class="text-meta font-semibold whitespace-nowrap">
            Not your country? Show everything
          </a>
        </div>
      </div>
    )
  }

  {
    showAll && (
      <div class="border-b border-line bg-sunken">
        <div class="mx-auto flex max-w-[1160px] items-center gap-[10px] px-4 py-[10px]">
          <p class="flex-1 text-meta text-ink-2">Showing every open opportunity.</p>
          <a href="/" class="text-meta font-semibold whitespace-nowrap">
            Use my country again
          </a>
        </div>
      </div>
    )
  }

  {/* ── THE BOARD ─────────────────────────────────────────────────────────── */}
  <section aria-labelledby="board">
    <div class="mx-auto max-w-[1160px] px-4 pt-[22px] pb-[10px]">
      <p class="eyebrow">Closing soonest</p>
      <h2 id="board" class="mt-1 text-title font-bold tracking-[-0.015em]">
        What needs you this week
      </h2>
      {/* The "Last updated" line of §2's offline state, rendered on every response
          because the service worker serves this HTML back unchanged. */}
      <p class="mt-1 text-meta text-ink-2">
        Board as of {builtAt} UTC{rows.length > 0 ? ` · ${rows.length} open${country ? ` to ${country.name}` : ""}` : ""}
      </p>
    </div>

    {
      rows.length > 0 ? (
        <>
          {/* The band bleeds; the rows inside it sit on the same 1160px measure as the
              masthead. Without the inner container a row's text started at the window
              edge on a desktop while the headline above it started at the gutter. */}
          <div class="border-t border-line bg-surface">
            <div class="mx-auto max-w-[1160px]">
              {rows.map((o) => (
                <OpportunityRow opportunity={o} lowData={lowData} />
              ))}
            </div>
          </div>
          <div class="border-b border-line bg-surface">
            <div class="mx-auto max-w-[1160px] px-4 pt-[14px] pb-[26px]">
              <a href="/opportunities" class="text-dense font-semibold">
                See all open opportunities →
              </a>
            </div>
          </div>
        </>
      ) : (
        /* One sentence naming the situation, one action (DESIGN_SYSTEM.md §6.4).
           Never an illustration, never "Nothing here yet!". */
        <div class="mx-auto max-w-[1160px] px-4">
          <div class="rounded-sheet border border-line bg-surface p-4">
            {degraded ? (
              <>
                <p class="font-semibold">We can't load the board right now.</p>
                <p class="mt-1 text-dense text-ink-2">
                  Nothing is wrong with your connection as far as we can tell. Try again
                  shortly, or search directly.
                </p>
                <p class="mt-2 text-dense">
                  <a href="/opportunities">Search opportunities</a>
                </p>
              </>
            ) : country ? (
              <>
                <p class="font-semibold">Nothing open to {country.name} is closing yet.</p>
                <p class="mt-1 text-dense text-ink-2">
                  That is the catalogue being honest, not a filter being clever.
                </p>
                <p class="mt-2 text-dense">
                  <a href="/?country=all">Show everything</a>
                </p>
              </>
            ) : (
              <>
                <p class="font-semibold">Nothing is published yet.</p>
                <p class="mt-1 text-dense text-ink-2">
                  The catalogue is still being built. We would rather show you an empty board
                  than pad it with listings we cannot stand behind.
                </p>
              </>
            )}
          </div>
        </div>
      )
    }
  </section>

  {/* ── EXPLORE — "density changes deliberately here: a list, not more cards." ──
      §2 item 5 wants country and category entry points as plain links, and §28 makes
      every African country a first-class page rather than a promoted subset. */}
  {
    entryPoints.categories.length > 0 && (
      <section aria-labelledby="by-kind">
        <div class="mx-auto max-w-[1160px] px-4 pt-[26px] pb-2">
          <p class="eyebrow">Explore</p>
          <h2 id="by-kind" class="mt-1 text-title font-bold tracking-[-0.015em]">
            By what it is
          </h2>
        </div>
        <ul class="mx-auto list-none border-y border-line bg-surface p-0 lg:max-w-[1160px]">
          {entryPoints.categories.map((category) => {
            const open = categoryCounts.find((c) => c.code === category.code)?.open_count;
            return (
              <li>
                <a
                  href={`/categories/${category.slug}`}
                  class="flex min-h-11 items-center gap-3 border-b border-line px-4 py-[13px] text-ink no-underline last:border-b-0 hover:bg-sunken"
                >
                  <span class="flex-1 text-dense font-semibold">{category.name}</span>
                  {/* A count only where there is one. "0 open" on a page the reader is
                      being invited to open is worse than saying nothing. */}
                  {open !== undefined && open > 0 && (
                    <span class="text-meta text-ink-3">{open} open</span>
                  )}
                  <Icon name="chevron" size={20} class="h-4 w-4 shrink-0 text-ink-3" />
                </a>
              </li>
            );
          })}
        </ul>
        <div class="mx-auto max-w-[1160px] px-4 pt-3">
          <a href="/categories" class="text-dense font-semibold">
            All categories →
          </a>
        </div>
      </section>
    )
  }

  {/* ── WHAT WE CAN CHECK FOR YOU ─────────────────────────────────────────────
      The eligibility profile is what turns a list of deadlines into an answer about the
      reader, and it had become the hardest thing on the site to find: when the bottom
      bar replaced the old header links, /you/eligibility was left reachable only from
      /you. The menu now carries it first, and this is the other half — naming it on the
      page where the question actually occurs to somebody.

      It sits where fifty-four country links used to. That list ran to about 1,200px of
      a phone screen — more than a viewport of blue text to scroll past — for an entry
      point almost nobody uses twice. */}
  <section class="mx-auto mt-7 max-w-[1160px] px-4" aria-labelledby="can-i-apply">
    <div class="rounded-sheet border border-line bg-surface p-4">
      <p class="eyebrow">Can you apply?</p>
      <h2 id="can-i-apply" class="mt-[6px] text-subtitle font-semibold">
        Tell us where you live, and we check every listing against it.
      </h2>
      <p class="mt-2 text-dense text-ink-2">
        Most rules turn on residence and what you are studying. With those saved, each
        opportunity says whether you qualify — and where the wording is unclear, it says
        unclear rather than guessing.
      </p>
      <p class="mt-3">
        <a
          href="/you/eligibility"
          class="inline-flex min-h-11 items-center rounded-row bg-brand px-4 text-dense font-semibold text-surface no-underline"
        >
          {user ? "Your eligibility details" : "Add your details"}
        </a>
      </p>
    </div>
  </section>

  {/* ── BY COUNTRY, folded away ────────────────────────────────────────────────
      §2 item 5 wants country entry points on this page and §28 makes every African
      country a first-class page rather than a promoted subset — so all of them are
      still here, and still plain links in the HTML for a crawler and for a reader with
      no JavaScript. They are just no longer unrolled by default.

      A `<details>` rather than a "show more" button for the same reason the menu is one:
      it needs no script, and the CSP carries no 'unsafe-inline'. */}
  {
    entryPoints.countries.length > 0 && (
      <section class="mx-auto mt-7 max-w-[1160px] px-4" aria-labelledby="by-country">
        <details class="group rounded-sheet border border-line bg-surface">
          <summary class="flex min-h-11 cursor-pointer list-none items-center gap-3 px-4 py-3 [&::-webkit-details-marker]:hidden">
            <span class="flex-1">
              <span class="eyebrow">Explore</span>
              <span id="by-country" class="block text-dense font-semibold">
                By where you live
              </span>
            </span>
            <span class="text-meta text-ink-3">{entryPoints.countries.length} countries</span>
            <Icon
              name="chevron"
              size={20}
              class="h-4 w-4 shrink-0 rotate-90 text-ink-3 group-open:-rotate-90"
            />
          </summary>
          <ul class="grid list-none grid-cols-2 gap-x-4 border-t border-line px-4 pt-2 pb-3 p-0 md:grid-cols-3 lg:grid-cols-4">
            {entryPoints.countries.map((c) => (
              <li>
                <a
                  href={`/countries/${c.slug}`}
                  class="flex min-h-11 items-center border-b border-line text-dense no-underline hover:underline"
                >
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
          <p class="px-4 pb-3">
            <a href="/countries" class="text-dense font-semibold">
              All countries →
            </a>
          </p>
        </details>
      </section>
    )
  }

  {/* ── TRUST — "earns its place by being specific about what is and is not known."
      MODERATION_AND_TRUST.md §2.1 rule 3's no-fee line is the third of these, stated
      here rather than in the footer so it sits with the two promises it belongs with.
      Base passes `trustPanelAbove` to the footer so it is not repeated below. */}
  <section class="mx-auto mt-7 max-w-[1160px] px-4" aria-labelledby="how-kept">
    <div class="rounded-sheet bg-brand-wash p-4">
      <p class="eyebrow text-brand-ink">How this list is kept</p>
      <h2 id="how-kept" class="mt-[6px] text-subtitle font-semibold text-brand-ink">
        Nothing here is copied and forgotten.
      </h2>
      <ul class="mt-[14px] flex list-none flex-col gap-[10px] p-0">
        {
          [
            "Every listing links to the organiser's own page, and we re-check that page on a schedule. Each row says when it was last checked.",
            "Eligibility rules are quoted from the organiser's words. Where the wording is unclear, we say unclear rather than guessing.",
            NO_FEE_STATEMENT,
          ].map((line) => (
            <li class="flex gap-[10px] text-dense text-ink-2">
              <span aria-hidden="true" class="font-bold text-brand">
                —
              </span>
              <span>{line}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* §2 item 6: counts that are true. Both come from live queries, and each disappears
      rather than showing a zero or a guess. */}
  {
    (published !== null || lastVerifiedAt !== null) && (
      <p class="mx-auto max-w-[1160px] px-4 pt-6 text-meta text-ink-3">
        {published !== null && published > 0 && (
          <span>
            {published} {published === 1 ? "opportunity" : "opportunities"} published.{" "}
          </span>
        )}
        {lastVerifiedAt !== null && <span>{freshnessLabel(lastVerifiedAt)} against the source.</span>}
      </p>
    )
  }
</Base>
