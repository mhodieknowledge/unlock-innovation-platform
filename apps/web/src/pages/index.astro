---
// The board. UX_FLOWS.md §2.
//
// "The most characteristic thing in this product's world is a live list of things about to
// close." This page is that list, arranged so it reads as a home screen rather than a feed.
//
// THE SHAPE IS SECTIONS OF ONE LIST, and it took three tries to get here.
//
// First it was a CAROUSEL: a slide deck, one card filling the width, seven off-screen with
// nothing to say they existed, reached through JavaScript and 8×8px dots. On an iPhone 13
// that was one visible listing, 1.67 viewports down the page.
//
// Then it was RAILS AND BANDS: horizontal overflow-scrolling rows of cards, with full-bleed
// photographic category bands between them. That fixed the deck's real defect — every card
// was in the HTML, reachable without script — and it looked composed. But it kept the
// deck's underlying bet, which is that a reader will scroll sideways through a list of
// things they are trying to COMPARE. Two axes of scrolling on one page is a reader deciding
// which direction the page wants, twelve times, while trying to read deadlines.
//
// Now it is one direction. Every section is a vertical grid of cards — one column on a
// phone, two then three as the screen earns them — and the page is read the way a phone is
// already being read. What that costs is the composed look the bands gave it; what it buys
// is that the second listing in a section is visible without a gesture, which the rails
// never managed. Roughly eighteen real opportunities are on the page, all of them scannable
// in one motion.
//
// A BORDERLESS LIST WAS THE FIRST VERSION OF THIS, and it went too far. Stripping the cards
// to hairline-separated rows made the board read as a spreadsheet: four facts per row with
// nothing grouping them, so the eye does the grouping itself, once per row, all the way
// down. The horizontal scrolling was the defect; the card was not. See the note at the top
// of OpportunityRow.
//
// THE BANDS ARE GONE, AND "BROWSE BY KIND" IS WHY. A band was a full-bleed photograph
// carrying a category name and its count — the loudest thing on the page after the hero,
// spent on saying "hackathons exist". The category grid below says that for all twenty-one
// categories, in one screenful, with the same live counts. Two answers to one question, and
// the quiet one was the more complete. So a featured category is now a heading and a count
// over its listings, which is the part of a band that was carrying information.
//
// CONTENT_AND_LAUNCH.md §1: every number here is true and computed live, and disappears when
// it comes back empty rather than being padded to look like a launch.

import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import OpportunityRow from "../components/OpportunityRow.astro";
import heroImage from "../assets/marketing/hero-collab.jpg";
import {
  getCategoryCounts,
  getCountry,
  getEntryPoints,
  getLastVerifiedAt,
  getPublishedCount,
  listOpportunities,
} from "../lib/db";
import { cachePolicyFor, getResidenceCountry, getSessionUser } from "../lib/auth";
import { freshnessLabel } from "../lib/deadline";
import { resolveLowData } from "../lib/lowdata";
import { itemList, website } from "../lib/seo";
import { BRAND, NO_FEE_STATEMENT } from "@mbele/config";
import { runtimeEnv } from "~/lib/runtime";

export const prerender = false;

const env = runtimeEnv();

/**
 * §2 item 3 asked for 8 rows, "enough to prove the board is alive, above the fold", and this
 * number has now been wrong in both directions. Eight was too few for a carousel that showed
 * one of them at a time. Twelve was right for a RAIL, where the eleven cards a reader does
 * not want cost them nothing — they are off-screen sideways, and scrolling past them is a
 * gesture nobody has to make.
 *
 * Vertically every row is ~112px of page that everyone pays for on the way to the category
 * sections and the trust panel below. Eight is §2's number, and with two category sections
 * under it the board still puts eighteen real listings on the page.
 */
const BOARD_SIZE = 8;

const user = await getSessionUser(Astro.cookies, env);

const lowData = resolveLowData({
  cookies: Astro.cookies,
  request: Astro.request,
  accountPreference: user?.low_data_mode ?? null,
}).on;

/**
 * Which country the board is for, in priority order: the URL, then the signed-in profile,
 * then the edge's coarse country hint.
 *
 * `?country=all` is the "not your country?" escape hatch and means *show everything* — a
 * distinct value is needed because an empty parameter would simply fall through to the
 * profile and the hint again, and the control would look broken.
 *
 * ANALYTICS.md §3 allows a country "from profile or coarse edge geolocation"; the hint is
 * read from the request header, used for this render, and stored nowhere. The same section
 * forbids capturing IP addresses at all, and this code never sees one.
 */
const requested = (Astro.url.searchParams.get("country") ?? "").trim().toUpperCase();
const showAll = requested === "ALL";
const hint = (Astro.request.headers.get("cf-ipcountry") ?? "").trim().toUpperCase();

const resolved = showAll
  ? { iso2: null as string | null, source: "explicit" as const }
  : /^[A-Z]{2}$/.test(requested)
    ? { iso2: requested, source: "url" as const }
    : await (async () => {
        const profile = user ? await getResidenceCountry(Astro.cookies, env) : null;
        if (profile) return { iso2: profile, source: "profile" as const };
        // XX and T1 are Cloudflare's "unknown" and "Tor" answers, not countries.
        if (/^[A-Z]{2}$/.test(hint) && hint !== "XX" && hint !== "T1") {
          return { iso2: hint, source: "hint" as const };
        }
        return { iso2: null as string | null, source: "none" as const };
      })();

const country = resolved.iso2 ? await getCountry(resolved.iso2, env) : null;

// An unknown code is not a country. Falling back to the whole board is better than an
// "Open to ZZ" strip, and better than an error for something the reader did not do wrong.
const countryIso2 = country?.iso2 ?? undefined;

const [board, entryPoints, published, lastVerifiedAt, categoryCounts] = await Promise.all([
  listOpportunities({ limit: BOARD_SIZE, countryIso2 }, env),
  getEntryPoints(env),
  getPublishedCount(env),
  getLastVerifiedAt(env),
  getCategoryCounts(env),
]);

const rows = board.ok ? board.data : [];
const degraded = !board.ok;

/**
 * The two featured categories, and the listings under each.
 *
 * Ordered by what is actually open, so the page reflects the catalogue rather than a
 * hard-coded pair of favourites. `other` is excluded: it is where a listing goes when the
 * taxonomy has no word for it, so as a destination it promises nothing.
 *
 * WHAT A FEATURED CATEGORY IS NOW. It was a full-bleed photographic band with the name and
 * count set over it, then a rail of that category's listings. The photograph is gone with
 * the band — a category-level stock image was doing compositional work rather than telling
 * anyone anything, and "Browse by kind" below already answers "what kinds are there?" for
 * all of them with the same live counts. What is left is the part that carried information:
 * a heading, a true count, and the listings themselves.
 *
 * SIX IS STILL THE FLOOR, for a reason that survived the redesign. Scholarships with FOUR
 * open once took a full-width band while AI challenges with forty-eight sat in a small card
 * below, because scholarships had a photograph in assets/marketing and AI challenges did
 * not — the assets folder editing the page. There is no photograph to bias it now, but a
 * section of two under a heading is still a section that should have been a card, so the
 * floor stays. A category below it is not hidden: it is in the grid with its true count.
 */
const SECTION_FLOOR = 6;

/** How many listings a featured category shows before "all N" takes over. */
const SECTION_SIZE = 5;

const FEATURE_SECTIONS = categoryCounts
  .filter((c) => c.open_count >= SECTION_FLOOR && c.code !== "other")
  .sort((a, b) => b.open_count - a.open_count)
  .slice(0, 2);

/**
 * THE SECTIONS ARE NOT COUNTRY-FILTERED, AND THE BOARD IS. That is a deliberate division,
 * and getting it wrong was visible on the live page: a heading reading "79 open now" — the
 * count comes from `category_open_counts`, which is global — sat above a list of TWO,
 * because the list was filtered to the reader's country and the heading was not. A number
 * over a list that contradicts it is worse than no number.
 *
 * So the board at the top is the personal one ("open to Zimbabwe and Africa-wide") and the
 * category sections are the catalogue: their count, their listings and the category page
 * they link to all describe the same set. Anyone who wants the personal view of a category
 * has the filter on that page.
 */
const sectionResults = await Promise.all(
  FEATURE_SECTIONS.map((c) => listOpportunities({ categoryCode: c.code, limit: 16 }, env)),
);

/**
 * A section does not repeat what the board already showed.
 *
 * The board is the soonest eight overall and a section is the soonest of one category, so
 * the most urgent hackathon is in both by definition. Twice on one screenful reads as a
 * catalogue that has run out of things to show. Sixteen are fetched so that after the
 * overlap is removed there are still five.
 */
const shownAlready = new Set(rows.map((r) => r.id));

const sections = FEATURE_SECTIONS.map((category, i) => ({
  category,
  rows: (sectionResults[i]?.ok ? sectionResults[i].data : [])
    .filter((o) => !shownAlready.has(o.id))
    .slice(0, SECTION_SIZE),
})).filter((section) => section.rows.length > 0);

/** Every category given a section, so the card grid below does not repeat it. */
const SECTIONED = new Set(sections.map((b) => b.category.code));

/**
 * WHAT KIND OF THING IT IS, DRAWN RATHER THAN PHOTOGRAPHED.
 *
 * The grid used to be two components wearing one heading: a photograph card for the four
 * categories we hold a picture of, and a tinted box for the other seventeen. Scanning it
 * meant scanning two visual languages at once, and the tinted boxes read as cards whose
 * image had failed to load — which is the one thing a deliberate variant must never do.
 *
 * An icon has no such shortfall, because there is no missing asset to notice. Every card
 * is now one object: white, hairline, one icon, the name, the count. The photographs went
 * with the bands in the pass after this one — once a category was a heading rather than a
 * full-bleed image, there was nowhere on this page a stock photograph was doing work.
 *
 * The map is by code with a fallback, so a category added to the taxonomy tomorrow gets
 * the generic mark rather than nothing at all.
 */
const CATEGORY_ICONS: Record<string, "code" | "award" | "briefcase" | "growth" | "book" | "you" | "categories"> = {
  hackathon: "code",
  coding_competition: "code",
  ai_challenge: "code",
  data_competition: "code",
  innovation_challenge: "code",
  open_source_program: "code",
  grant: "award",
  fellowship: "award",
  scholarship: "award",
  internship: "briefcase",
  developer_program: "briefcase",
  startup_competition: "growth",
  pitch_competition: "growth",
  accelerator: "growth",
  incubator: "growth",
  entrepreneurship_program: "growth",
  research_opportunity: "book",
  conference_cfp: "book",
  bootcamp: "book",
  community_challenge: "you",
};

/** The rest of the directory, as cards — one shape, one icon each. */
const CATEGORY_CARDS = categoryCounts
  .filter((c) => c.open_count > 0 && c.code !== "other" && !SECTIONED.has(c.code))
  .sort((a, b) => b.open_count - a.open_count)
  .slice(0, 6)
  .map((c) => ({ ...c, icon: CATEGORY_ICONS[c.code] ?? ("categories" as const) }));

/**
 * The hero's rotating stat — real counts, not marketing copy. Padded to exactly four slots
 * (repeating if the catalogue has fewer than four categories open) because the CSS keyframe
 * that drives it is a fixed four-step cycle (tokens.css `word-cycle-4`) — a per-request
 * inline <style> to match an arbitrary count is not possible under this CSP (style-src
 * 'self', no unsafe-inline).
 */
const CYCLE_SLOTS = 4;
const withOpenCounts = categoryCounts
  .filter((c) => c.open_count > 0)
  .sort((a, b) => b.open_count - a.open_count);
const cycleCategories =
  withOpenCounts.length > 0
    ? Array.from({ length: CYCLE_SLOTS }, (_, i) => withOpenCounts[i % withOpenCounts.length])
    : [];

/**
 * "48 ai challenge open now" is what the hero said on the live site, and "All 48 ai challenges"
 * is what a band's link said after I fixed the hero — the same mistake, written out a second
 * time twenty lines apart. Both call this now, which is the only reason the second one cannot
 * drift from the first again.
 *
 * Two bugs in one interpolation: the count was never pluralised, and `.toLowerCase()` was
 * applied to a name that can begin with an acronym. Category names are seeded in sentence case
 * ("Hackathon", "AI challenge", "Conference call for papers"), so the rules are: add an `s`
 * unless the name already ends in one, and lower the first letter unless the first two are
 * both capitals — which is what tells an acronym from a capitalised word without a dictionary.
 */
const categoryPhrase = (name: string): string => {
  const plural = name.endsWith("s") ? name : `${name}s`;
  const acronym = /^[A-Z]{2}/.test(plural);
  return acronym ? plural : plural.charAt(0).toLowerCase() + plural.slice(1);
};

/** "20 Sept" — the fact that makes a category worth opening today rather than a name. */
const shortDate = (iso: string | null): string | null => {
  if (!iso) return null;
  const at = new Date(iso);
  if (Number.isNaN(at.getTime())) return null;
  return new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", timeZone: "UTC" }).format(at);
};

/**
 * Who may cache this, and for how long.
 *
 * The board is identical for everyone EXCEPT when it was shaped by something only this
 * request carries — a session or the edge country hint. Both produce a page at the URL `/`
 * that is not `/` for the next reader, so those responses are private. A country in the URL
 * is part of the cache key and shares safely, which is also why the "not your country?"
 * control navigates rather than setting a preference.
 */
cachePolicyFor(
  Astro.response,
  user,
  degraded ? "public, s-maxage=30" : "public, s-maxage=300, stale-while-revalidate=600",
  resolved.source === "profile" || resolved.source === "hint",
);
// Declared on every response, not only the private ones: even a shareable board depends on
// these two headers for its WEIGHT (low-data mode), and the honest declaration is the same
// either way. See the note on the detail page about what Cloudflare does with `Vary`.
Astro.response.headers.append("vary", "Save-Data, Cookie");

/**
 * §2's offline state: "cached board with 'Last updated' line". The line is rendered on every
 * response, because the service worker serves this HTML back unchanged — a timestamp written
 * at render time is the only one that is still true when the page comes out of a cache.
 */
const builtAt = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
}).format(new Date());

/**
 * SEO.md §3: "`WebSite` with `SearchAction` on the homepage." That is the markup that lets a
 * search engine offer a search box for this site directly in its results, and it is the only
 * structured data on this page that is about the site rather than about a list.
 *
 * The board itself is an ItemList — but only when there is a board. Marking up an empty list
 * would be a claim that there is nothing here, made in a machine-readable way.
 */
const jsonLd = [
  website(Astro.url),
  ...(rows.length > 0
    ? [
        itemList(
          "Closing soonest",
          rows.map((row) => ({ name: row.title, path: `/opportunities/${row.slug}` })),
          Astro.url,
        ),
      ]
    : []),
];

/** The stats band. Three numbers, all live, none rounded up with a "+" — CONTENT_AND_LAUNCH.md
 * §1 and apps/web/test/home-route.test.ts both rule out the marketing-rounding pattern. */
const STATS = [
  {
    value: published ?? 0,
    label: (published ?? 0) === 1 ? "opportunity tracked" : "opportunities tracked",
    // The icon names WHICH number this is, so three counts in a row on a phone stop
    // reading as one long sentence of digits. §8's rule still holds — the label beside
    // it carries the meaning and the icon is aria-hidden, so nothing is icon-only.
    icon: "board" as const,
  },
  { value: entryPoints.countries.length, label: "African countries covered", icon: "globe" as const },
  { value: entryPoints.categories.length, label: "categories tracked", icon: "categories" as const },
].filter((s) => s.value > 0);
---

<Base
  title={BRAND.name}
  description="Find opportunities open to your country, and know whether you can apply before you spend the data finding out."
  user={user}
  lowData={lowData}
  offlineCapable
  flush
  canonical="/"
  jsonLd={jsonLd}
  feed={{ path: "/feeds/closing-soon.xml", title: "Closing this week" }}
>
  {/* ── HERO — a band, not a screen. ───────────────────────────────────────────
      The old hero was 621px on a 664px phone: a full-height photograph carrying a
      three-line headline, a five-line paragraph and a search field, with the first
      opportunity another 488px below it. It established the product and then kept
      establishing it.

      This one does the same job in roughly half the height. The photograph stays — it is
      the only place on the page where this reads as somewhere made for someone rather
      than a database — but it is a band behind the words instead of a screen of its own,
      the headline sits at a size a phone can hold in two lines, and the paragraph is one
      sentence rather than five lines of the same sentence. What was cut: the "checked
      against real sources" line, because the trust module below states it properly and a
      promise made twice is not made twice as strongly.

      In low-data mode there is no photograph at all — a plain, fast, text hero, never a
      slow image pretending to be a fast one. */}
  {
    lowData ? (
      <section class="border-b border-line bg-surface">
        <div class="mx-auto max-w-[1160px] px-4 pt-8 pb-7 lg:pt-12 lg:pb-10">
          <h1 class="max-w-[18ch] text-balance text-[1.875rem] leading-[1.12] font-bold tracking-[-0.02em] lg:text-[2.75rem]">
            Opportunities worth your time.
          </h1>
          <p class="prose-measure mt-2 text-[15px] leading-6 text-ink-2">
            Scholarships, fellowships, hackathons and grants open to Africa, each checked
            against its source.
          </p>
          {/* ONE CONTROL, NOT TWO NEXT TO EACH OTHER — see the note on the photographic
              hero below. Same object here, minus the shadow: low-data mode gets the
              plain version of everything, never a different shape. */}
          <form
            method="get"
            action="/opportunities"
            class="mt-5 flex h-12 max-w-xl items-stretch overflow-hidden rounded-sheet border border-line-strong bg-surface focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-brand"
          >
            <label class="flex min-w-0 flex-1 items-center">
              <span class="sr-only">Search opportunities</span>
              <input
                type="search"
                name="q"
                placeholder="Search scholarships, hackathons, grants…"
                class="h-full w-full min-w-0 border-0 bg-transparent px-4 text-[15px] outline-none"
              />
            </label>
            <button
              type="submit"
              class="h-full shrink-0 border-l border-line bg-brand px-6 text-dense font-semibold text-surface hover:bg-brand-ink"
            >
              Search
            </button>
          </form>
        </div>
      </section>
    ) : (
      <section class="relative isolate overflow-hidden border-b border-line">
        <Image
          src={heroImage}
          alt=""
          aria-hidden="true"
          widths={[480, 800, 1200, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-kenburns absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/90 via-black/65 to-black/35" />

        <div class="relative mx-auto max-w-[1160px] px-4 pt-7 pb-7 lg:pt-14 lg:pb-12">
          {
            cycleCategories.length === CYCLE_SLOTS && (
              <p class="inline-flex w-fit items-center gap-2 rounded-monogram border border-white/25 bg-white/10 px-3 py-1 text-micro font-semibold text-white backdrop-blur-sm">
                <span class="relative flex size-2 shrink-0">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-monogram bg-eligible opacity-75" />
                  <span class="relative inline-flex size-2 rounded-monogram bg-eligible" />
                </span>
                <span class="word-cycle">
                  <span class="word-cycle-track">
                    {cycleCategories.map((c) => (
                      <span>
                        {c.open_count} {categoryPhrase(c.name)} open now
                      </span>
                    ))}
                  </span>
                </span>
              </p>
            )
          }

          <h1
            class="mt-3 max-w-[15ch] text-balance text-[2rem] leading-[1.08] font-bold tracking-[-0.025em] text-white lg:text-[3.25rem]"
          >
            Opportunities worth your time.
          </h1>
          <p class="prose-measure mt-2 text-[15px] leading-6 text-white/80 lg:text-[17px]">
            Scholarships, fellowships, hackathons and grants open to Africa, each checked
            against its source.
          </p>

          {/* A plain GET form to the list page: no JS, no autocomplete request, nothing
              typed leaves the device until the reader presses the button.

              ONE CONTROL, NOT TWO NEXT TO EACH OTHER. The field and the button used to be
              separate rounded objects with a 8px gap between them, each casting its own
              shadow over the photograph — two controls where a reader sees one job. They
              are now a single container: one radius, one shadow, one focus ring around
              the whole thing, and a hairline where the button begins. The divider is what
              makes it read as a search BAR rather than as a field that happens to have a
              blue block glued to its right edge.

              The focus ring is on the container (`focus-within`) rather than on the input,
              because the visible boundary a reader must find is now the container's — the
              input inside it has no edge of its own to ring. §8's "never removed" is
              honoured, not bypassed: `outline-none` on the input hands its ring to the
              wrapper, it does not delete it.

              The button's padding is deliberately generous (px-6, and px-7 once there is
              room): "Search" at 14px is a short word, and a short word in a tight box is
              the difference between a button and a label. */}
          <form
            method="get"
            action="/opportunities"
            class="mt-5 flex h-12 max-w-xl items-stretch overflow-hidden rounded-sheet bg-surface shadow-[0_8px_30px_rgba(0,0,0,0.25)] focus-within:outline focus-within:outline-2 focus-within:outline-offset-2 focus-within:outline-brand"
          >
            <label class="flex min-w-0 flex-1 items-center">
              <span class="sr-only">Search opportunities</span>
              <Icon
                name="search"
                size={20}
                class="pointer-events-none ml-4 h-[18px] w-[18px] shrink-0 text-ink-3"
              />
              <input
                type="search"
                name="q"
                placeholder="Search scholarships, hackathons, grants…"
                class="h-full w-full min-w-0 border-0 bg-transparent px-3 text-[15px] outline-none"
              />
            </label>
            <button
              type="submit"
              class="h-full shrink-0 border-l border-line bg-brand px-6 text-dense font-semibold text-surface transition-colors hover:bg-brand-ink md:px-7"
            >
              Search
            </button>
          </form>
        </div>
      </section>
    )
  }

  {/* ── CONTEXT LINE — where the board is pointed, in one line. ────────────────
      This was a 201px block: an icon in a 40px circle, a bold sentence, a second
      explanatory sentence, and a full-width "Change location" button, for a fact that is
      four words long. It is now a line of text with the control inline, because the fact
      is small and the thing underneath it is the product. */}
  {
    country && (
      /* A BRAND TINT, NOT ANOTHER GREY. This strip said "sunken" — the same neutral the
         footer uses — so between the hero and the white board below it read as a seam
         rather than as a statement about what the reader is looking at. A wash of the
         brand blue separates it from the white content underneath without introducing a
         fourth surface colour: it is --brand-wash, the tint the ramp already holds, at
         half strength so it stays a whisper. */
      <div class="border-b border-line bg-brand-wash/50">
        {/*
          ONE ROW, 44px TALL, INCLUDING THE CONTROL.

          The first attempt put `min-h-11` on the link inside a wrapping flex row, which is
          how a one-line fact became an 83px two-line block on a 390px screen: the link
          claimed its 44px and then wrapped below the sentence. The row itself is the 44px
          now — DESIGN_SYSTEM.md §329's rule is about the TARGET, and a link that fills the
          row's height with negative margin is a 44px target inside a 44px strip.
        */}
        <p class="mx-auto flex max-w-[1160px] items-center gap-2 px-4 text-meta text-ink-2">
          <Icon name="globe" size={20} class="h-4 w-4 shrink-0 text-ink-3" />
          <span class="min-w-0 truncate">
            Open to <strong class="font-semibold text-ink">{country.name}</strong> and Africa-wide
          </span>
          <a
            href="/?country=all"
            class="ml-auto inline-flex min-h-11 shrink-0 items-center font-semibold text-brand no-underline hover:underline"
          >
            Show all
          </a>
        </p>
      </div>
    )
  }

  {
    showAll && (
      /* The same strip, saying the other thing. Same tint, because it is the same fact
         in the same place, and a reader who switches between them should see one
         component change its words rather than two components trade places. */
      <div class="border-b border-line bg-brand-wash/50">
        <p class="mx-auto flex max-w-[1160px] items-center gap-2 px-4 text-meta text-ink-2">
          <Icon name="globe" size={20} class="h-4 w-4 shrink-0 text-ink-3" />
          <span class="min-w-0 truncate">Every open opportunity across Africa</span>
          <a
            href="/"
            class="ml-auto inline-flex min-h-11 shrink-0 items-center font-semibold text-brand no-underline hover:underline"
          >
            Use my location
          </a>
        </p>
      </div>
    )
  }

  {/* ── THE BOARD — what is closing, stacked. ────────────────────────────────
      Eight cards, one column on a phone. No `tabindex` and no `aria-label` on
      the list any more: both existed to make a horizontally scrolling region
      reachable by keyboard (axe calls it scrollable-region-focusable), and a
      vertical list of links has never needed either — the cards are in the tab
      order because they contain links. The section's own `aria-labelledby`
      names it. ──────────────────────────────────────────────────────────── */}
  <section class="mx-auto max-w-[1160px] px-4 pt-6" aria-labelledby="board">
    <div class="flex flex-wrap items-center justify-between gap-x-4">
      <h2 id="board" class="text-title font-bold tracking-[-0.015em]">Closing soonest</h2>
      {
        rows.length > 0 && (
          <a
            href="/opportunities"
            class="inline-flex min-h-11 items-center text-meta font-semibold text-brand no-underline hover:underline"
          >
            View all{published !== null && published > 0 ? ` ${published}` : ""} →
          </a>
        )
      }
    </div>
    <p class="text-meta text-ink-2">
      Board as of {builtAt} UTC{country ? ` · open to ${country.name}` : ""}
    </p>

    {
      rows.length > 0 ? (
        /* The same grid every other listing surface in the product uses: one column on a
           phone, which is the vertical scroll this page exists to have, and two then three
           as the screen earns them. A hairline-separated list was tried here and read as a
           spreadsheet — see the note at the top of OpportunityRow.

           `grid grid-cols-1` ON THE <li>, AND THE SECOND CLASS IS NOT REDUNDANT. The <li> is
           here for list semantics, so the card is a grandchild of the grid and needs the <li>
           to stretch it on both axes — `display: grid` does that, where `flex` would have
           sized the card to its own text (eight cards, eight widths).

           But a grid container with no declared columns puts its child in an IMPLICIT track,
           and `grid-auto-columns: auto` is max-content — which is not clamped to the
           container. One card whose organiser and verification ran long resolved a 432px
           track inside a 358px <li>, overflowed, and scrolled the whole PAGE sideways on a
           390px phone. `grid-cols-1` is `minmax(0, 1fr)`: an explicit track that cannot
           exceed its container. */
        <ul class="mt-3 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
          {rows.map((o) => (
            <li class="grid grid-cols-1">
              <OpportunityRow opportunity={o} lowData={lowData} />
            </li>
          ))}
        </ul>
      ) : (
        /* One sentence naming the situation, one action (DESIGN_SYSTEM.md §6.4).
           Never an illustration, never "Nothing here yet!". */
        <div class="mt-3 rounded-sheet border border-line bg-surface p-5">
          {degraded ? (
            <>
              <p class="font-semibold">We can't load the board right now.</p>
              <p class="mt-1 text-dense text-ink-2">
                Nothing is wrong with your connection as far as we can tell. Try again
                shortly, or search directly.
              </p>
              <p class="mt-2 text-dense">
                <a
                  href="/opportunities"
                  class="inline-flex min-h-11 items-center font-semibold text-brand"
                >
                  Search opportunities
                </a>
              </p>
            </>
          ) : country ? (
            <>
              <p class="font-semibold">Nothing open to {country.name} is closing yet.</p>
              <p class="mt-1 text-dense text-ink-2">
                That is the catalogue being honest, not a filter being clever.
              </p>
              <p class="mt-2 text-dense">
                <a
                  href="/?country=all"
                  class="inline-flex min-h-11 items-center font-semibold text-brand"
                >
                  Show everything
                </a>
              </p>
            </>
          ) : (
            <>
              <p class="font-semibold">Nothing is published yet.</p>
              <p class="mt-1 text-dense text-ink-2">
                The catalogue is still being built. We would rather show you an empty board
                than pad it with listings we cannot stand behind.
              </p>
            </>
          )}
        </div>
      )
    }
  </section>

  {/* ── FEATURED CATEGORIES — the same list, twice more, under a heading. ─────
      A band used to sit here: a full-bleed photograph with the category's name and count
      set over it, alternating its overlay side on desktop so two in a row did not read as
      a template. It was the loudest thing on the page after the hero, and what it said was
      the category's name — which the grid below now says for all twenty-one of them, with
      the same live counts, in one screenful.

      So the heading is the band. Same information (name, count, a way into the category),
      a tenth of the page, and no stock photograph standing in for a fact.

      Deliberately the SAME shape as the board above rather than a contrasting one. The old
      page changed shape between sections on the theory that a page where every section
      looks alike reads as a search result. What it actually produced was a reader deciding,
      at each section, which way this one scrolls. One shape, read one way, and the heading
      is what says a new section has started. ─────────────────────────────────────────── */}

  {
    sections.map((section) => (
      <section class="mx-auto max-w-[1160px] px-4 pt-10" aria-labelledby={`cat-${section.category.code}`}>
        <div class="flex flex-wrap items-center justify-between gap-x-4">
          <h2
            id={`cat-${section.category.code}`}
            class="text-title font-bold tracking-[-0.015em]"
          >
            {section.category.name}s
          </h2>
          <a
            href={`/categories/${section.category.slug}`}
            class="inline-flex min-h-11 items-center text-meta font-semibold text-brand no-underline hover:underline"
          >
            All {section.category.open_count} →
          </a>
        </div>
        <p class="text-meta text-ink-2">{section.category.open_count} open across Africa</p>

        <ul class="mt-3 grid list-none grid-cols-1 gap-4 p-0 md:grid-cols-2 lg:grid-cols-3">
          {section.rows.map((o) => (
            <li class="grid grid-cols-1">
              {/* No category badge on these cards: the section heading two lines above
                  already says it, and repeating it five times in 11px caps is a heading
                  read back in a quieter voice. */}
              <OpportunityRow opportunity={o} lowData={lowData} hideCategory />
            </li>
          ))}
        </ul>
      </section>
    ))
  }

  {/* ── CATEGORY CARDS — the rest of the directory. ──────────────────────────
      Name, live count and the next deadline, which is the fact that decides whether a
      category is worth opening today. This is the section that made the photographic
      bands redundant: it answers "what kinds are there, and is any of them worth my
      time today?" for every category at once, which a band answered for one. ────────── */}
  {
    CATEGORY_CARDS.length > 0 && (
      <section class="mx-auto max-w-[1160px] px-4 pt-12" aria-labelledby="by-category">
        <div class="flex flex-wrap items-center justify-between gap-x-4">
          <h2 id="by-category" class="text-title font-bold tracking-[-0.015em]">
            Browse by kind
          </h2>
          <a
            href="/categories"
            class="inline-flex min-h-11 items-center text-meta font-semibold text-brand no-underline hover:underline"
          >
            All categories →
          </a>
        </div>

        <ul class="mt-3 grid list-none grid-cols-2 gap-3 p-0 lg:grid-cols-3">
          {CATEGORY_CARDS.map((c) => (
            <li>
              {/*
                ONE SHAPE, AND NOW ONE MEDIUM TOO.

                The previous pass got half of this right: it made every card the same
                OBJECT — same height, same text in the same place — but left them made of
                two different materials. Four cards were a photograph under a black
                gradient; the rest were a blue-grey wash. Side by side in a six-card grid
                that is not a rhythm, it is a component that looks like it failed to
                load, and the reader's eye goes to the dark cards because they are dark
                rather than because they matter more.

                So the photographs come out of the grid entirely and the cards are white.
                What distinguishes one from another is now the icon and the count — the
                two things that actually differ — carried on a hairline-and-shadow card
                that matches every other card in the product. The pictures are gone from
                the page entirely now — the bands that were holding them went in the pass
                after this one, because this grid is what made them redundant.

                The icon sits in a brand wash tile rather than loose on the white, which
                gives the card a fixed anchor point so six of them scan as a column of
                names instead of six ragged blocks of text.
              */}
              <a
                href={`/categories/${c.slug}`}
                class="group flex h-full min-h-[128px] flex-col justify-between gap-3 rounded-sheet border border-line bg-surface p-3 no-underline shadow-card transition-shadow hover:border-line-strong hover:shadow-card-hover"
              >
                <span class="flex size-10 shrink-0 items-center justify-center rounded-sheet bg-brand-wash text-brand">
                  <Icon name={c.icon} size={20} class="h-5 w-5" />
                </span>
                <span class="block">
                  <span class="block text-dense font-semibold text-ink">{c.name}</span>
                  <span class="mt-1 block text-micro text-ink-2">
                    {c.open_count} open
                    {shortDate(c.soonest_deadline) && <span> · next {shortDate(c.soonest_deadline)}</span>}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── ELIGIBILITY — one row, not a card with an eyebrow and a paragraph. ─────
      READ, THEN ACT — WHICH ON A PHONE MEANS TOP, THEN BOTTOM.

      `sm:flex-row` made this a row from 381px up. §4.2's `sm` is 381px, not Tailwind's
      640px, and that four-pixel-wide window between "phone" and "row" is the whole bug:
      EVERY phone this product is used on took the desktop layout. Measured at 390px the
      two children split the card — the sentence wrapped to six lines in its half, and
      "Add your details", the entire point of the block, sat in a shrink-wrapped box
      beside it, narrower than the text it was losing to and pinned to the right edge
      where a thumb is not.

      The row now waits for `md` (600px), which is where two columns of this actually
      fit. Below it the card stacks unconditionally: explanation on top, button
      full-width underneath, which is the shape a reader's thumb is already holding. */}
  <section class="mx-auto max-w-[1160px] px-4 pt-10" aria-labelledby="can-i-apply">
    <div class="flex flex-col gap-4 rounded-sheet border border-line bg-surface p-4 shadow-card md:flex-row md:items-center md:justify-between md:gap-3">
      <div>
        <h2 id="can-i-apply" class="text-dense font-semibold">
          Every listing can tell you whether you can apply.
        </h2>
        <p class="mt-1 text-meta text-ink-2">
          Save where you live and what you study. Where the wording is unclear, we say
          unclear rather than guessing.
        </p>
      </div>
      <a
        href="/you/eligibility"
        class="inline-flex min-h-12 w-full shrink-0 items-center justify-center rounded-row bg-brand px-5 text-dense font-semibold text-surface no-underline transition-colors hover:bg-brand-ink md:w-auto"
      >
        {user ? "Your details" : "Add your details"}
      </a>
    </div>
  </section>

  {/* ── COUNTRIES — the heading says what it is; the chips are the content. ──── */}
  {
    entryPoints.countries.length > 0 && (
      <section class="mx-auto max-w-[1160px] px-4 pt-10" aria-labelledby="by-country">
        <div class="flex flex-wrap items-center justify-between gap-x-4">
          <h2 id="by-country" class="text-subtitle font-bold tracking-[-0.015em]">
            Browse by country
          </h2>
          {/* No "all countries →" link beside this heading: the <details> below is already a
              44px control that says the same thing, and two controls for one destination is
              the repetition this pass exists to remove. */}
        </div>

        {/* A `<details>` rather than a "show more" button: it needs no script, and the
            CSP carries no 'unsafe-inline'. The chips ARE the plain links in the HTML for
            a crawler and for a reader with no JavaScript. */}
        <details class="group mt-3">
          <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 text-dense font-semibold text-brand [&::-webkit-details-marker]:hidden">
            Show all {entryPoints.countries.length} countries
            <Icon name="chevron" size={20} class="h-4 w-4 rotate-90 group-open:-rotate-90" />
          </summary>
          <ul class="mt-2 flex list-none flex-wrap gap-2 p-0">
            {entryPoints.countries.map((c) => (
              <li>
                <a
                  href={`/countries/${c.slug}`}
                  class="inline-flex min-h-11 items-center rounded-monogram border border-line px-4 text-meta font-medium text-ink-2 no-underline hover:border-line-strong hover:bg-sunken hover:text-ink"
                >
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </section>
    )
  }

  {/* ── TRUST — four promises, one block. ─────────────────────────────────────
      This was 652px: an eyebrow, a display heading, and three bordered cards each with an
      icon in a circle and a sentence of prose. The promises themselves are short, and
      they are stronger stated plainly together than spaced out across three cards that
      look like features.

      MODERATION_AND_TRUST.md §2.1 rule 3's no-fee line is the last of them and is stated
      here rather than in the footer, so it sits with the promises it belongs with. Base
      passes `trustPanelAbove` to the footer so it is not repeated below. */}
  <section class="mx-auto max-w-[1160px] px-4 pt-10" aria-labelledby="how-kept">
    <div class="rounded-sheet border border-line bg-surface p-4 shadow-card">
      <div class="flex flex-wrap items-center justify-between gap-x-4">
        <h2 id="how-kept" class="text-dense font-semibold">How this list is kept</h2>
        <a
          href="/verification"
          class="inline-flex min-h-11 items-center text-meta font-semibold text-brand no-underline hover:underline"
        >
          What verification means →
        </a>
      </div>
      {/*
        FOUR PROMISES, FOUR TICKS YOU CAN ACTUALLY SEE.

        The mark was a 14px stroked check set flush against the sentence with 8px of gap:
        at 13px type that is a tick the same weight as the text beside it, which makes a
        list of promises read as a paragraph with punctuation in front of it. Each one now
        gets a 20px disc in the eligible wash — the ramp's own green, the colour this
        product already spends on "yes, you can" — and 12px of space before the words.

        The gutter is what does the work: `gap-3` plus a fixed-size disc gives every
        sentence the same left edge, so four promises scan as four rather than as prose.
        The disc is `aria-hidden` and the sentence carries the meaning, per §8.
      */}
      <ul class="mt-3 flex list-none flex-col gap-2.5 p-0 text-meta text-ink-2">
        {
          [
            "Every listing links to the organiser's own page, and says when we last checked it.",
            "Eligibility rules are quoted from the organiser's words, never paraphrased.",
            "Where the wording is unclear, we say unclear rather than guessing.",
            NO_FEE_STATEMENT,
          ].map((promise) => (
            <li class="flex items-start gap-3">
              <span class="mt-px flex size-5 shrink-0 items-center justify-center rounded-monogram bg-eligible-wash text-eligible">
                <Icon name="check" size={20} class="h-3 w-3" />
              </span>
              <span>{promise}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── NUMBERS — a band, not a chapter. Three live counts with no "+" rounding
      (CONTENT_AND_LAUNCH.md §1), plus §2 item 6's freshness line, which belongs with them
      because it is the number that says the others are current. ─────────────────────── */}
  {
    STATS.length > 0 && (
      /*
        NAVY, NOT NEAR-BLACK — AND THE NUMBERS SAY WHAT THEY COUNT.

        This band was `bg-ink`: #101214, the colour reserved for TYPE. A full-bleed strip
        of it is the heaviest thing on the page and it belonged to no part of the brand —
        between a white board above and a grey footer below it read as a gap in the page
        rather than as a statement in it. It is now --brand, which is the same weight of
        mark in a colour the product actually owns.

        White at 70% on the navy measures 6.44:1, comfortably past AA at this size, which
        is what the deepened brand value bought (the old blue would have put it at 5.02:1
        — passing, but with nothing to spare on a cheap panel in sunlight).

        The icons are the second half of the fix. Three bare numbers wrapping on a 390px
        screen ran together into one line of digits; a mark before each gives the eye a
        place to break, and says which of the three it is about to read. They are
        `aria-hidden` and the label carries the meaning, per §8 — nothing here is
        conveyed by an icon alone.
      */
      <section class="mt-10 bg-brand py-7 text-surface" aria-labelledby="stats">
        <h2 id="stats" class="sr-only">{BRAND.name} by the numbers</h2>
        <div class="mx-auto flex max-w-[1160px] flex-wrap items-center gap-x-8 gap-y-4 px-4">
          {STATS.map((stat) => (
            <p class="flex items-center gap-2.5">
              <Icon name={stat.icon} size={20} class="h-5 w-5 shrink-0 text-surface/60" />
              <span class="flex flex-col">
                <span class="text-[1.5rem] leading-7 font-bold tracking-[-0.02em] tabular-nums">
                  <span data-count-to={stat.value}>{stat.value.toLocaleString("en")}</span>
                </span>
                <span class="text-meta text-surface/70">{stat.label}</span>
              </span>
            </p>
          ))}
          {lastVerifiedAt !== null && (
            <p class="flex items-center gap-2.5 text-meta text-surface/70">
              <Icon name="clock" size={20} class="h-5 w-5 shrink-0 text-surface/60" />
              <span>{freshnessLabel(lastVerifiedAt)} against the source.</span>
            </p>
          )}
        </div>
      </section>
    )
  }
</Base>
