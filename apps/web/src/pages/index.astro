---
// The board. UX_FLOWS.md §2.
//
// "The most characteristic thing in this product's world is a live list of things about to
// close. Showing it IS the hero." So there is no hero: one line of what this is, a search
// field, and then eight rows, soonest deadline first, server-rendered above the fold.
//
// Deliberately absent, per §2: hero image, illustration, gradient, animated statistic,
// testimonials, fabricated community numbers, and any count this product cannot verify.
// CONTENT_AND_LAUNCH.md §1: every number shown is true and computed live — which is why the
// counts at the foot of this page come from two queries and disappear when they come back
// empty, rather than being padded to look like a launch.

import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import OpportunityRow from "../components/OpportunityRow.astro";
import {
  getCategoryCounts,
  getCountry,
  getEntryPoints,
  getLastVerifiedAt,
  getPublishedCount,
  listOpportunities,
} from "../lib/db";
import { cachePolicyFor, getResidenceCountry, getSessionUser } from "../lib/auth";
import { freshnessLabel } from "../lib/deadline";
import { resolveLowData } from "../lib/lowdata";
import { itemList, website } from "../lib/seo";
import { BRAND, NO_FEE_STATEMENT } from "@mbele/config";
import { runtimeEnv } from "~/lib/runtime";

export const prerender = false;

const env = runtimeEnv();

/** §2 item 3: 8 rows. Not 10, not 20 — enough to prove the board is alive, above the fold. */
const BOARD_SIZE = 8;

const user = await getSessionUser(Astro.cookies, env);

const lowData = resolveLowData({
  cookies: Astro.cookies,
  request: Astro.request,
  accountPreference: user?.low_data_mode ?? null,
}).on;

/**
 * Which country the board is for, in priority order: the URL, then the signed-in profile,
 * then the edge's coarse country hint.
 *
 * `?country=all` is the "not your country?" escape hatch and means *show everything* — a
 * distinct value is needed because an empty parameter would simply fall through to the
 * profile and the hint again, and the control would look broken.
 *
 * ANALYTICS.md §3 allows a country "from profile or coarse edge geolocation"; the hint is
 * read from the request header, used for this render, and stored nowhere. The same section
 * forbids capturing IP addresses at all, and this code never sees one.
 */
const requested = (Astro.url.searchParams.get("country") ?? "").trim().toUpperCase();
const showAll = requested === "ALL";
const hint = (Astro.request.headers.get("cf-ipcountry") ?? "").trim().toUpperCase();

const resolved = showAll
  ? { iso2: null as string | null, source: "explicit" as const }
  : /^[A-Z]{2}$/.test(requested)
    ? { iso2: requested, source: "url" as const }
    : await (async () => {
        const profile = user ? await getResidenceCountry(Astro.cookies, env) : null;
        if (profile) return { iso2: profile, source: "profile" as const };
        // XX and T1 are Cloudflare's "unknown" and "Tor" answers, not countries.
        if (/^[A-Z]{2}$/.test(hint) && hint !== "XX" && hint !== "T1") {
          return { iso2: hint, source: "hint" as const };
        }
        return { iso2: null as string | null, source: "none" as const };
      })();

const country = resolved.iso2 ? await getCountry(resolved.iso2, env) : null;

// An unknown code is not a country. Falling back to the whole board is better than an
// "Open to ZZ" strip, and better than an error for something the reader did not do wrong.
const countryIso2 = country?.iso2 ?? undefined;

const [board, entryPoints, published, lastVerifiedAt, categoryCounts] = await Promise.all([
  listOpportunities({ limit: BOARD_SIZE, countryIso2 }, env),
  getEntryPoints(env),
  getPublishedCount(env),
  getLastVerifiedAt(env),
  // design/Main.body.html's Explore list shows "41 open" beside each kind. A category
  // index without counts asks the reader to open four pages to find the one with
  // anything in it.
  getCategoryCounts(env),
]);

const rows = board.ok ? board.data : [];
const degraded = !board.ok;

/**
 * Who may cache this, and for how long.
 *
 * The board is identical for everyone EXCEPT when it was shaped by something only this
 * request carries — a session or the edge country hint. Both produce a page at the URL `/`
 * that is not `/` for the next reader, so those responses are private. A country in the URL
 * is part of the cache key and shares safely, which is also why the "not your country?"
 * control navigates rather than setting a preference.
 */
cachePolicyFor(
  Astro.response,
  user,
  degraded ? "public, s-maxage=30" : "public, s-maxage=300, stale-while-revalidate=600",
  resolved.source === "profile" || resolved.source === "hint",
);
// Declared on every response, not only the private ones: even a shareable board depends on
// these two headers for its WEIGHT (low-data mode), and the honest declaration is the same
// either way. See the note on the detail page about what Cloudflare does with `Vary`.
Astro.response.headers.append("vary", "Save-Data, Cookie");

/**
 * §2's offline state: "cached board with 'Last updated' line". The line is rendered on every
 * response, because the service worker serves this HTML back unchanged — a timestamp written
 * at render time is the only one that is still true when the page comes out of a cache.
 */
const builtAt = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
}).format(new Date());

/**
 * SEO.md §3: "`WebSite` with `SearchAction` on the homepage." That is the markup that lets a
 * search engine offer a search box for this site directly in its results, and it is the only
 * structured data on this page that is about the site rather than about a list.
 *
 * The board itself is an ItemList — but only when there is a board. Marking up an empty list
 * would be a claim that there is nothing here, made in a machine-readable way.
 */
const jsonLd = [
  website(Astro.url),
  ...(rows.length > 0
    ? [
        itemList(
          "Closing soonest",
          rows.map((row) => ({ name: row.title, path: `/opportunities/${row.slug}` })),
          Astro.url,
        ),
      ]
    : []),
];

---

<Base
  title={BRAND.name}
  description="Find opportunities open to your country, and know whether you can apply before you spend the data finding out."
  user={user}
  lowData={lowData}
  offlineCapable
  flush
  canonical="/"
  jsonLd={jsonLd}
  feed={{ path: "/feeds/closing-soon.xml", title: "Closing this week" }}
>
  {/* ── HERO ──────────────────────────────────────────────────────────────────
      A real editorial hero — headline, supporting sentence, a search field that is
      the dominant control on the page, and a small set of deliberate category
      entry points. No image, no illustration: the promise ("checked against its
      own source") is made in words because that is the actual product. */}
  <section class="border-b border-line bg-surface">
    <div class="mx-auto max-w-[1160px] px-4 pt-14 pb-10 lg:pt-20 lg:pb-14">
      <h1 class="max-w-[16ch] text-balance text-[2.25rem] leading-[1.1] font-bold tracking-[-0.02em] lg:text-[3rem]">
        Opportunities worth your time.
      </h1>
      <p class="prose-measure mt-4 text-[17px] leading-7 text-ink-2">
        Mbele tracks scholarships, fellowships, hackathons and grants open to Africa, and
        checks each one against its own source — so the deadline you see is the one that's
        real.
      </p>

      {/* A plain GET form to the list page: no JS, no autocomplete request, nothing
          typed leaves the device until the reader presses the button. */}
      <form method="get" action="/opportunities" class="mt-7 flex max-w-xl gap-2">
        <label class="relative flex-1">
          <span class="sr-only">Search opportunities</span>
          <Icon
            name="search"
            size={20}
            class="pointer-events-none absolute top-1/2 left-4 h-[18px] w-[18px] -translate-y-1/2 text-ink-3"
          />
          <input
            type="search"
            name="q"
            placeholder="Search scholarships, hackathons, grants…"
            class="h-14 w-full rounded-sheet border border-line-strong bg-surface pr-3 pl-11 text-[15px] shadow-card"
          />
        </label>
        <button
          type="submit"
          class="h-14 shrink-0 rounded-sheet bg-brand px-6 text-dense font-semibold text-surface hover:bg-brand-ink"
        >
          Search
        </button>
      </form>

      {/* A small, deliberate set of paths in — not a wall of pills. */}
      {
        entryPoints.categories.length > 0 && (
          <ul class="mt-4 flex list-none flex-wrap gap-2 p-0">
            {entryPoints.categories.slice(0, 5).map((category) => (
              <li>
                <a
                  href={`/categories/${category.slug}`}
                  class="inline-flex min-h-11 items-center rounded-monogram border border-line px-4 text-meta font-medium text-ink-2 no-underline hover:border-line-strong hover:bg-sunken hover:text-ink"
                >
                  {category.name}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </div>
  </section>

  {/* ── LOCATION PERSONALISATION — a product feature, not a stray form. ────── */}
  {
    country && (
      <div class="border-b border-line bg-sunken">
        <div class="mx-auto max-w-[1160px] px-4 py-4">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:gap-4">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-monogram bg-brand-wash text-brand">
              <Icon name="globe" size={20} />
            </span>
            <p class="flex-1 text-dense">
              <strong class="font-semibold">Opportunities for {country.name}.</strong>{" "}
              <span class="text-ink-2">We've matched these to your location, plus everything open Africa-wide.</span>
            </p>
            <a
              href="/?country=all"
              class="inline-flex min-h-11 shrink-0 items-center rounded-row border border-line-strong bg-surface px-4 text-meta font-semibold text-ink no-underline hover:bg-surface/70 sm:self-auto"
            >
              Change location
            </a>
          </div>
        </div>
      </div>
    )
  }

  {
    showAll && (
      <div class="border-b border-line bg-sunken">
        <div class="mx-auto flex max-w-[1160px] flex-wrap items-center gap-3 px-4 py-4">
          <p class="flex-1 text-dense text-ink-2">Showing every open opportunity across Africa.</p>
          <a
            href="/"
            class="inline-flex min-h-11 items-center rounded-row border border-line-strong bg-surface px-4 text-meta font-semibold text-ink no-underline hover:bg-surface/70"
          >
            Use my location again
          </a>
        </div>
      </div>
    )
  }

  {/* ── CLOSING SOON ──────────────────────────────────────────────────────── */}
  <section class="mx-auto max-w-[1160px] px-4 pt-12" aria-labelledby="board">
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow text-brand">Closing soonest</p>
        <h2 id="board" class="mt-1 text-title font-bold tracking-[-0.015em]">
          What needs you this week
        </h2>
        {/* The "Last updated" line of §2's offline state, rendered on every response
            because the service worker serves this HTML back unchanged. */}
        <p class="mt-1 text-meta text-ink-2">
          Board as of {builtAt} UTC{rows.length > 0 ? ` · ${rows.length} open${country ? ` to ${country.name}` : ""}` : ""}
        </p>
      </div>
      {
        rows.length > 0 && (
          <a href="/opportunities" class="hidden shrink-0 text-dense font-semibold text-brand no-underline hover:underline sm:block">
            View all closing soon →
          </a>
        )
      }
    </div>

    {
      rows.length > 0 ? (
        <>
          <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {rows.map((o) => (
              <OpportunityRow opportunity={o} lowData={lowData} />
            ))}
          </div>
          <div class="mt-5 pb-2 sm:hidden">
            <a href="/opportunities" class="text-dense font-semibold text-brand no-underline">
              View all closing soon →
            </a>
          </div>
        </>
      ) : (
        /* One sentence naming the situation, one action (DESIGN_SYSTEM.md §6.4).
           Never an illustration, never "Nothing here yet!". */
        <div class="mt-5 rounded-sheet border border-line bg-surface p-5">
          {degraded ? (
            <>
              <p class="font-semibold">We can't load the board right now.</p>
              <p class="mt-1 text-dense text-ink-2">
                Nothing is wrong with your connection as far as we can tell. Try again
                shortly, or search directly.
              </p>
              <p class="mt-2 text-dense">
                <a href="/opportunities" class="font-semibold text-brand">Search opportunities</a>
              </p>
            </>
          ) : country ? (
            <>
              <p class="font-semibold">Nothing open to {country.name} is closing yet.</p>
              <p class="mt-1 text-dense text-ink-2">
                That is the catalogue being honest, not a filter being clever.
              </p>
              <p class="mt-2 text-dense">
                <a href="/?country=all" class="font-semibold text-brand">Show everything</a>
              </p>
            </>
          ) : (
            <>
              <p class="font-semibold">Nothing is published yet.</p>
              <p class="mt-1 text-dense text-ink-2">
                The catalogue is still being built. We would rather show you an empty board
                than pad it with listings we cannot stand behind.
              </p>
            </>
          )}
        </div>
      )
    }
  </section>

  {/* ── BROWSE BY CATEGORY — a discovery grid, not a database index. ───────── */}
  {
    entryPoints.categories.length > 0 && (
      <section class="mx-auto max-w-[1160px] px-4 pt-14" aria-labelledby="by-kind">
        <p class="eyebrow text-brand">Explore</p>
        <h2 id="by-kind" class="mt-1 text-title font-bold tracking-[-0.015em]">
          Browse by category
        </h2>
        <div class="mt-5 grid grid-cols-2 gap-3 md:grid-cols-4">
          {entryPoints.categories.map((category) => {
            const open = categoryCounts.find((c) => c.code === category.code)?.open_count;
            return (
              <a
                href={`/categories/${category.slug}`}
                class="flex flex-col gap-1 rounded-sheet border border-line bg-surface p-4 text-ink no-underline transition-colors hover:border-line-strong hover:bg-sunken"
              >
                <span class="text-dense font-semibold">{category.name}</span>
                {/* A count only where there is one. "0 open" on a page the reader is
                    being invited to open is worse than saying nothing. */}
                <span class="text-meta text-ink-3">
                  {open !== undefined && open > 0 ? `${open} open` : "Browse"}
                </span>
              </a>
            );
          })}
        </div>
        <p class="mt-4">
          <a href="/categories" class="text-dense font-semibold text-brand no-underline hover:underline">
            All categories →
          </a>
        </p>
      </section>
    )
  }

  {/* ── BROWSE BY LOCATION — compact, correctable, part of the product. ────── */}
  {
    entryPoints.countries.length > 0 && (
      <section class="mx-auto max-w-[1160px] px-4 pt-14" aria-labelledby="by-country">
        <p class="eyebrow text-brand">Explore</p>
        <h2 id="by-country" class="mt-1 text-title font-bold tracking-[-0.015em]">
          Browse by country
        </h2>
        <p class="mt-1 text-meta text-ink-2">Every African country is its own page here.</p>

        {/* A `<details>` rather than a "show more" button: it needs no script, and the
            CSP carries no 'unsafe-inline'. The chips ARE the plain links in the HTML for
            a crawler and for a reader with no JavaScript. */}
        <details class="group mt-4">
          <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 text-dense font-semibold text-brand [&::-webkit-details-marker]:hidden">
            Show all {entryPoints.countries.length} countries
            <Icon name="chevron" size={20} class="h-4 w-4 rotate-90 group-open:-rotate-90" />
          </summary>
          <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
            {entryPoints.countries.map((c) => (
              <li>
                <a
                  href={`/countries/${c.slug}`}
                  class="inline-flex min-h-11 items-center rounded-monogram border border-line px-4 text-meta font-medium text-ink-2 no-underline hover:border-line-strong hover:bg-sunken hover:text-ink"
                >
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </section>
    )
  }

  {/* ── CAN I APPLY? — the eligibility profile, framed as a core capability. ── */}
  <section class="mx-auto max-w-[1160px] px-4 pt-14" aria-labelledby="can-i-apply">
    <div class="flex flex-col gap-5 rounded-sheet border border-line bg-surface p-6 sm:flex-row sm:items-center">
      <div class="flex-1">
        <p class="eyebrow text-brand">Can you apply?</p>
        <h2 id="can-i-apply" class="mt-1 text-subtitle font-semibold">
          Tell us where you live, and we'll check every listing against it.
        </h2>
        <p class="mt-2 max-w-[56ch] text-dense text-ink-2">
          Most rules turn on residence and what you're studying. With those saved, each
          opportunity says whether you qualify — and where the wording is unclear, it says
          unclear rather than guessing.
        </p>
      </div>
      <a
        href="/you/eligibility"
        class="inline-flex min-h-12 shrink-0 items-center rounded-row bg-brand px-5 text-dense font-semibold text-surface no-underline hover:bg-brand-ink"
      >
        {user ? "Your eligibility details" : "Add your details"}
      </a>
    </div>
  </section>

  {/* ── TRUST — "earns its place by being specific about what is and is not known."
      MODERATION_AND_TRUST.md §2.1 rule 3's no-fee line is the third of these, stated
      here rather than in the footer so it sits with the two promises it belongs with.
      Base passes `trustPanelAbove` to the footer so it is not repeated below. */}
  <section class="mx-auto max-w-[1160px] px-4 pt-14 pb-4" aria-labelledby="how-kept">
    <p class="eyebrow text-brand">How this list is kept</p>
    <h2 id="how-kept" class="mt-1 text-title font-bold tracking-[-0.015em]">
      Nothing here is copied and forgotten.
    </h2>
    <div class="mt-5 grid grid-cols-1 gap-4 sm:grid-cols-3">
      {
        [
          {
            icon: "shield" as const,
            text: "Every listing links to the organiser's own page, and we re-check it on a schedule. Each one says when it was last checked.",
          },
          {
            icon: "check" as const,
            text: "Eligibility rules are quoted from the organiser's words. Where the wording is unclear, we say unclear rather than guessing.",
          },
          { icon: "alert" as const, text: NO_FEE_STATEMENT },
        ].map((item) => (
          <div class="rounded-sheet border border-line bg-surface p-5">
            <span class="flex size-9 items-center justify-center rounded-monogram bg-brand-wash text-brand">
              <Icon name={item.icon} size={20} />
            </span>
            <p class="mt-3 text-dense text-ink-2">{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* §2 item 6: counts that are true. Both come from live queries, and each disappears
      rather than showing a zero or a guess. */}
  {
    (published !== null || lastVerifiedAt !== null) && (
      <p class="mx-auto max-w-[1160px] px-4 pt-4 text-meta text-ink-3">
        {published !== null && published > 0 && (
          <span>
            {published} {published === 1 ? "opportunity" : "opportunities"} published.{" "}
          </span>
        )}
        {lastVerifiedAt !== null && <span>{freshnessLabel(lastVerifiedAt)} against the source.</span>}
      </p>
    )
  }
</Base>
