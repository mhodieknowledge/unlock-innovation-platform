---
// The board. UX_FLOWS.md §2.
//
// "The most characteristic thing in this product's world is a live list of things about to
// close." The live board is still the substance of the page — but the composition around it
// has been rebuilt twice now on explicit direction: first from a text-only notice board to an
// image-rich one, then again after the first pass read as a generic scrolling page rather than
// a product that sells itself. This version leans into variety of layout on purpose — a
// full-bleed cinematic hero, a real slide carousel (not a raw horizontal scroll), two editorial
// category features instead of a repeated card grid, and a bold numbers band — because a
// homepage that uses the same "eyebrow + heading + grid" shape six times in a row is the thing
// that reads as boring, independent of how nice any one instance of that shape is.
//
// CONTENT_AND_LAUNCH.md §1: every number shown is true and computed live — which is why the
// counts on this page (the hero badge, the stats band, the footer line) come from live queries
// and disappear when they come back empty, rather than being padded to look like a launch.
// Photography is category-level and generic (what a hackathon/scholarship looks like), never
// attached to a specific listing — attaching stock photography to one real opportunity would be
// exactly the kind of unverifiable claim this product refuses to make.

import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import OpportunityRow from "../components/OpportunityRow.astro";
import heroImage from "../assets/marketing/hero-collab.jpg";
import catHackathon from "../assets/marketing/cat-hackathon.jpg";
import catScholarship from "../assets/marketing/cat-scholarship.jpg";
import catGrant from "../assets/marketing/cat-grant.jpg";
import catInternship from "../assets/marketing/cat-internship.jpg";
import {
  getCategoryCounts,
  getCountry,
  getEntryPoints,
  getLastVerifiedAt,
  getPublishedCount,
  listOpportunities,
} from "../lib/db";
import { cachePolicyFor, getResidenceCountry, getSessionUser } from "../lib/auth";
import { freshnessLabel } from "../lib/deadline";
import { resolveLowData } from "../lib/lowdata";
import { itemList, website } from "../lib/seo";
import { BRAND, NO_FEE_STATEMENT } from "@mbele/config";
import { runtimeEnv } from "~/lib/runtime";

/** One representative photo per category, used only for the two feature blocks below —
 * never rendered on an individual opportunity, which has no photo of its own. */
const CATEGORY_IMAGES: Record<string, ImageMetadata> = {
  hackathon: catHackathon,
  scholarship: catScholarship,
  grant: catGrant,
  internship: catInternship,
};
const FEATURED_CATEGORY_CODES = ["hackathon", "scholarship", "grant", "internship"];

export const prerender = false;

const env = runtimeEnv();

/** §2 item 3: 8 rows. Not 10, not 20 — enough to prove the board is alive, above the fold. */
const BOARD_SIZE = 8;

const user = await getSessionUser(Astro.cookies, env);

const lowData = resolveLowData({
  cookies: Astro.cookies,
  request: Astro.request,
  accountPreference: user?.low_data_mode ?? null,
}).on;

/**
 * Which country the board is for, in priority order: the URL, then the signed-in profile,
 * then the edge's coarse country hint.
 *
 * `?country=all` is the "not your country?" escape hatch and means *show everything* — a
 * distinct value is needed because an empty parameter would simply fall through to the
 * profile and the hint again, and the control would look broken.
 *
 * ANALYTICS.md §3 allows a country "from profile or coarse edge geolocation"; the hint is
 * read from the request header, used for this render, and stored nowhere. The same section
 * forbids capturing IP addresses at all, and this code never sees one.
 */
const requested = (Astro.url.searchParams.get("country") ?? "").trim().toUpperCase();
const showAll = requested === "ALL";
const hint = (Astro.request.headers.get("cf-ipcountry") ?? "").trim().toUpperCase();

const resolved = showAll
  ? { iso2: null as string | null, source: "explicit" as const }
  : /^[A-Z]{2}$/.test(requested)
    ? { iso2: requested, source: "url" as const }
    : await (async () => {
        const profile = user ? await getResidenceCountry(Astro.cookies, env) : null;
        if (profile) return { iso2: profile, source: "profile" as const };
        // XX and T1 are Cloudflare's "unknown" and "Tor" answers, not countries.
        if (/^[A-Z]{2}$/.test(hint) && hint !== "XX" && hint !== "T1") {
          return { iso2: hint, source: "hint" as const };
        }
        return { iso2: null as string | null, source: "none" as const };
      })();

const country = resolved.iso2 ? await getCountry(resolved.iso2, env) : null;

// An unknown code is not a country. Falling back to the whole board is better than an
// "Open to ZZ" strip, and better than an error for something the reader did not do wrong.
const countryIso2 = country?.iso2 ?? undefined;

const [board, entryPoints, published, lastVerifiedAt, categoryCounts] = await Promise.all([
  listOpportunities({ limit: BOARD_SIZE, countryIso2 }, env),
  getEntryPoints(env),
  getPublishedCount(env),
  getLastVerifiedAt(env),
  getCategoryCounts(env),
]);

const rows = board.ok ? board.data : [];
const degraded = !board.ok;

/**
 * Two category feature blocks — not four, and not a card grid. The homepage's category
 * story used to be told three times over (hero pills, a card-grid rail per category, and a
 * flat "browse by category" tile grid) — exactly the repetition a reader notices as
 * clutter, and the categories page already exists to be the actual directory. Now it is
 * told once here, as two editorial blocks for the two categories with the most open right
 * now: a photo, a real number, three real titles as plain links, and a link to the rest.
 * Limited to categories with a representative photo AND something actually open — a photo
 * over an empty section is decoration standing in for content, which CONTENT_AND_LAUNCH.md
 * §1 rules out.
 */
const featuredCategories = FEATURED_CATEGORY_CODES.map((code) =>
  entryPoints.categories.find((c) => c.code === code),
)
  .filter((c): c is { code: string; name: string; slug: string } => c !== undefined)
  .map((c) => ({ ...c, open_count: categoryCounts.find((cc) => cc.code === c.code)?.open_count ?? 0 }))
  .filter((c) => c.open_count > 0)
  .sort((a, b) => b.open_count - a.open_count)
  .slice(0, 2);

const featuredResults = await Promise.all(
  featuredCategories.map((c) => listOpportunities({ categoryCode: c.code, limit: 3, countryIso2 }, env)),
);

const featuredSections = featuredCategories
  .map((category, i) => ({
    category,
    examples: featuredResults[i]?.ok ? featuredResults[i].data : [],
    image: CATEGORY_IMAGES[category.code],
  }))
  .filter((section) => section.examples.length > 0);

/**
 * The hero's rotating stat — real counts, not marketing copy. Padded to exactly four slots
 * (repeating if the catalogue has fewer than four categories open) because the CSS keyframe
 * that drives it is a fixed four-step cycle (tokens.css `word-cycle-4`) — a per-request
 * inline <style> to match an arbitrary count is not possible under this CSP (style-src
 * 'self', no unsafe-inline).
 */
const CYCLE_SLOTS = 4;
const withOpenCounts = categoryCounts.filter((c) => c.open_count > 0).sort((a, b) => b.open_count - a.open_count);
const cycleCategories =
  withOpenCounts.length > 0
    ? Array.from({ length: CYCLE_SLOTS }, (_, i) => withOpenCounts[i % withOpenCounts.length])
    : [];

/**
 * Who may cache this, and for how long.
 *
 * The board is identical for everyone EXCEPT when it was shaped by something only this
 * request carries — a session or the edge country hint. Both produce a page at the URL `/`
 * that is not `/` for the next reader, so those responses are private. A country in the URL
 * is part of the cache key and shares safely, which is also why the "not your country?"
 * control navigates rather than setting a preference.
 */
cachePolicyFor(
  Astro.response,
  user,
  degraded ? "public, s-maxage=30" : "public, s-maxage=300, stale-while-revalidate=600",
  resolved.source === "profile" || resolved.source === "hint",
);
// Declared on every response, not only the private ones: even a shareable board depends on
// these two headers for its WEIGHT (low-data mode), and the honest declaration is the same
// either way. See the note on the detail page about what Cloudflare does with `Vary`.
Astro.response.headers.append("vary", "Save-Data, Cookie");

/**
 * §2's offline state: "cached board with 'Last updated' line". The line is rendered on every
 * response, because the service worker serves this HTML back unchanged — a timestamp written
 * at render time is the only one that is still true when the page comes out of a cache.
 */
const builtAt = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
}).format(new Date());

/**
 * SEO.md §3: "`WebSite` with `SearchAction` on the homepage." That is the markup that lets a
 * search engine offer a search box for this site directly in its results, and it is the only
 * structured data on this page that is about the site rather than about a list.
 *
 * The board itself is an ItemList — but only when there is a board. Marking up an empty list
 * would be a claim that there is nothing here, made in a machine-readable way.
 */
const jsonLd = [
  website(Astro.url),
  ...(rows.length > 0
    ? [
        itemList(
          "Closing soonest",
          rows.map((row) => ({ name: row.title, path: `/opportunities/${row.slug}` })),
          Astro.url,
        ),
      ]
    : []),
];

/** The stats band. Three numbers, all live, none rounded up with a "+" — CONTENT_AND_LAUNCH.md
 * §1 and apps/web/test/home-route.test.ts both rule out the marketing-rounding pattern. */
const STATS = [
  { value: published ?? 0, label: (published ?? 0) === 1 ? "opportunity tracked" : "opportunities tracked" },
  { value: entryPoints.countries.length, label: "African countries covered" },
  { value: entryPoints.categories.length, label: "categories tracked" },
].filter((s) => s.value > 0);
---

<Base
  title={BRAND.name}
  description="Find opportunities open to your country, and know whether you can apply before you spend the data finding out."
  user={user}
  lowData={lowData}
  offlineCapable
  flush
  canonical="/"
  jsonLd={jsonLd}
  feed={{ path: "/feeds/closing-soon.xml", title: "Closing this week" }}
>
  {/* ── HERO ──────────────────────────────────────────────────────────────────
      Full-bleed photograph with the headline set directly over it — the "this is a real,
      confident product" moment the page opens with — over a Ken Burns drift (tokens.css
      `.hero-kenburns`) so it never sits static. Text enters staggered via [data-reveal].
      In low-data mode there is no photograph at all: a plain, fast, text-only hero instead,
      never a slow image pretending to be a fast one. */}
  {
    lowData ? (
      <section class="border-b border-line bg-surface">
        <div class="mx-auto max-w-[1160px] px-4 pt-14 pb-10 lg:pt-20 lg:pb-16">
          <h1 class="max-w-[16ch] text-balance text-[2.25rem] leading-[1.1] font-bold tracking-[-0.02em] lg:text-[3rem]">
            Opportunities worth your time.
          </h1>
          <p class="prose-measure mt-4 text-[17px] leading-7 text-ink-2">
            Mbele tracks scholarships, fellowships, hackathons and grants open to Africa, and
            checks each one against its own source — so the deadline you see is the one
            that's real.
          </p>
          <form method="get" action="/opportunities" class="mt-7 flex max-w-xl gap-2">
            <label class="relative flex-1">
              <span class="sr-only">Search opportunities</span>
              <input
                type="search"
                name="q"
                placeholder="Search scholarships, hackathons, grants…"
                class="h-14 w-full rounded-sheet border border-line-strong bg-surface px-4 text-[15px]"
              />
            </label>
            <button
              type="submit"
              class="h-14 shrink-0 rounded-sheet bg-brand px-6 text-dense font-semibold text-surface hover:bg-brand-ink"
            >
              Search
            </button>
          </form>
        </div>
      </section>
    ) : (
      <section class="relative isolate min-h-[560px] overflow-hidden border-b border-line lg:min-h-[680px]">
        <Image
          src={heroImage}
          alt=""
          aria-hidden="true"
          widths={[480, 800, 1200, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-kenburns absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/85 via-black/45 to-black/15" />
        <div class="absolute inset-0 -z-10 bg-gradient-to-r from-black/55 via-black/10 to-transparent" />

        <div class="relative mx-auto flex min-h-[560px] max-w-[1160px] flex-col justify-end px-4 pt-28 pb-10 lg:min-h-[680px] lg:pb-16">
          {
            cycleCategories.length === CYCLE_SLOTS && (
              <p
                data-reveal
                class="inline-flex w-fit items-center gap-2 rounded-monogram border border-white/25 bg-white/10 px-3 py-1 text-meta font-semibold text-white shadow-card backdrop-blur-sm"
              >
                <span class="relative flex size-2 shrink-0">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-monogram bg-eligible opacity-75" />
                  <span class="relative inline-flex size-2 rounded-monogram bg-eligible" />
                </span>
                <span class="word-cycle">
                  <span class="word-cycle-track">
                    {cycleCategories.map((c) => (
                      <span>
                        {c.open_count} {c.name.toLowerCase()} open now
                      </span>
                    ))}
                  </span>
                </span>
              </p>
            )
          }

          <h1
            data-reveal
            class="reveal-d1 mt-4 max-w-[18ch] text-balance text-[2.5rem] leading-[1.05] font-bold tracking-[-0.025em] text-white lg:text-[4rem]"
          >
            Opportunities worth your time.
          </h1>
          <p data-reveal class="reveal-d2 prose-measure mt-4 text-[18px] leading-7 text-white/85">
            Mbele tracks scholarships, fellowships, hackathons and grants open to Africa, and
            checks each one against its own source — so the deadline you see is the one
            that's real.
          </p>

          {/* A plain GET form to the list page: no JS, no autocomplete request, nothing
              typed leaves the device until the reader presses the button. */}
          <form method="get" action="/opportunities" data-reveal class="reveal-d3 mt-8 flex max-w-xl gap-2">
            <label class="relative flex-1">
              <span class="sr-only">Search opportunities</span>
              <Icon
                name="search"
                size={20}
                class="pointer-events-none absolute top-1/2 left-4 h-[18px] w-[18px] -translate-y-1/2 text-ink-3"
              />
              <input
                type="search"
                name="q"
                placeholder="Search scholarships, hackathons, grants…"
                class="h-14 w-full rounded-sheet border-0 bg-surface pr-3 pl-11 text-[15px] shadow-[0_8px_30px_rgba(0,0,0,0.25)]"
              />
            </label>
            <button
              type="submit"
              class="h-14 shrink-0 rounded-sheet bg-brand px-6 text-dense font-semibold text-surface transition-colors hover:bg-brand-ink"
            >
              Search
            </button>
          </form>

          <p data-reveal class="reveal-d4 mt-4 flex items-center gap-2 text-meta text-white/70">
            <Icon name="check" size={20} class="h-4 w-4 shrink-0 text-eligible" />
            Checked against real sources — never scraped and forgotten.
          </p>
        </div>
      </section>
    )
  }

  {/* ── LOCATION PERSONALISATION — a product feature, not a stray form. ────── */}
  {
    country && (
      <div class="border-b border-line bg-sunken">
        <div class="mx-auto max-w-[1160px] px-4 py-4">
          <div class="flex flex-col gap-3 md:flex-row md:items-center md:gap-4">
            <span class="flex size-10 shrink-0 items-center justify-center rounded-monogram bg-brand-wash text-brand">
              <Icon name="globe" size={20} />
            </span>
            <p class="flex-1 text-dense">
              <strong class="font-semibold">Opportunities for {country.name}.</strong>{" "}
              <span class="text-ink-2">We've matched these to your location, plus everything open Africa-wide.</span>
            </p>
            <a
              href="/?country=all"
              class="inline-flex min-h-11 shrink-0 items-center justify-center rounded-row border border-line-strong bg-surface px-4 text-meta font-semibold text-ink no-underline hover:bg-surface/70 md:self-auto"
            >
              Change location
            </a>
          </div>
        </div>
      </div>
    )
  }

  {
    showAll && (
      <div class="border-b border-line bg-sunken">
        <div class="mx-auto flex max-w-[1160px] flex-wrap items-center gap-3 px-4 py-4">
          <p class="flex-1 text-dense text-ink-2">Showing every open opportunity across Africa.</p>
          <a
            href="/"
            class="inline-flex min-h-11 items-center rounded-row border border-line-strong bg-surface px-4 text-meta font-semibold text-ink no-underline hover:bg-surface/70"
          >
            Use my location again
          </a>
        </div>
      </div>
    )
  }

  {/* ── CLOSING SOON — a spotlight carousel, not a listing grid or a raw scroll strip.
      Every row the query returned is in the DOM as its own complete, full-size card
      ([data-slide]); without JavaScript they simply stack as an ordinary list — nothing is
      truncated or hidden. motion.js turns the same markup into a real one-at-a-time deck
      with dots, arrows, swipe and keyboard support the instant it runs. ────────────────── */}
  <section class="mx-auto max-w-[1160px] px-4 pt-14" aria-labelledby="board" data-reveal>
    <div class="flex flex-wrap items-end justify-between gap-3">
      <div>
        <p class="eyebrow text-brand">Closing soonest</p>
        <h2 id="board" class="mt-1 text-title font-bold tracking-[-0.015em]">
          What needs you this week
        </h2>
        {/* The "Last updated" line of §2's offline state, rendered on every response
            because the service worker serves this HTML back unchanged. */}
        <p class="mt-1 text-meta text-ink-2">
          Board as of {builtAt} UTC{rows.length > 0 ? ` · ${rows.length} open${country ? ` to ${country.name}` : ""}` : ""}
        </p>
      </div>
      {
        rows.length > 0 && (
          <a href="/opportunities" class="shrink-0 text-dense font-semibold text-brand no-underline hover:underline">
            View all open opportunities →
          </a>
        )
      }
    </div>

    {
      rows.length > 0 ? (
        <div class="mx-auto mt-6 max-w-2xl" data-carousel>
          {rows.map((o) => (
            <div data-slide>
              <OpportunityRow opportunity={o} lowData={lowData} />
            </div>
          ))}
        </div>
      ) : (
        /* One sentence naming the situation, one action (DESIGN_SYSTEM.md §6.4).
           Never an illustration, never "Nothing here yet!". */
        <div class="mt-5 rounded-sheet border border-line bg-surface p-5">
          {degraded ? (
            <>
              <p class="font-semibold">We can't load the board right now.</p>
              <p class="mt-1 text-dense text-ink-2">
                Nothing is wrong with your connection as far as we can tell. Try again
                shortly, or search directly.
              </p>
              <p class="mt-2 text-dense">
                <a href="/opportunities" class="font-semibold text-brand">Search opportunities</a>
              </p>
            </>
          ) : country ? (
            <>
              <p class="font-semibold">Nothing open to {country.name} is closing yet.</p>
              <p class="mt-1 text-dense text-ink-2">
                That is the catalogue being honest, not a filter being clever.
              </p>
              <p class="mt-2 text-dense">
                <a href="/?country=all" class="font-semibold text-brand">Show everything</a>
              </p>
            </>
          ) : (
            <>
              <p class="font-semibold">Nothing is published yet.</p>
              <p class="mt-1 text-dense text-ink-2">
                The catalogue is still being built. We would rather show you an empty board
                than pad it with listings we cannot stand behind.
              </p>
            </>
          )}
        </div>
      )
    }
  </section>

  {/* ── CATEGORY FEATURES — two editorial blocks, alternating sides, not a repeated card
      grid. Each names a real count and links to three real listings as plain text, then to
      the category's own page for everything else. ─────────────────────────────────────── */}
  {
    featuredSections.map((section, i) => (
      <section
        class="mx-auto max-w-[1160px] px-4 pt-16"
        aria-labelledby={`cat-${section.category.code}`}
        data-reveal
      >
        <div class={`flex flex-col gap-8 lg:flex-row lg:items-center lg:gap-14 ${i % 2 === 1 ? "lg:flex-row-reverse" : ""}`}>
          <div class="lg:w-1/2">
            {!lowData && section.image && (
              <Image
                src={section.image}
                alt=""
                aria-hidden="true"
                widths={[480, 800, 1000]}
                sizes="(min-width: 1024px) 50vw, 100vw"
                class="aspect-[4/3] w-full rounded-sheet object-cover shadow-card"
              />
            )}
          </div>
          <div class="lg:w-1/2">
            <p class="eyebrow text-brand">Category</p>
            <h2
              id={`cat-${section.category.code}`}
              class="mt-1 text-title font-bold tracking-[-0.015em] lg:text-display"
            >
              {section.category.name}s on {BRAND.name}
            </h2>
            <p class="mt-3 text-dense text-ink-2">
              {section.category.open_count} open right now, each checked against its own
              source and quoted for eligibility rather than summarised.
            </p>
            <ul class="mt-4 flex list-none flex-col gap-2 p-0">
              {section.examples.map((o) => (
                <li>
                  <a
                    href={`/opportunities/${o.slug}`}
                    class="flex items-center gap-2 text-dense font-medium text-ink no-underline hover:text-brand hover:underline"
                  >
                    <Icon name="chevron" size={20} class="h-3.5 w-3.5 shrink-0 text-ink-3" />
                    <span class="line-clamp-1">{o.title}</span>
                  </a>
                </li>
              ))}
            </ul>
            <a
              href={`/categories/${section.category.slug}`}
              class="mt-5 inline-flex min-h-11 items-center rounded-row bg-brand px-5 text-dense font-semibold text-surface no-underline hover:bg-brand-ink"
            >
              Explore {section.category.name.toLowerCase()}s →
            </a>
          </div>
        </div>
      </section>
    ))
  }

  <div class="mx-auto max-w-[1160px] px-4 pt-8" data-reveal>
    <a href="/categories" class="text-dense font-semibold text-brand no-underline hover:underline">
      See every category →
    </a>
  </div>

  {/* ── NUMBERS — the emotional beat: this is a real, live catalogue, stated plainly and
      big. Every figure is a live count with no "+" rounding (CONTENT_AND_LAUNCH.md §1). ── */}
  {
    STATS.length > 0 && (
      <section class="mt-16 bg-ink py-14 text-surface" aria-labelledby="stats" data-reveal>
        <h2 id="stats" class="sr-only">
          {BRAND.name} by the numbers
        </h2>
        <div class="mx-auto grid max-w-[1160px] grid-cols-1 gap-8 px-4 sm:grid-cols-3">
          {STATS.map((stat) => (
            <div>
              <p class="text-[2.5rem] font-bold tracking-[-0.02em] tabular-nums">
                <span data-count-to={stat.value}>{stat.value.toLocaleString("en")}</span>
              </p>
              <p class="mt-1 text-dense text-surface/70">{stat.label}</p>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {/* ── BROWSE BY LOCATION — compact, correctable, part of the product. ────── */}
  {
    entryPoints.countries.length > 0 && (
      <section class="mx-auto max-w-[1160px] px-4 pt-14" aria-labelledby="by-country" data-reveal>
        <p class="eyebrow text-brand">Explore</p>
        <h2 id="by-country" class="mt-1 text-title font-bold tracking-[-0.015em]">
          Browse by country
        </h2>
        <p class="mt-1 text-meta text-ink-2">Every African country is its own page here.</p>

        {/* A `<details>` rather than a "show more" button: it needs no script, and the
            CSP carries no 'unsafe-inline'. The chips ARE the plain links in the HTML for
            a crawler and for a reader with no JavaScript. */}
        <details class="group mt-4">
          <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 text-dense font-semibold text-brand [&::-webkit-details-marker]:hidden">
            Show all {entryPoints.countries.length} countries
            <Icon name="chevron" size={20} class="h-4 w-4 rotate-90 group-open:-rotate-90" />
          </summary>
          <ul class="mt-3 flex list-none flex-wrap gap-2 p-0">
            {entryPoints.countries.map((c) => (
              <li>
                <a
                  href={`/countries/${c.slug}`}
                  class="inline-flex min-h-11 items-center rounded-monogram border border-line px-4 text-meta font-medium text-ink-2 no-underline hover:border-line-strong hover:bg-sunken hover:text-ink"
                >
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </section>
    )
  }

  {/* ── CAN I APPLY? — the eligibility profile, framed as a core capability. ── */}
  <section class="mx-auto max-w-[1160px] px-4 pt-14" aria-labelledby="can-i-apply" data-reveal>
    <div class="flex flex-col gap-5 rounded-sheet border border-line bg-surface p-6 md:flex-row md:items-center">
      <div class="flex-1">
        <p class="eyebrow text-brand">Can you apply?</p>
        <h2 id="can-i-apply" class="mt-1 text-subtitle font-semibold">
          Tell us where you live, and we'll check every listing against it.
        </h2>
        <p class="mt-2 max-w-[56ch] text-dense text-ink-2">
          Most rules turn on residence and what you're studying. With those saved, each
          opportunity says whether you qualify — and where the wording is unclear, it says
          unclear rather than guessing.
        </p>
      </div>
      <a
        href="/you/eligibility"
        class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-row bg-brand px-5 text-dense font-semibold text-surface no-underline transition-colors hover:bg-brand-ink md:w-auto"
      >
        {user ? "Your eligibility details" : "Add your details"}
      </a>
    </div>
  </section>

  {/* ── TRUST — "earns its place by being specific about what is and is not known."
      MODERATION_AND_TRUST.md §2.1 rule 3's no-fee line is the third of these, stated
      here rather than in the footer so it sits with the two promises it belongs with.
      Base passes `trustPanelAbove` to the footer so it is not repeated below. */}
  <section class="mx-auto max-w-[1160px] px-4 pt-14 pb-4" aria-labelledby="how-kept" data-reveal>
    <p class="eyebrow text-brand">How this list is kept</p>
    <h2 id="how-kept" class="mt-1 text-title font-bold tracking-[-0.015em]">
      Nothing here is copied and forgotten.
    </h2>
    <div class="mt-5 grid grid-cols-1 gap-4 md:grid-cols-3">
      {
        [
          {
            icon: "shield" as const,
            text: "Every listing links to the organiser's own page, and we re-check it on a schedule. Each one says when it was last checked.",
          },
          {
            icon: "check" as const,
            text: "Eligibility rules are quoted from the organiser's words. Where the wording is unclear, we say unclear rather than guessing.",
          },
          { icon: "alert" as const, text: NO_FEE_STATEMENT },
        ].map((item) => (
          <div class="rounded-sheet border border-line bg-surface p-5">
            <span class="flex size-9 items-center justify-center rounded-monogram bg-brand-wash text-brand">
              <Icon name={item.icon} size={20} />
            </span>
            <p class="mt-3 text-dense text-ink-2">{item.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  {/* §2 item 6: counts that are true. Both come from live queries, and each disappears
      rather than showing a zero or a guess. */}
  {
    (published !== null || lastVerifiedAt !== null) && (
      <p class="mx-auto max-w-[1160px] px-4 pt-4 text-meta text-ink-3">
        {published !== null && published > 0 && (
          <span>
            {published} {published === 1 ? "opportunity" : "opportunities"} published.{" "}
          </span>
        )}
        {lastVerifiedAt !== null && <span>{freshnessLabel(lastVerifiedAt)} against the source.</span>}
      </p>
    )
  }
</Base>
