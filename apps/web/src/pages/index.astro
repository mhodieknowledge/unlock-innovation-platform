---
// The board. UX_FLOWS.md §2.
//
// "The most characteristic thing in this product's world is a live list of things about to
// close." This page is that list, arranged so it reads as a home screen rather than a feed.
//
// THE SHAPE IS A RHYTHM: rail, band, rail, band. A horizontal rail of listings, then a
// full-bleed category band with a photograph, then that category's own rail, then the next
// band. Three rails and two bands put roughly twenty real opportunities on the page and keep
// it feeling composed — which a single long vertical list does not, however good the cards
// are. A page where every section is the same shape reads as a search result; a page that
// changes shape between sections reads as somewhere that was designed.
//
// WHAT CHANGED TWICE, AND WHY THE SECOND CHANGE IS NOT THE FIRST ONE UNDONE. The version
// before last put the board in a CAROUSEL — a slide deck, one card filling the width, seven
// off-screen with nothing to say they existed, reached through JavaScript and 8×8px dots.
// Measured on an iPhone 13 that was one visible listing, 1.67 viewports down the page. So the
// deck went, and with it went the horizontal arrangement and the photography — and that was an
// overcorrection, because the deck was the defect, not the direction.
//
// A RAIL IS NOT A DECK. Its cards are ~78vw, so the next one is always cut off at the edge,
// and a cut-off card is the only affordance a horizontal list needs. It is native overflow
// scrolling: no script, a touch drag, a trackpad swipe, arrow keys once focused, and a
// `tabindex` so a keyboard can reach it at all (the thing the deck's dots were pretending to
// do). Nothing is hidden from a crawler or from a reader without JavaScript — every card is in
// the HTML either way.
//
// Photography comes back with it, and stays honest: category-level and generic, never attached
// to a specific listing. A photograph of one real opportunity is a claim we cannot check.
//
// CONTENT_AND_LAUNCH.md §1: every number here is true and computed live, and disappears when
// it comes back empty rather than being padded to look like a launch.

import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import Icon from "../components/Icon.astro";
import OpportunityRow from "../components/OpportunityRow.astro";
import heroImage from "../assets/marketing/hero-collab.jpg";
import catHackathon from "../assets/marketing/cat-hackathon.jpg";
import catScholarship from "../assets/marketing/cat-scholarship.jpg";
import catGrant from "../assets/marketing/cat-grant.jpg";
import catInternship from "../assets/marketing/cat-internship.jpg";
import {
  getCategoryCounts,
  getCountry,
  getEntryPoints,
  getLastVerifiedAt,
  getPublishedCount,
  listOpportunities,
} from "../lib/db";
import { cachePolicyFor, getResidenceCountry, getSessionUser } from "../lib/auth";
import { freshnessLabel } from "../lib/deadline";
import { resolveLowData } from "../lib/lowdata";
import { itemList, website } from "../lib/seo";
import { BRAND, NO_FEE_STATEMENT } from "@mbele/config";
import { runtimeEnv } from "~/lib/runtime";

/**
 * One representative photograph per category, for the feature bands and the category cards.
 * Never rendered on an individual opportunity, which has no photograph of its own — and could
 * not honestly be given one.
 */
const CATEGORY_IMAGES: Record<string, ImageMetadata> = {
  hackathon: catHackathon,
  scholarship: catScholarship,
  grant: catGrant,
  internship: catInternship,
};

export const prerender = false;

const env = runtimeEnv();

/**
 * §2 item 3 asked for 8 rows "enough to prove the board is alive, above the fold". Eight was
 * the right number for a carousel showing one of them. It is the wrong number for a feed that
 * a reader scrolls: twelve is roughly three screens of scanning, which is long enough to feel
 * like a catalogue and short enough that "view all" still means something.
 */
const BOARD_SIZE = 12;

const user = await getSessionUser(Astro.cookies, env);

const lowData = resolveLowData({
  cookies: Astro.cookies,
  request: Astro.request,
  accountPreference: user?.low_data_mode ?? null,
}).on;

/**
 * Which country the board is for, in priority order: the URL, then the signed-in profile,
 * then the edge's coarse country hint.
 *
 * `?country=all` is the "not your country?" escape hatch and means *show everything* — a
 * distinct value is needed because an empty parameter would simply fall through to the
 * profile and the hint again, and the control would look broken.
 *
 * ANALYTICS.md §3 allows a country "from profile or coarse edge geolocation"; the hint is
 * read from the request header, used for this render, and stored nowhere. The same section
 * forbids capturing IP addresses at all, and this code never sees one.
 */
const requested = (Astro.url.searchParams.get("country") ?? "").trim().toUpperCase();
const showAll = requested === "ALL";
const hint = (Astro.request.headers.get("cf-ipcountry") ?? "").trim().toUpperCase();

const resolved = showAll
  ? { iso2: null as string | null, source: "explicit" as const }
  : /^[A-Z]{2}$/.test(requested)
    ? { iso2: requested, source: "url" as const }
    : await (async () => {
        const profile = user ? await getResidenceCountry(Astro.cookies, env) : null;
        if (profile) return { iso2: profile, source: "profile" as const };
        // XX and T1 are Cloudflare's "unknown" and "Tor" answers, not countries.
        if (/^[A-Z]{2}$/.test(hint) && hint !== "XX" && hint !== "T1") {
          return { iso2: hint, source: "hint" as const };
        }
        return { iso2: null as string | null, source: "none" as const };
      })();

const country = resolved.iso2 ? await getCountry(resolved.iso2, env) : null;

// An unknown code is not a country. Falling back to the whole board is better than an
// "Open to ZZ" strip, and better than an error for something the reader did not do wrong.
const countryIso2 = country?.iso2 ?? undefined;

const [board, entryPoints, published, lastVerifiedAt, categoryCounts] = await Promise.all([
  listOpportunities({ limit: BOARD_SIZE, countryIso2 }, env),
  getEntryPoints(env),
  getPublishedCount(env),
  getLastVerifiedAt(env),
  getCategoryCounts(env),
]);

const rows = board.ok ? board.data : [];
const degraded = !board.ok;

/**
 * The two category bands, and the rails beneath them.
 *
 * Ordered by what is actually open, so the page reflects the catalogue rather than a
 * hard-coded pair of favourites. `other` is excluded: it is where a listing goes when the
 * taxonomy has no word for it, so as a destination it promises nothing.
 *
 * A PHOTOGRAPH IS NOT A REQUIREMENT, and making it one was a mistake worth recording. We hold
 * four photographs; of those categories only hackathons clears the floor (grants 3,
 * internships 3, scholarships 4), while AI challenges with forty-eight and fellowships with
 * nine have none. Requiring a photograph therefore meant either one band and no rhythm, or a
 * band spent on the fourth-largest category — both decided by what is in assets/marketing
 * rather than by what the catalogue holds. A band without a photograph is a colour band with
 * the same proportions, which is a deliberate variant rather than an absence.
 */
/**
 * A band needs enough listings to fill the rail underneath it.
 *
 * `open_count > 0` was the first rule and the live page showed what it buys: scholarships, with
 * FOUR open, took a full-width photographic band and a rail of two, while AI challenges with
 * forty-eight sat in a small card below — because scholarships had a photograph and AI
 * challenges did not. A band is the loudest thing on the page after the hero; spending it on
 * the fourth-largest category because of what is in the assets folder is letting the assets
 * folder edit the page.
 *
 * Six is the floor: enough that the rail is a rail rather than a pair. A category with fewer
 * is not hidden — it is in the card grid below with its true count, which is the honest place
 * for it.
 */
const BAND_FLOOR = 6;

const FEATURE_BANDS = categoryCounts
  .filter((c) => c.open_count >= BAND_FLOOR && c.code !== "other")
  .sort((a, b) => b.open_count - a.open_count)
  .slice(0, 2);

/**
 * THE BANDS ARE NOT COUNTRY-FILTERED, AND THE FIRST RAIL IS. That is a deliberate division,
 * and getting it wrong was visible on the live page: a band headed "79 open now" — the count
 * comes from `category_open_counts`, which is global — sat above a rail of TWO, because the
 * rail was filtered to the reader's country and the heading was not. A number over a row that
 * contradicts it is worse than no number.
 *
 * So the top rail is the personal one ("open to Zimbabwe and Africa-wide") and the bands are
 * the catalogue: their count, their rail and the category page they link to now all describe
 * the same set. Anyone who wants the personal view of a category has the filter on that page.
 */
const bandResults = await Promise.all(
  FEATURE_BANDS.map((c) => listOpportunities({ categoryCode: c.code, limit: 24 }, env)),
);

/**
 * A band's rail does not repeat what the first rail already showed.
 *
 * The top rail is the soonest twelve overall and a band is the soonest of one category, so
 * the most urgent hackathon is in both by definition. Twice on one screenful reads as a
 * catalogue that has run out of things to show. Fourteen are fetched so that after the
 * overlap is removed there are still eight — a rail of three is a rail that should have been
 * a list.
 */
const shownAlready = new Set(rows.map((r) => r.id));

const bands = FEATURE_BANDS.map((category, i) => ({
  category,
  image: CATEGORY_IMAGES[category.code],
  rows: (bandResults[i]?.ok ? bandResults[i].data : [])
    .filter((o) => !shownAlready.has(o.id))
    .slice(0, 8),
})).filter((band) => band.rows.length > 0);

/** Every category shown in a band, so the card grid below does not repeat them. */
const BANDED = new Set(bands.map((b) => b.category.code));

/**
 * The rest of the directory, as cards. The four we hold photographs for lead with one; the
 * others are typographic, which is the honest treatment for a card with no picture rather
 * than a grey box standing in for one.
 */
const CATEGORY_CARDS = categoryCounts
  .filter((c) => c.open_count > 0 && c.code !== "other" && !BANDED.has(c.code))
  .sort((a, b) => b.open_count - a.open_count)
  .slice(0, 6)
  .map((c) => ({ ...c, image: CATEGORY_IMAGES[c.code] ?? null }));

/**
 * The hero's rotating stat — real counts, not marketing copy. Padded to exactly four slots
 * (repeating if the catalogue has fewer than four categories open) because the CSS keyframe
 * that drives it is a fixed four-step cycle (tokens.css `word-cycle-4`) — a per-request
 * inline <style> to match an arbitrary count is not possible under this CSP (style-src
 * 'self', no unsafe-inline).
 */
const CYCLE_SLOTS = 4;
const withOpenCounts = categoryCounts
  .filter((c) => c.open_count > 0)
  .sort((a, b) => b.open_count - a.open_count);
const cycleCategories =
  withOpenCounts.length > 0
    ? Array.from({ length: CYCLE_SLOTS }, (_, i) => withOpenCounts[i % withOpenCounts.length])
    : [];

/**
 * "48 ai challenge open now" is what the hero said on the live site, and "All 48 ai challenges"
 * is what a band's link said after I fixed the hero — the same mistake, written out a second
 * time twenty lines apart. Both call this now, which is the only reason the second one cannot
 * drift from the first again.
 *
 * Two bugs in one interpolation: the count was never pluralised, and `.toLowerCase()` was
 * applied to a name that can begin with an acronym. Category names are seeded in sentence case
 * ("Hackathon", "AI challenge", "Conference call for papers"), so the rules are: add an `s`
 * unless the name already ends in one, and lower the first letter unless the first two are
 * both capitals — which is what tells an acronym from a capitalised word without a dictionary.
 */
const categoryPhrase = (name: string): string => {
  const plural = name.endsWith("s") ? name : `${name}s`;
  const acronym = /^[A-Z]{2}/.test(plural);
  return acronym ? plural : plural.charAt(0).toLowerCase() + plural.slice(1);
};

/** "20 Sept" — the fact that makes a category worth opening today rather than a name. */
const shortDate = (iso: string | null): string | null => {
  if (!iso) return null;
  const at = new Date(iso);
  if (Number.isNaN(at.getTime())) return null;
  return new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", timeZone: "UTC" }).format(at);
};

/**
 * Who may cache this, and for how long.
 *
 * The board is identical for everyone EXCEPT when it was shaped by something only this
 * request carries — a session or the edge country hint. Both produce a page at the URL `/`
 * that is not `/` for the next reader, so those responses are private. A country in the URL
 * is part of the cache key and shares safely, which is also why the "not your country?"
 * control navigates rather than setting a preference.
 */
cachePolicyFor(
  Astro.response,
  user,
  degraded ? "public, s-maxage=30" : "public, s-maxage=300, stale-while-revalidate=600",
  resolved.source === "profile" || resolved.source === "hint",
);
// Declared on every response, not only the private ones: even a shareable board depends on
// these two headers for its WEIGHT (low-data mode), and the honest declaration is the same
// either way. See the note on the detail page about what Cloudflare does with `Vary`.
Astro.response.headers.append("vary", "Save-Data, Cookie");

/**
 * §2's offline state: "cached board with 'Last updated' line". The line is rendered on every
 * response, because the service worker serves this HTML back unchanged — a timestamp written
 * at render time is the only one that is still true when the page comes out of a cache.
 */
const builtAt = new Intl.DateTimeFormat("en-GB", {
  dateStyle: "medium",
  timeStyle: "short",
  timeZone: "UTC",
}).format(new Date());

/**
 * SEO.md §3: "`WebSite` with `SearchAction` on the homepage." That is the markup that lets a
 * search engine offer a search box for this site directly in its results, and it is the only
 * structured data on this page that is about the site rather than about a list.
 *
 * The board itself is an ItemList — but only when there is a board. Marking up an empty list
 * would be a claim that there is nothing here, made in a machine-readable way.
 */
const jsonLd = [
  website(Astro.url),
  ...(rows.length > 0
    ? [
        itemList(
          "Closing soonest",
          rows.map((row) => ({ name: row.title, path: `/opportunities/${row.slug}` })),
          Astro.url,
        ),
      ]
    : []),
];

/** The stats band. Three numbers, all live, none rounded up with a "+" — CONTENT_AND_LAUNCH.md
 * §1 and apps/web/test/home-route.test.ts both rule out the marketing-rounding pattern. */
const STATS = [
  { value: published ?? 0, label: (published ?? 0) === 1 ? "opportunity tracked" : "opportunities tracked" },
  { value: entryPoints.countries.length, label: "African countries covered" },
  { value: entryPoints.categories.length, label: "categories tracked" },
].filter((s) => s.value > 0);
---

<Base
  title={BRAND.name}
  description="Find opportunities open to your country, and know whether you can apply before you spend the data finding out."
  user={user}
  lowData={lowData}
  offlineCapable
  flush
  canonical="/"
  jsonLd={jsonLd}
  feed={{ path: "/feeds/closing-soon.xml", title: "Closing this week" }}
>
  {/* ── HERO — a band, not a screen. ───────────────────────────────────────────
      The old hero was 621px on a 664px phone: a full-height photograph carrying a
      three-line headline, a five-line paragraph and a search field, with the first
      opportunity another 488px below it. It established the product and then kept
      establishing it.

      This one does the same job in roughly half the height. The photograph stays — it is
      the only place on the page where this reads as somewhere made for someone rather
      than a database — but it is a band behind the words instead of a screen of its own,
      the headline sits at a size a phone can hold in two lines, and the paragraph is one
      sentence rather than five lines of the same sentence. What was cut: the "checked
      against real sources" line, because the trust module below states it properly and a
      promise made twice is not made twice as strongly.

      In low-data mode there is no photograph at all — a plain, fast, text hero, never a
      slow image pretending to be a fast one. */}
  {
    lowData ? (
      <section class="border-b border-line bg-surface">
        <div class="mx-auto max-w-[1160px] px-4 pt-8 pb-7 lg:pt-12 lg:pb-10">
          <h1 class="max-w-[18ch] text-balance text-[1.875rem] leading-[1.12] font-bold tracking-[-0.02em] lg:text-[2.75rem]">
            Opportunities worth your time.
          </h1>
          <p class="prose-measure mt-2 text-[15px] leading-6 text-ink-2">
            Scholarships, fellowships, hackathons and grants open to Africa, each checked
            against its source.
          </p>
          <form method="get" action="/opportunities" class="mt-5 flex max-w-xl gap-2">
            <label class="relative flex-1">
              <span class="sr-only">Search opportunities</span>
              <input
                type="search"
                name="q"
                placeholder="Search scholarships, hackathons, grants…"
                class="h-12 w-full rounded-sheet border border-line-strong bg-surface px-4 text-[15px]"
              />
            </label>
            <button
              type="submit"
              class="h-12 shrink-0 rounded-sheet bg-brand px-5 text-dense font-semibold text-surface hover:bg-brand-ink"
            >
              Search
            </button>
          </form>
        </div>
      </section>
    ) : (
      <section class="relative isolate overflow-hidden border-b border-line">
        <Image
          src={heroImage}
          alt=""
          aria-hidden="true"
          widths={[480, 800, 1200, 1920]}
          sizes="100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-kenburns absolute inset-0 -z-10 h-full w-full object-cover"
        />
        <div class="absolute inset-0 -z-10 bg-gradient-to-t from-black/90 via-black/65 to-black/35" />

        <div class="relative mx-auto max-w-[1160px] px-4 pt-7 pb-7 lg:pt-14 lg:pb-12">
          {
            cycleCategories.length === CYCLE_SLOTS && (
              <p class="inline-flex w-fit items-center gap-2 rounded-monogram border border-white/25 bg-white/10 px-3 py-1 text-micro font-semibold text-white backdrop-blur-sm">
                <span class="relative flex size-2 shrink-0">
                  <span class="absolute inline-flex h-full w-full animate-ping rounded-monogram bg-eligible opacity-75" />
                  <span class="relative inline-flex size-2 rounded-monogram bg-eligible" />
                </span>
                <span class="word-cycle">
                  <span class="word-cycle-track">
                    {cycleCategories.map((c) => (
                      <span>
                        {c.open_count} {categoryPhrase(c.name)} open now
                      </span>
                    ))}
                  </span>
                </span>
              </p>
            )
          }

          <h1
            class="mt-3 max-w-[15ch] text-balance text-[2rem] leading-[1.08] font-bold tracking-[-0.025em] text-white lg:text-[3.25rem]"
          >
            Opportunities worth your time.
          </h1>
          <p class="prose-measure mt-2 text-[15px] leading-6 text-white/80 lg:text-[17px]">
            Scholarships, fellowships, hackathons and grants open to Africa, each checked
            against its source.
          </p>

          {/* A plain GET form to the list page: no JS, no autocomplete request, nothing
              typed leaves the device until the reader presses the button. */}
          <form method="get" action="/opportunities" class="mt-5 flex max-w-xl gap-2">
            <label class="relative flex-1">
              <span class="sr-only">Search opportunities</span>
              <Icon
                name="search"
                size={20}
                class="pointer-events-none absolute top-1/2 left-4 h-[18px] w-[18px] -translate-y-1/2 text-ink-3"
              />
              <input
                type="search"
                name="q"
                placeholder="Search scholarships, hackathons, grants…"
                class="h-12 w-full rounded-sheet border-0 bg-surface pr-3 pl-11 text-[15px] shadow-[0_8px_30px_rgba(0,0,0,0.25)]"
              />
            </label>
            <button
              type="submit"
              class="h-12 shrink-0 rounded-sheet bg-brand px-5 text-dense font-semibold text-surface transition-colors hover:bg-brand-ink"
            >
              Search
            </button>
          </form>
        </div>
      </section>
    )
  }

  {/* ── CONTEXT LINE — where the board is pointed, in one line. ────────────────
      This was a 201px block: an icon in a 40px circle, a bold sentence, a second
      explanatory sentence, and a full-width "Change location" button, for a fact that is
      four words long. It is now a line of text with the control inline, because the fact
      is small and the thing underneath it is the product. */}
  {
    country && (
      <div class="border-b border-line bg-sunken">
        {/*
          ONE ROW, 44px TALL, INCLUDING THE CONTROL.

          The first attempt put `min-h-11` on the link inside a wrapping flex row, which is
          how a one-line fact became an 83px two-line block on a 390px screen: the link
          claimed its 44px and then wrapped below the sentence. The row itself is the 44px
          now — DESIGN_SYSTEM.md §329's rule is about the TARGET, and a link that fills the
          row's height with negative margin is a 44px target inside a 44px strip.
        */}
        <p class="mx-auto flex max-w-[1160px] items-center gap-2 px-4 text-meta text-ink-2">
          <Icon name="globe" size={20} class="h-4 w-4 shrink-0 text-ink-3" />
          <span class="min-w-0 truncate">
            Open to <strong class="font-semibold text-ink">{country.name}</strong> and Africa-wide
          </span>
          <a
            href="/?country=all"
            class="ml-auto inline-flex min-h-11 shrink-0 items-center font-semibold text-brand no-underline hover:underline"
          >
            Show all
          </a>
        </p>
      </div>
    )
  }

  {
    showAll && (
      <div class="border-b border-line bg-sunken">
        <p class="mx-auto flex max-w-[1160px] items-center gap-2 px-4 text-meta text-ink-2">
          <Icon name="globe" size={20} class="h-4 w-4 shrink-0 text-ink-3" />
          <span class="min-w-0 truncate">Every open opportunity across Africa</span>
          <a
            href="/"
            class="ml-auto inline-flex min-h-11 shrink-0 items-center font-semibold text-brand no-underline hover:underline"
          >
            Use my location
          </a>
        </p>
      </div>
    )
  }

  {/* ── RAIL ONE — what is closing, as a rail. ────────────────────────────────
      Twelve cards, the next always cut off at the right edge. The cut is the affordance:
      it says there is more without a control to say it, which is what the old deck's
      8×8px dots were for. Native overflow scrolling, so it needs no script — and
      `tabindex` makes the region reachable by keyboard, which a scrollable area is not by
      default (axe calls this scrollable-region-focusable, and the deck failed it too). ── */}
  <section class="mx-auto max-w-[1160px] px-4 pt-6" aria-labelledby="board">
    <div class="flex flex-wrap items-center justify-between gap-x-4">
      <h2 id="board" class="text-title font-bold tracking-[-0.015em]">Closing soonest</h2>
      {
        rows.length > 0 && (
          <a
            href="/opportunities"
            class="inline-flex min-h-11 items-center text-meta font-semibold text-brand no-underline hover:underline"
          >
            View all{published !== null && published > 0 ? ` ${published}` : ""} →
          </a>
        )
      }
    </div>
    <p class="text-meta text-ink-2">
      Board as of {builtAt} UTC{country ? ` · open to ${country.name}` : ""}
    </p>

    {
      rows.length > 0 ? (
        /* `tabindex` and a label, but NOT `role="group"`: that replaces the <ul>'s implicit
           list role and orphans every <li> inside it, which is what axe caught on the first
           run of this. A labelled, focusable list is already the right thing. */
        <ul
          class="rail mt-3 -mx-4 list-none px-4"
          tabindex="0"
          aria-label="Opportunities closing soonest"
        >
          {rows.map((o) => (
            <li>
              <OpportunityRow opportunity={o} lowData={lowData} />
            </li>
          ))}
        </ul>
      ) : (
        /* One sentence naming the situation, one action (DESIGN_SYSTEM.md §6.4).
           Never an illustration, never "Nothing here yet!". */
        <div class="mt-3 rounded-sheet border border-line bg-surface p-5">
          {degraded ? (
            <>
              <p class="font-semibold">We can't load the board right now.</p>
              <p class="mt-1 text-dense text-ink-2">
                Nothing is wrong with your connection as far as we can tell. Try again
                shortly, or search directly.
              </p>
              <p class="mt-2 text-dense">
                <a
                  href="/opportunities"
                  class="inline-flex min-h-11 items-center font-semibold text-brand"
                >
                  Search opportunities
                </a>
              </p>
            </>
          ) : country ? (
            <>
              <p class="font-semibold">Nothing open to {country.name} is closing yet.</p>
              <p class="mt-1 text-dense text-ink-2">
                That is the catalogue being honest, not a filter being clever.
              </p>
              <p class="mt-2 text-dense">
                <a
                  href="/?country=all"
                  class="inline-flex min-h-11 items-center font-semibold text-brand"
                >
                  Show everything
                </a>
              </p>
            </>
          ) : (
            <>
              <p class="font-semibold">Nothing is published yet.</p>
              <p class="mt-1 text-dense text-ink-2">
                The catalogue is still being built. We would rather show you an empty board
                than pad it with listings we cannot stand behind.
              </p>
            </>
          )}
        </div>
      )
    }
  </section>

  {/* ── BAND + RAIL, TWICE — the rhythm. ──────────────────────────────────────
      A full-bleed photograph with the category's name and its live count set over it, then
      that category's own listings as a rail beneath. The band is the beat between two
      rails: it changes the page's shape, which is what stops a home screen reading as a
      search result, and it carries a real number rather than a slogan.

      The photograph is generic and category-level by necessity — a photograph attached to a
      specific listing would be a claim we cannot check — so it is doing a compositional job
      and is marked `aria-hidden`, because it says nothing a screen reader needs.

      Bands alternate their overlay side on desktop so two in a row do not read as a
      repeated template. On a phone there is only one side, so they simply differ in the
      photograph. ────────────────────────────────────────────────────────────────────── */}
  {
    bands.map((band, i) => (
      <section class="pt-12" aria-labelledby={`band-${band.category.code}`}>
        <div class="relative isolate overflow-hidden">
          {band.image && !lowData ? (
            <>
              <Image
                src={band.image}
                alt=""
                aria-hidden="true"
                widths={[480, 800, 1200, 1600]}
                sizes="100vw"
                loading="lazy"
                class="absolute inset-0 -z-10 h-full w-full object-cover"
              />
              <div
                class={`absolute inset-0 -z-10 bg-gradient-to-t from-black/90 via-black/60 to-black/30 ${
                  i % 2 === 1 ? "lg:bg-gradient-to-l" : "lg:bg-gradient-to-r"
                }`}
              />
            </>
          ) : (
            /* The same band, in ink instead of a photograph. Same proportions, same type, so
               the rhythm does not stutter where the assets folder happens to stop. */
            <div class="absolute inset-0 -z-10 bg-gradient-to-br from-brand-ink to-ink" />
          )}
          <div
            class={`mx-auto flex max-w-[1160px] flex-col justify-end px-4 pt-24 pb-6 lg:pt-32 lg:pb-10 ${
              i % 2 === 1 ? "lg:items-end lg:text-right" : ""
            }`}
          >
            <p class="eyebrow text-white/70">{band.category.open_count} open now</p>
            <h2
              id={`band-${band.category.code}`}
              class="mt-1 text-title font-bold tracking-[-0.02em] text-white lg:text-display"
            >
              {band.category.name}s
            </h2>
          </div>
        </div>

        <div class="mx-auto max-w-[1160px] px-4 pt-4">
          <ul
            class="rail -mx-4 list-none px-4"
            tabindex="0"
            aria-label={`${band.category.name}s closing soonest`}
          >
            {band.rows.map((o) => (
              <li>
                <OpportunityRow opportunity={o} lowData={lowData} />
              </li>
            ))}
          </ul>
          <a
            href={`/categories/${band.category.slug}`}
            class="mt-4 inline-flex min-h-12 items-center rounded-row border border-line-strong bg-surface px-5 text-dense font-semibold text-ink no-underline hover:bg-sunken"
          >
            All {band.category.open_count} {categoryPhrase(band.category.name)} →
          </a>
        </div>
      </section>
    ))
  }

  {/* ── CATEGORY CARDS — the rest of the directory, with a picture where we have one.
      Name, live count and the next deadline, which is the fact that decides whether a
      category is worth opening today. A card with no photograph is typographic rather than
      given a grey box: the absence of a picture is not something to paper over. ───────── */}
  {
    CATEGORY_CARDS.length > 0 && (
      <section class="mx-auto max-w-[1160px] px-4 pt-12" aria-labelledby="by-category">
        <div class="flex flex-wrap items-center justify-between gap-x-4">
          <h2 id="by-category" class="text-title font-bold tracking-[-0.015em]">
            Browse by kind
          </h2>
          <a
            href="/categories"
            class="inline-flex min-h-11 items-center text-meta font-semibold text-brand no-underline hover:underline"
          >
            All categories →
          </a>
        </div>

        <ul class="mt-3 grid list-none grid-cols-2 gap-3 p-0 lg:grid-cols-3">
          {CATEGORY_CARDS.map((c) => (
            <li>
              {/*
                ONE SHAPE, PHOTOGRAPH OR NOT.

                We hold four category photographs and there are twenty-one categories, two of
                which the bands above have already taken. So most cards have no picture, and
                the first version rendered those as a shorter white box with the text floating
                in the middle of it — beside a full-bleed photo card, it read as a component
                that had failed to load rather than a deliberate variant.

                Every card is now the same object: same height, same text in the same place at
                the bottom. A card with a photograph gets the photograph; a card without gets a
                wash in the brand tint. Neither pretends to be the other, and a reader scanning
                the grid is reading a directory rather than wondering what is missing.
              */}
              <a
                href={`/categories/${c.slug}`}
                class="group relative flex h-full min-h-[128px] flex-col justify-end overflow-hidden rounded-sheet border border-line no-underline hover:border-line-strong"
              >
                {c.image && !lowData ? (
                  <>
                    <Image
                      src={c.image}
                      alt=""
                      aria-hidden="true"
                      widths={[240, 400, 600]}
                      sizes="(min-width: 1024px) 360px, 50vw"
                      loading="lazy"
                      class="absolute inset-0 h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
                    />
                    <div class="absolute inset-0 bg-gradient-to-t from-black/85 via-black/50 to-black/20" />
                  </>
                ) : (
                  <div class="absolute inset-0 bg-gradient-to-br from-brand-wash to-sunken" />
                )}
                <div class="relative p-3">
                  <span
                    class={`block text-dense font-semibold ${c.image && !lowData ? "text-surface" : "text-ink"}`}
                  >
                    {c.name}
                  </span>
                  <span
                    class={`mt-1 block text-micro ${c.image && !lowData ? "text-surface/80" : "text-ink-2"}`}
                  >
                    {c.open_count} open
                    {shortDate(c.soonest_deadline) && <span> · next {shortDate(c.soonest_deadline)}</span>}
                  </span>
                </div>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {/* ── ELIGIBILITY — one row, not a card with an eyebrow and a paragraph. ───── */}
  <section class="mx-auto max-w-[1160px] px-4 pt-10" aria-labelledby="can-i-apply">
    <div class="flex flex-col gap-3 rounded-sheet border border-line bg-surface p-4 sm:flex-row sm:items-center sm:justify-between">
      <div>
        <h2 id="can-i-apply" class="text-dense font-semibold">
          Every listing can tell you whether you can apply.
        </h2>
        <p class="mt-1 text-meta text-ink-2">
          Save where you live and what you study. Where the wording is unclear, we say
          unclear rather than guessing.
        </p>
      </div>
      <a
        href="/you/eligibility"
        class="inline-flex min-h-12 shrink-0 items-center justify-center rounded-row bg-brand px-5 text-dense font-semibold text-surface no-underline transition-colors hover:bg-brand-ink"
      >
        {user ? "Your details" : "Add your details"}
      </a>
    </div>
  </section>

  {/* ── COUNTRIES — the heading says what it is; the chips are the content. ──── */}
  {
    entryPoints.countries.length > 0 && (
      <section class="mx-auto max-w-[1160px] px-4 pt-10" aria-labelledby="by-country">
        <div class="flex flex-wrap items-center justify-between gap-x-4">
          <h2 id="by-country" class="text-subtitle font-bold tracking-[-0.015em]">
            Browse by country
          </h2>
          {/* No "all countries →" link beside this heading: the <details> below is already a
              44px control that says the same thing, and two controls for one destination is
              the repetition this pass exists to remove. */}
        </div>

        {/* A `<details>` rather than a "show more" button: it needs no script, and the
            CSP carries no 'unsafe-inline'. The chips ARE the plain links in the HTML for
            a crawler and for a reader with no JavaScript. */}
        <details class="group mt-3">
          <summary class="inline-flex min-h-11 cursor-pointer list-none items-center gap-2 text-dense font-semibold text-brand [&::-webkit-details-marker]:hidden">
            Show all {entryPoints.countries.length} countries
            <Icon name="chevron" size={20} class="h-4 w-4 rotate-90 group-open:-rotate-90" />
          </summary>
          <ul class="mt-2 flex list-none flex-wrap gap-2 p-0">
            {entryPoints.countries.map((c) => (
              <li>
                <a
                  href={`/countries/${c.slug}`}
                  class="inline-flex min-h-11 items-center rounded-monogram border border-line px-4 text-meta font-medium text-ink-2 no-underline hover:border-line-strong hover:bg-sunken hover:text-ink"
                >
                  {c.name}
                </a>
              </li>
            ))}
          </ul>
        </details>
      </section>
    )
  }

  {/* ── TRUST — four promises, one block. ─────────────────────────────────────
      This was 652px: an eyebrow, a display heading, and three bordered cards each with an
      icon in a circle and a sentence of prose. The promises themselves are short, and
      they are stronger stated plainly together than spaced out across three cards that
      look like features.

      MODERATION_AND_TRUST.md §2.1 rule 3's no-fee line is the last of them and is stated
      here rather than in the footer, so it sits with the promises it belongs with. Base
      passes `trustPanelAbove` to the footer so it is not repeated below. */}
  <section class="mx-auto max-w-[1160px] px-4 pt-10" aria-labelledby="how-kept">
    <div class="rounded-sheet border border-line bg-surface p-4">
      <div class="flex flex-wrap items-center justify-between gap-x-4">
        <h2 id="how-kept" class="text-dense font-semibold">How this list is kept</h2>
        <a
          href="/verification"
          class="inline-flex min-h-11 items-center text-meta font-semibold text-brand no-underline hover:underline"
        >
          What verification means →
        </a>
      </div>
      <ul class="mt-2 flex list-none flex-col gap-1.5 p-0 text-meta text-ink-2">
        {
          [
            "Every listing links to the organiser's own page, and says when we last checked it.",
            "Eligibility rules are quoted from the organiser's words, never paraphrased.",
            "Where the wording is unclear, we say unclear rather than guessing.",
            NO_FEE_STATEMENT,
          ].map((promise) => (
            <li class="flex gap-2">
              <Icon name="check" size={20} class="mt-[2px] h-3.5 w-3.5 shrink-0 text-eligible" />
              <span>{promise}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  {/* ── NUMBERS — a band, not a chapter. Three live counts with no "+" rounding
      (CONTENT_AND_LAUNCH.md §1), plus §2 item 6's freshness line, which belongs with them
      because it is the number that says the others are current. ─────────────────────── */}
  {
    STATS.length > 0 && (
      <section class="mt-10 bg-ink py-6 text-surface" aria-labelledby="stats">
        <h2 id="stats" class="sr-only">{BRAND.name} by the numbers</h2>
        <div class="mx-auto flex max-w-[1160px] flex-wrap items-baseline gap-x-8 gap-y-3 px-4">
          {STATS.map((stat) => (
            <p class="flex items-baseline gap-2">
              <span class="text-[1.5rem] font-bold tracking-[-0.02em] tabular-nums">
                <span data-count-to={stat.value}>{stat.value.toLocaleString("en")}</span>
              </span>
              <span class="text-meta text-surface/70">{stat.label}</span>
            </p>
          ))}
          {lastVerifiedAt !== null && (
            <p class="text-meta text-surface/70">{freshnessLabel(lastVerifiedAt)} against the source.</p>
          )}
        </div>
      </section>
    )
  }
</Base>
