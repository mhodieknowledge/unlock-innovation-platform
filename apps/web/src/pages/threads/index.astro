---
// Your conversations. COLLABORATION_SYSTEM.md §3.
//
// A list, not an inbox: no unread badge in the header, no count in the title, no
// nagging. PRODUCT_SPEC.md §1.3 rules out engagement bait, and a message list is
// exactly where that temptation lives. The one signal here is whether the other
// person has said anything — which is information you need to decide whether to
// open it, not a number designed to pull you back.

import Base from "../../layouts/Base.astro";
import { createAuthClient, getSessionUser } from "../../lib/auth";
import { reportError } from "../../lib/errors";
import { builderName, getMyThreads, type ThreadRow } from "../../lib/rooms";

export const prerender = false;

const env = (Astro.locals as { runtime?: { env?: Record<string, string> } }).runtime?.env ?? {};
const user = await getSessionUser(Astro.cookies, env);
if (!user) {
  return Astro.redirect(`/signin?returnTo=${encodeURIComponent(Astro.url.pathname)}`, 302);
}

const client = createAuthClient(Astro.cookies, env);
Astro.response.headers.set("cache-control", "private, no-store");

let rows: ThreadRow[] = [];
let failed = false;

if (client) {
  try {
    rows = await getMyThreads(client);
  } catch (err) {
    await reportError(err, { route: "/threads" }, env);
    failed = true;
  }
}

const when = (iso: string) =>
  new Date(iso).toLocaleDateString("en-GB", {
    day: "numeric",
    month: "long",
    timeZone: user.timezone,
  });
---

<Base title="Your conversations" noindex user={user}>
  <h1 class="text-title font-semibold">Your conversations</h1>
  <p class="mt-2 max-w-prose text-dense text-ink-2">
    One conversation per accepted request. There's no way to message anyone who hasn't accepted
    one from you, and no way for anyone to message you first.
  </p>

  {
    failed && (
      <p class="mt-4 max-w-prose border-l-[3px] border-danger bg-noteligible-wash p-3 text-dense">
        We couldn't load these just now. Nothing has been lost — try again in a moment.
      </p>
    )
  }

  {
    !failed && rows.length === 0 && (
      <div class="mt-6 max-w-prose rounded-sheet border border-line bg-surface p-4">
        <p class="text-dense font-semibold">Nothing here yet.</p>
        <p class="mt-1 text-dense text-ink-2">
          A conversation opens when someone accepts your request, or you accept theirs.
        </p>
        <p class="mt-3"><a href="/requests" class="text-brand">See your requests →</a></p>
      </div>
    )
  }

  {
    rows.length > 0 && (
      <ul class="mt-6 max-w-prose divide-y divide-line border-t border-line">
        {rows.map((t) => (
          <li class="py-4">
            <p class="text-dense font-semibold">
              <a href={`/threads/${t.thread_id}`} class="text-ink">
                {builderName(t.counterpart_display_name)}
              </a>
            </p>
            <p class="text-micro text-ink-2">
              {t.context_label}
              <span aria-hidden="true"> · </span>
              {t.last_message_at ? `last message ${when(t.last_message_at)}` : "nothing said yet"}
              {t.state === "closed"
                ? ` · closed${t.closed_reason ? ` (${t.closed_reason})` : ""}`
                : ""}
            </p>
            {t.unread_from_them && t.state === "open" && (
              <p class="mt-1 text-micro text-brand">They've replied.</p>
            )}
          </li>
        ))}
      </ul>
    )
  }

  <p class="mt-10 max-w-prose text-micro text-ink-2">
    Closed conversations stay readable for 90 days, then the messages are deleted and only the
    fact that you connected remains.
  </p>
</Base>
