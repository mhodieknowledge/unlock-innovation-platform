---
// The shell every public page renders inside.
//
// UX_FLOWS.md §1: no interstitials, no modals on arrival, no cookie banner — no
// non-essential cookies are set, so none is required (PRIVACY_AND_COMPLIANCE.md §1).
// DESIGN_SYSTEM.md §8: semantic landmarks, a skip link, and no content conveyed
// by icon alone.

import "../styles/tokens.css";
import { BRAND } from "@mbele/config";

import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

interface Props {
  title: string;
  description?: string;
  /** SEO.md §1: private surfaces are noindex. Default is indexable. */
  noindex?: boolean;
  canonical?: string;
  /**
   * Server-rendered JSON-LD. SEO.md §3: "Server-rendered JSON-LD on every public page. No
   * client-side injection."
   *
   * An array, because a page carries several graphs — a BreadcrumbList plus the thing the page
   * is about. Each becomes its own `application/ld+json` block, which is what the validators
   * expect and what keeps one malformed graph from taking the others with it.
   *
   * `application/ld+json` is a data block, not a script: the CSP's `script-src 'self'` does not
   * apply to it because the browser never executes it (see apps/web/test/csp.test.ts, which
   * asserts no EXECUTABLE inline script exists).
   */
  jsonLd?: unknown[];
  /** §4's Open Graph type. `article` for a page about one thing, `website` otherwise. */
  ogType?: "website" | "article";
  /**
   * An RSS feed this page has. SEO.md §7 makes feeds a first-class distribution channel, and
   * autodiscovery is how a reader's client finds one without being told it exists.
   */
  feed?: { path: string; title: string };
  /**
   * Passed in by pages that have already loaded a session, so the header can show
   * where to go next.
   *
   * Deliberately a PROP rather than a session read inside this layout: reading the
   * session here would make every page dynamic, including the prerendered ones.
   * A page that does not pass it renders the signed-out header, which is correct
   * for a static page — it cannot know who is reading it.
   */
  user?: { display_name: string | null } | null;
  /** Unread in-app count, when the page already knows it. */
  unread?: number;
  /**
   * DESIGN_SYSTEM.md §10, resolved server-side by the page (lib/lowdata.ts) so the FIRST
   * paint is already light. A mode applied by a script after the page arrives has already
   * cost the reader the bytes it exists to save.
   */
  lowData?: boolean;
  /**
   * PWA. SYSTEM_ARCHITECTURE.md §3.4. Off by default: a service worker registered from a
   * page that does not want one is a background fetch nobody asked for, and the prerendered
   * policy pages have nothing to cache.
   *
   * This means "takes part in the offline story" — registers the worker, links the manifest,
   * and carries the pending-sync and confirmation lines — NOT "is cached". What is cached is
   * decided in public/sw-routes.js, which caches the tracker and no other personal surface.
   */
  offlineCapable?: boolean;
  /**
   * Let the page own its own gutters.
   *
   * The redesigned board is built from full-bleed bands — a masthead on --surface, a
   * country strip on --sunken, the board itself — each with its own background and a
   * hairline running edge to edge. `main`'s own padding would inset every one of them
   * and leave the hairlines floating short of the screen. A page that sets this takes
   * responsibility for its own 16px.
   */
  flush?: boolean;
}

const {
  title,
  description,
  noindex = false,
  canonical,
  jsonLd = [],
  ogType = "website",
  feed,
  user = null,
  unread = 0,
  lowData = false,
  offlineCapable = false,
  flush = false,
} = Astro.props;
const fullTitle = title === BRAND.name ? title : `${title} | ${BRAND.name}`;

/**
 * SEO.md §4: og:title, og:description, og:url, og:type, og:site_name, twitter:card=summary.
 *
 * `summary`, not `summary_large_image`, and one static card site-wide — §4's `[PR]` decision.
 * "The title and description carry the specificity. This trades a marginal click-through gain
 * for a real, repeated bandwidth saving, which is the correct trade for this audience."
 *
 * The URL comes from the request, so a preview deployment does not advertise the production
 * host and a local run does not advertise a domain that does not resolve.
 */
const ogUrl = new URL(canonical ?? Astro.url.pathname, Astro.url).href;
const ogImage = new URL("/og.png", Astro.url).href;
---

<!doctype html>
<!--
  The low-data flag is on the ROOT element, not just passed to components. DESIGN_SYSTEM.md
  §10's last clause — "the webfont is not requested" — is a decision about what the document
  links to, and when the Archivo woff2 is self-hosted the <link> below it will be conditional
  on this attribute. Until then the family falls back through the system stack for everyone,
  so there is nothing to suppress and nothing to pretend about.
-->
<html lang="en" data-low-data={lowData ? "1" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />

    {
      /* §4. Emitted on every page including the noindex ones: a link shared into WhatsApp or
         Telegram renders a preview whether or not Google may index the page, and a private page
         with no preview at all looks broken to the person who shared it. */
      !noindex && (
        <>
          <meta property="og:title" content={fullTitle} />
          {description && <meta property="og:description" content={description} />}
          <meta property="og:url" content={ogUrl} />
          <meta property="og:type" content={ogType} />
          <meta property="og:site_name" content={BRAND.name} />
          <meta property="og:image" content={ogImage} />
          <meta name="twitter:card" content="summary" />
        </>
      )
    }

    {
      feed && (
        <link
          rel="alternate"
          type="application/rss+xml"
          title={feed.title}
          href={feed.path}
        />
      )
    }

    {
      /* SEO.md §3. A data block, never executed — see the note on the `jsonLd` prop. */
      jsonLd.map((graph) => (
        <script type="application/ld+json" set:html={JSON.stringify(graph)} />
      ))
    }
    {
      /* PRODUCT_SPEC.md §25.3: installable. The manifest is 400 bytes and static; the
         service worker is registered only on the pages that benefit (below). */
      offlineCapable && <link rel="manifest" href="/manifest.webmanifest" />
    }
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-row focus:bg-brand focus:px-4 focus:py-2 focus:text-surface"
      >Skip to content</a
    >

    <SiteHeader user={user} unread={unread} pathname={Astro.url.pathname} />

    <main id="main" class={flush ? "" : "mx-auto max-w-[1160px] px-4 py-6"}>
      {
        /* SYSTEM_ARCHITECTURE.md §3.4: "a visible 'pending sync' state". Rendered hidden and
           filled in by the service worker's message; a reader with no service worker never
           sees it, because they have no queue either. */
        offlineCapable && (
          <>
            <p
              data-pending-sync
              hidden
              class={`mb-4 border-l-[3px] border-warning bg-unclear-wash p-3 text-dense ${flush ? "mx-4 mt-4" : ""}`}
            ></p>
            {/* Phase 9's acceptance criterion asks for ONE confirmation when a queued change
                syncs. aria-live so it is announced rather than only seen. */}
            <p
              data-toast
              hidden
              role="status"
              aria-live="polite"
              class={`mb-4 border-l-[3px] border-success bg-eligible-wash p-3 text-dense ${flush ? "mx-4 mt-4" : ""}`}
            ></p>
          </>
        )
      }
      <slot />
    </main>

    <SiteFooter
      lowData={lowData}
      pathname={Astro.url.pathname}
      search={Astro.url.search}
      trustPanelAbove={flush}
    />

    {
      /* Registration is a bundled module, never inline: the CSP in public/_headers carries
         no 'unsafe-inline' (see ADR 0002 and apps/web/test/csp.test.ts). */
      offlineCapable && <script src="/sw-register.js" defer></script>
    }
  </body>
</html>
