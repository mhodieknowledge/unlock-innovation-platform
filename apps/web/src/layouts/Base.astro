---
// The shell every public page renders inside.
//
// UX_FLOWS.md §1: no interstitials, no modals on arrival, no cookie banner — no
// non-essential cookies are set, so none is required (PRIVACY_AND_COMPLIANCE.md §1).
// DESIGN_SYSTEM.md §8: semantic landmarks, a skip link, and no content conveyed
// by icon alone.

import "../styles/tokens.css";
import { BRAND, NO_FEE_STATEMENT } from "@mbele/config";

interface Props {
  title: string;
  description?: string;
  /** SEO.md §1: private surfaces are noindex. Default is indexable. */
  noindex?: boolean;
  canonical?: string;
  /**
   * Passed in by pages that have already loaded a session, so the header can show
   * where to go next.
   *
   * Deliberately a PROP rather than a session read inside this layout: reading the
   * session here would make every page dynamic, including the prerendered ones.
   * A page that does not pass it renders the signed-out header, which is correct
   * for a static page — it cannot know who is reading it.
   */
  user?: { display_name: string | null } | null;
  /** Unread in-app count, when the page already knows it. */
  unread?: number;
}

const { title, description, noindex = false, canonical, user = null, unread = 0 } = Astro.props;
const fullTitle = title === BRAND.name ? title : `${title} | ${BRAND.name}`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-row focus:bg-brand focus:px-4 focus:py-2 focus:text-surface"
      >Skip to content</a
    >

    <header class="border-b border-line bg-surface">
      <div class="mx-auto flex max-w-[1160px] items-center gap-4 px-4 py-3">
        <!-- DESIGN_SYSTEM.md §11: wordmark only. No symbol at launch — it costs
             bytes and design debt and earns nothing until the name is settled. -->
        <a
          href="/"
          class="text-title font-bold tracking-[-0.015em] text-brand no-underline"
          >{BRAND.name}</a
        >

        <nav aria-label="Your pages" class="ml-auto flex flex-wrap items-center gap-x-4 gap-y-1 text-dense">
          {
            user ? (
              <>
                <a href="/tracker" class="text-brand">Tracker</a>
                <!-- Projects are a private tool first (COLLABORATION_SYSTEM.md §1.1), so
                     this link is not behind a density flag the way a social surface is.
                     /projects — the browse surface — is the one that disappears. -->
                <a href="/you/projects" class="text-brand">Projects</a>
                <a href="/you/inbox" class="text-brand">
                  Messages{unread > 0 ? ` (${unread})` : ""}
                </a>
                <a href="/you/eligibility" class="text-brand">Eligibility</a>
                <a href="/you/account" class="text-brand">Account</a>
              </>
            ) : (
              <a href={`/signin?returnTo=${encodeURIComponent(Astro.url.pathname)}`} class="text-brand">
                Sign in
              </a>
            )
          }
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-[1160px] px-4 py-6">
      <slot />
    </main>

    <footer class="mt-12 border-t border-line bg-surface">
      <div
        class="mx-auto max-w-[1160px] space-y-2 px-4 py-6 text-meta leading-[--text-meta--line-height] text-ink-2"
      >
        <!-- MODERATION_AND_TRUST.md §2.1 rule 3: permanent and prominent. -->
        <p class="font-semibold text-ink">{NO_FEE_STATEMENT}</p>
        <nav aria-label="Site information" class="flex flex-wrap gap-x-4 gap-y-1">
          <a href="/submit" class="text-brand">Tell us about an opportunity</a>
          <a href="/anti-scam" class="text-brand">Spotting scams</a>
          <a href="/verification" class="text-brand">What verification means</a>
          <a href="/privacy" class="text-brand">Privacy</a>
          <a href="/terms" class="text-brand">Terms</a>
          <a href="/content-policy" class="text-brand">Content policy</a>
          <a href="/bot" class="text-brand">About our crawler</a>
          <a href="/changelog" class="text-brand">Policy changes</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
