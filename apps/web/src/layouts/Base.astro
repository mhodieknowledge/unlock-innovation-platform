---
// The shell every public page renders inside.
//
// UX_FLOWS.md §1: no interstitials, no modals on arrival, no cookie banner — no
// non-essential cookies are set, so none is required (PRIVACY_AND_COMPLIANCE.md §1).
// DESIGN_SYSTEM.md §8: semantic landmarks, a skip link, and no content conveyed
// by icon alone.

import "../styles/tokens.css";
import { BRAND, NO_FEE_STATEMENT } from "@mbele/config";

interface Props {
  title: string;
  description?: string;
  /** SEO.md §1: private surfaces are noindex. Default is indexable. */
  noindex?: boolean;
  canonical?: string;
  /**
   * Passed in by pages that have already loaded a session, so the header can show
   * where to go next.
   *
   * Deliberately a PROP rather than a session read inside this layout: reading the
   * session here would make every page dynamic, including the prerendered ones.
   * A page that does not pass it renders the signed-out header, which is correct
   * for a static page — it cannot know who is reading it.
   */
  user?: { display_name: string | null } | null;
  /** Unread in-app count, when the page already knows it. */
  unread?: number;
  /**
   * DESIGN_SYSTEM.md §10, resolved server-side by the page (lib/lowdata.ts) so the FIRST
   * paint is already light. A mode applied by a script after the page arrives has already
   * cost the reader the bytes it exists to save.
   */
  lowData?: boolean;
  /**
   * PWA. SYSTEM_ARCHITECTURE.md §3.4. Off by default: a service worker registered from a
   * page that does not want one is a background fetch nobody asked for, and the prerendered
   * policy pages have nothing to cache.
   *
   * This means "takes part in the offline story" — registers the worker, links the manifest,
   * and carries the pending-sync and confirmation lines — NOT "is cached". What is cached is
   * decided in public/sw-routes.js, which caches the tracker and no other personal surface.
   */
  offlineCapable?: boolean;
}

const {
  title,
  description,
  noindex = false,
  canonical,
  user = null,
  unread = 0,
  lowData = false,
  offlineCapable = false,
} = Astro.props;
const fullTitle = title === BRAND.name ? title : `${title} | ${BRAND.name}`;
---

<!doctype html>
<!--
  The low-data flag is on the ROOT element, not just passed to components. DESIGN_SYSTEM.md
  §10's last clause — "the webfont is not requested" — is a decision about what the document
  links to, and when the Archivo woff2 is self-hosted the <link> below it will be conditional
  on this attribute. Until then the family falls back through the system stack for everyone,
  so there is nothing to suppress and nothing to pretend about.
-->
<html lang="en" data-low-data={lowData ? "1" : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="color-scheme" content="light" />
    {
      /* PRODUCT_SPEC.md §25.3: installable. The manifest is 400 bytes and static; the
         service worker is registered only on the pages that benefit (below). */
      offlineCapable && <link rel="manifest" href="/manifest.webmanifest" />
    }
  </head>

  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:absolute focus:left-3 focus:top-3 focus:z-50 focus:rounded-row focus:bg-brand focus:px-4 focus:py-2 focus:text-surface"
      >Skip to content</a
    >

    <header class="border-b border-line bg-surface">
      <div class="mx-auto flex max-w-[1160px] items-center gap-4 px-4 py-3">
        <!-- DESIGN_SYSTEM.md §11: wordmark only. No symbol at launch — it costs
             bytes and design debt and earns nothing until the name is settled. -->
        <a
          href="/"
          class="text-title font-bold tracking-[-0.015em] text-brand no-underline"
          >{BRAND.name}</a
        >

        <nav aria-label="Your pages" class="ml-auto flex flex-wrap items-center gap-x-4 gap-y-1 text-dense">
          {
            user ? (
              <>
                <a href="/tracker" class="text-brand">Tracker</a>
                <!-- Projects are a private tool first (COLLABORATION_SYSTEM.md §1.1), so
                     this link is not behind a density flag the way a social surface is.
                     /projects — the browse surface — is the one that disappears. -->
                <a href="/you/projects" class="text-brand">Projects</a>
                <a href="/you/inbox" class="text-brand">
                  Messages{unread > 0 ? ` (${unread})` : ""}
                </a>
                <a href="/you/eligibility" class="text-brand">Eligibility</a>
                <a href="/you/account" class="text-brand">Account</a>
              </>
            ) : (
              <a href={`/signin?returnTo=${encodeURIComponent(Astro.url.pathname)}`} class="text-brand">
                Sign in
              </a>
            )
          }
        </nav>
      </div>
    </header>

    <main id="main" class="mx-auto max-w-[1160px] px-4 py-6">
      {
        /* SYSTEM_ARCHITECTURE.md §3.4: "a visible 'pending sync' state". Rendered hidden and
           filled in by the service worker's message; a reader with no service worker never
           sees it, because they have no queue either. */
        offlineCapable && (
          <>
            <p
              data-pending-sync
              hidden
              class="mb-4 border-l-[3px] border-warning bg-unclear-wash p-3 text-dense"
            ></p>
            {/* Phase 9's acceptance criterion asks for ONE confirmation when a queued change
                syncs. aria-live so it is announced rather than only seen. */}
            <p
              data-toast
              hidden
              role="status"
              aria-live="polite"
              class="mb-4 border-l-[3px] border-success bg-eligible-wash p-3 text-dense"
            ></p>
          </>
        )
      }
      <slot />
    </main>

    <footer class="mt-12 border-t border-line bg-surface">
      <div
        class="mx-auto max-w-[1160px] space-y-2 px-4 py-6 text-meta leading-[--text-meta--line-height] text-ink-2"
      >
        <!-- MODERATION_AND_TRUST.md §2.1 rule 3: permanent and prominent. -->
        <p class="font-semibold text-ink">{NO_FEE_STATEMENT}</p>
        <nav aria-label="Site information" class="flex flex-wrap gap-x-4 gap-y-1">
          <a href="/submit" class="text-brand">Tell us about an opportunity</a>
          <a href="/anti-scam" class="text-brand">Spotting scams</a>
          <a href="/verification" class="text-brand">What verification means</a>
          <a href="/privacy" class="text-brand">Privacy</a>
          <a href="/terms" class="text-brand">Terms</a>
          <a href="/content-policy" class="text-brand">Content policy</a>
          <a href="/bot" class="text-brand">About our crawler</a>
          <a href="/changelog" class="text-brand">Policy changes</a>
        </nav>

        <!-- §10: "A persistent meta line in the footer: 'Low-data mode is on.' with a
             toggle." A form, not a script: the mode exists for people whose connection
             cannot afford a bundle, and a toggle that needs one would be a joke at their
             expense. -->
        <form method="post" action="/low-data" class="flex flex-wrap items-center gap-2">
          <input type="hidden" name="on" value={lowData ? "0" : "1"} />
          <input type="hidden" name="returnTo" value={Astro.url.pathname + Astro.url.search} />
          <span>
            {lowData
              ? "Low-data mode is on: no images, shorter rows, nothing loaded speculatively."
              : "Paying by the megabyte?"}
          </span>
          <button type="submit" class="min-h-11 text-brand underline">
            {lowData ? "Turn it off" : "Turn on low-data mode"}
          </button>
        </form>
      </div>
    </footer>

    {
      /* Registration is a bundled module, never inline: the CSP in public/_headers carries
         no 'unsafe-inline' (see ADR 0002 and apps/web/test/csp.test.ts). */
      offlineCapable && <script src="/sw-register.js" defer></script>
    }
  </body>
</html>
