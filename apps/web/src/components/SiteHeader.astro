---
// The app bar, from design/Main.body.html and design/Foundations.dc.html.
//
// Three icon targets on a phone — search, account, menu — which is Option B from
// design/NavChoice.dc.html and what the canvas's Main artboard always drew. The operator
// chose it, and §5.7 is amended rather than contradicted: see the note under "Amended
// 2026-09-16" in DESIGN_SYSTEM.md for what the ban was protecting and what replaces it.
//
// ICONS, NOT WORDS, below lg. The labels were `sm:not-sr-only`, and §4.2 puts sm at
// 381px — BELOW a 390px phone — so "Messages" and the account name rendered as text on
// the device the header is tightest on, and the wordmark had to share the bar with them.
// Every label here is now real text that is visually hidden until lg, which keeps §8's
// "no content conveyed by icon alone" true for a screen reader at every width.
//
// §11: wordmark only, Archivo 700, letter-spacing -0.02em, --brand. No symbol.

import { BRAND } from "@mbele/config";

import Icon from "./Icon.astro";
import MenuButton from "./MenuButton.astro";
import PrimaryNav from "./PrimaryNav.astro";

interface Props {
  user?: { display_name: string | null } | null;
  unread?: number;
  pathname: string;
}

const { user = null, unread = 0, pathname } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-line bg-surface/95 backdrop-blur supports-[backdrop-filter]:bg-surface/80">
  <div class="mx-auto flex max-w-[1160px] items-center gap-4 px-4 py-3 lg:gap-8">
    <a
      href="/"
      class="shrink-0 text-[20px] font-bold leading-6 tracking-[-0.02em] text-brand no-underline lg:text-title"
      >{BRAND.name}</a
    >

    <PrimaryNav pathname={pathname} />

    {/* Search is a field at lg and an icon target below it: a permanently expanded
        input would eat a 360px header to save one tap. */}
    <form
      method="get"
      action="/opportunities"
      role="search"
      class="ml-auto hidden lg:flex lg:items-center"
    >
      <label class="contents">
        <span class="sr-only">Search opportunities</span>
        <input
          type="search"
          name="q"
          placeholder="Search opportunities"
          class="h-10 w-64 rounded-row border border-line bg-sunken px-3 text-dense placeholder:text-ink-3 focus:bg-surface"
        />
      </label>
    </form>

    <div class="relative ml-auto flex items-center gap-[2px] lg:ml-0">
      <a
        href="/opportunities"
        class="inline-flex size-11 items-center justify-center rounded-row text-ink no-underline hover:bg-sunken lg:hidden"
      >
        <Icon name="search" size={20} />
        {/* axe does not credit an SVG <title> as a link's accessible name, and neither
            do several screen readers. Real text, visually hidden, is the only form that
            works everywhere — §8 `[PR]`: "no content conveyed by icon alone". */}
        <span class="sr-only">Search opportunities</span>
      </a>

      {
        user ? (
          <a
            href="/you"
            class="inline-flex size-11 items-center justify-center rounded-row text-ink no-underline hover:bg-sunken lg:w-auto lg:gap-2 lg:px-3"
          >
            <Icon name="you" size={20} />
            {/* Real text, visually hidden below lg. An SVG <title> is not credited as an
                accessible name by axe or by several screen readers. The unread count is
                part of the SAME name rather than a bare number beside it, so it is read
                as "Messages, 3 unread" and not as a stray "(3)". */}
            <span class="sr-only text-dense lg:not-sr-only">
              {user.display_name ?? "Your account"}
              {unread > 0 ? `, ${unread} unread` : ""}
            </span>
            {unread > 0 && (
              <span aria-hidden="true" class="absolute mt-[-18px] ml-[18px] size-[7px] rounded-monogram bg-brand" />
            )}
          </a>
        ) : (
          <a
            href={`/signin?returnTo=${encodeURIComponent(pathname)}`}
            class="inline-flex size-11 items-center justify-center rounded-row text-ink no-underline hover:bg-sunken lg:size-auto lg:min-h-11 lg:border lg:border-line-strong lg:bg-surface lg:px-4 lg:text-dense lg:font-semibold"
          >
            <Icon name="you" size={20} class="lg:hidden" />
            <span class="sr-only lg:not-sr-only">Sign in</span>
          </a>
        )
      }

      <MenuButton pathname={pathname} signedIn={user !== null} />
    </div>
  </div>
</header>
