---
// The app bar, from design/Main.body.html and design/Foundations.dc.html.
//
// The canvas draws this with three icon buttons — search, account, menu — because its
// Main artboard assumes Option B from design/NavChoice.dc.html, where the bottom bar is
// replaced by a drawer. This build takes OPTION A, which that artboard describes as
// "what ships today" and "costs nothing to choose": the bar stays, the rest of the
// redesign lands around it.
//
// The reason is written on the artboard itself. DESIGN_SYSTEM.md §5.7 specifies the
// five-item bottom bar AND ends "Never: hamburger menu hiding primary navigation", so
// Option B is an amendment to the specification rather than a change of styling — and
// not one to make on somebody's behalf inside a redesign they asked to be shipped.
//
// So there is no menu button here: with the bar carrying the five destinations, a
// hamburger beside it would be a second navigation holding the same links. What remains
// is the appbar's shape — 44px targets, sticky, one hairline — and its two controls.
//
// §11: wordmark only, Archivo 700, letter-spacing -0.02em, --brand. No symbol.

import { BRAND } from "@mbele/config";

import Icon from "./Icon.astro";
import PrimaryNav from "./PrimaryNav.astro";

interface Props {
  user?: { display_name: string | null } | null;
  unread?: number;
  pathname: string;
}

const { user = null, unread = 0, pathname } = Astro.props;
---

<header class="sticky top-0 z-40 border-b border-line bg-surface">
  <div class="mx-auto flex max-w-[1160px] items-center gap-3 px-4 py-[10px] lg:gap-6">
    <a
      href="/"
      class="shrink-0 text-[20px] font-bold leading-6 tracking-[-0.02em] text-brand no-underline lg:text-title"
      >{BRAND.name}</a
    >

    <PrimaryNav pathname={pathname} />

    {/* Search is a field at lg and an icon target below it: a permanently expanded
        input would eat a 360px header to save one tap. */}
    <form
      method="get"
      action="/opportunities"
      role="search"
      class="ml-auto hidden lg:flex lg:items-center"
    >
      <label class="contents">
        <span class="sr-only">Search opportunities</span>
        <input
          type="search"
          name="q"
          placeholder="Search opportunities"
          class="h-10 w-56 rounded-row border border-line-strong bg-surface px-3 text-dense"
        />
      </label>
    </form>

    <div class="ml-auto flex items-center gap-[2px] lg:ml-0">
      <a
        href="/opportunities"
        class="inline-flex size-11 items-center justify-center rounded-row text-ink no-underline hover:bg-sunken lg:hidden"
      >
        <Icon name="search" size={20} />
        {/* axe does not credit an SVG <title> as a link's accessible name, and neither
            do several screen readers. Real text, visually hidden, is the only form that
            works everywhere — §8 `[PR]`: "no content conveyed by icon alone". */}
        <span class="sr-only">Search opportunities</span>
      </a>

      {
        user ? (
          <>
            <a
              href="/you/inbox"
              class="relative inline-flex size-11 items-center justify-center rounded-row text-ink no-underline hover:bg-sunken sm:w-auto sm:gap-2 sm:px-3"
            >
              <Icon name="mail" size={20} />
              <span class="sr-only text-dense sm:not-sr-only">Messages</span>
              {unread > 0 && (
                <span class="sr-only text-dense font-semibold text-brand sm:not-sr-only">
                  ({unread})
                </span>
              )}
            </a>
            <a
              href="/you"
              class="inline-flex size-11 items-center justify-center rounded-row text-ink no-underline hover:bg-sunken sm:w-auto sm:gap-2 sm:px-3"
            >
              <Icon name="you" size={20} />
              <span class="sr-only text-dense sm:not-sr-only">{user.display_name ?? "Your account"}</span>
            </a>
          </>
        ) : (
          <a
            href={`/signin?returnTo=${encodeURIComponent(pathname)}`}
            class="inline-flex min-h-11 items-center rounded-row border border-line-strong bg-surface px-4 text-dense font-semibold text-ink no-underline hover:bg-sunken"
          >
            Sign in
          </a>
        )
      }
    </div>
  </div>
</header>
