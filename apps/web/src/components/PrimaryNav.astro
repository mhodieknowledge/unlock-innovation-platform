---
// The primary navigation at lg and up: §5.7's "top bar, logotype left, primary nav
// centre-left, search centre, account right".
//
// Below lg this renders nothing. The same destinations are in MenuButton.astro, which
// is a separate component rather than a branch in here for one concrete reason: the
// menu must sit at the END of the header's right-hand cluster so its panel opens on
// screen, and this row must sit beside the wordmark. One component cannot be in two
// places in the bar.

import Icon from "./Icon.astro";
import { PRIMARY_NAV, isCurrent } from "../lib/nav";

interface Props {
  pathname: string;
}

const { pathname } = Astro.props;
---

<nav aria-label="Primary" class="hidden lg:flex lg:items-center lg:gap-1">
  {
    PRIMARY_NAV.map((item) => {
      const current = isCurrent(item.href, pathname);
      return (
        <a
          href={item.href}
          aria-current={current ? "page" : undefined}
          class={`inline-flex min-h-11 items-center gap-2 rounded-row px-3 text-dense no-underline ${
            current ? "bg-brand-wash font-semibold text-brand" : "text-ink-2 hover:bg-sunken"
          }`}
        >
          <Icon name={item.icon} size={20} />
          {item.label}
        </a>
      );
    })
  }
</nav>
