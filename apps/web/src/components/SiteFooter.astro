---
// The footer, from design/Main.body.html: "four short columns, not a second navigation."
//
// The wordmark and one line of what this is, then Explore / Trust / About / Legal, then
// the low-data line. The columns are short on purpose — a footer that repeats the whole
// site is a second navigation, and the primary one is already two taps away.
//
// MODERATION_AND_TRUST.md §2.1 rule 3 keeps the no-fee statement permanent and prominent.
// The redesign moves it OUT of here and into the trust panel on the board, where it sits
// beside the two other promises it belongs with — so it is still on the page that
// matters, and stated once rather than twice.

import { BRAND, NO_FEE_STATEMENT } from "@mbele/config";

import Icon from "./Icon.astro";

interface Props {
  lowData?: boolean;
  pathname: string;
  search: string;
  /** The board renders the trust panel; every other page keeps rule 3's line down here. */
  trustPanelAbove?: boolean;
}

const { lowData = false, pathname, search, trustPanelAbove = false } = Astro.props;

const GROUPS: { heading: string; links: { label: string; href: string }[] }[] = [
  {
    heading: "Explore",
    links: [
      { label: "Opportunities", href: "/opportunities" },
      { label: "Categories", href: "/categories" },
      { label: "Countries", href: "/countries" },
      { label: "Saved", href: "/tracker" },
    ],
  },
  {
    heading: "Trust",
    links: [
      { label: "Spotting scams", href: "/anti-scam" },
      { label: "What verification means", href: "/verification" },
      { label: "Report a problem", href: "/report" },
    ],
  },
  {
    heading: "About",
    links: [
      { label: "Tell us about an opportunity", href: "/submit" },
      { label: "Our crawler", href: "/bot" },
      { label: "Policy changes", href: "/changelog" },
    ],
  },
  {
    heading: "Legal",
    links: [
      { label: "Privacy", href: "/privacy" },
      { label: "Terms", href: "/terms" },
      { label: "Content policy", href: "/content-policy" },
    ],
  },
];
---

<footer class="mt-16 border-t border-line bg-sunken">
  <div class="mx-auto max-w-[1160px] px-4 pt-10 pb-6">
    <span class="text-[22px] font-bold leading-6 tracking-[-0.02em] text-brand">{BRAND.name}</span>
    <p class="mt-2 max-w-[320px] text-dense text-ink-2">
      Open opportunities across Africa, checked against their sources.
    </p>

    {
      /* Rule 3, for every page that does not carry the trust panel. */
      !trustPanelAbove && (
        <p class="mt-5 max-w-[420px] rounded-sheet border border-line bg-surface p-3 text-dense font-medium text-ink">
          {NO_FEE_STATEMENT}
        </p>
      )
    }

    {/*
      FOUR GROUPS, FOLDED ON A PHONE AND OPEN ON A DESKTOP.

      Fourteen links in a two-column grid ran to 576px on a 664px phone — a screen of
      footer under every page, most of it scrolled past. As `<details>` they are four
      44px rows a reader can open, and the links are still in the HTML either way, so a
      crawler and a reader without JavaScript see exactly what they saw before.

      No script does this. `md:open-on-desktop` (tokens.css) overrides the browser's own
      `details:not([open]) > *:not(summary) { display: none }` at the breakpoint and hides
      the summary's marker, so the same markup is an accordion on a phone and four plain
      columns above it — where 576px of footer was never the problem.

      The touch targets are the links themselves, not the text inside them: a 20px link in
      a list of fourteen is a target you miss, which is how a footer becomes decoration.
    */}
    <div class="mt-8 grid grid-cols-1 gap-y-1 md:mt-9 md:grid-cols-4 md:gap-x-8 md:gap-y-8">
      {
        GROUPS.map((group) => (
          <details class="md:open-on-desktop group border-b border-line md:border-0">
            <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between text-dense font-semibold text-ink md:mb-1 md:cursor-default md:text-ink-3 md:font-normal md:uppercase md:tracking-[0.08em] md:text-micro [&::-webkit-details-marker]:hidden">
              {group.heading}
              <span class="text-ink-3 transition-transform group-open:rotate-180 md:hidden" aria-hidden="true">
                <Icon name="chevron" size={20} class="h-4 w-4 rotate-90" />
              </span>
            </summary>
            <nav aria-label={group.heading} class="flex flex-col pb-2 md:pb-0">
              {group.links.map((link) => (
                <a
                  href={link.href}
                  class="flex min-h-11 items-center text-dense text-ink-2 no-underline hover:text-brand hover:underline"
                >
                  {link.label}
                </a>
              ))}
            </nav>
          </details>
        ))
      }
    </div>

    <div class="mt-9 flex flex-wrap items-center gap-2 border-t border-line pt-4">
      {/* §10: "A persistent meta line in the footer." A form, not a script — the mode
          exists for people whose connection cannot afford a bundle, and a toggle that
          needed one would be a joke at their expense. */}
      <form method="post" action="/low-data" class="flex flex-wrap items-center gap-2">
        <input type="hidden" name="on" value={lowData ? "0" : "1"} />
        <input type="hidden" name="returnTo" value={pathname + search} />
        <span class="text-micro text-ink-3">
          {lowData ? "Low-data mode is on." : "Paying by the megabyte?"}
        </span>
        <button type="submit" class="min-h-11 text-micro font-semibold text-ink-2 underline">
          {lowData ? "Turn it off" : "Turn on low-data mode"}
        </button>
      </form>
    </div>
  </div>
</footer>
