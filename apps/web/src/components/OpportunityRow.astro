---
// The primary object. DESIGN_SYSTEM.md §5.1.
//
// Deliberately: no image, no logo, no shadow, no hover lift. Rows are separated
// by hairlines — shadows on a list of 40 rows are visual noise and a rendering
// cost on low-end GPUs (§4.3). Hover changes background to --sunken only.
//
// The status rail carries the eligibility colour and is the ONLY colour in the
// row. Server-side it renders NEUTRAL, because the page is cached identically for
// every viewer and we genuinely do not know who is reading. Colouring it from a
// guess would be worse than leaving it grey: DESIGN_SYSTEM.md §1.2 says colour
// appearing means something has been determined about *you*.

import type { OpportunityRow as Row } from "../lib/db";
import { countdownLabel, countdownWeight, deadlineFacts, freshnessLabel } from "../lib/deadline";
import { VERDICTS } from "../lib/verdict";

interface Props {
  opportunity: Row;
  /**
   * DESIGN_SYSTEM.md §10. In low-data mode the fact grid collapses to the two facts that
   * decide anything — the countdown and eligibility — and the freshness line goes. Every
   * cell dropped is real bytes on a metered connection, and §10's 40 KB target for a page
   * of thirty of these rows is not reachable while each row carries four.
   */
  lowData?: boolean;
}

const { opportunity: o, lowData = false } = Astro.props;

const facts = deadlineFacts({
  deadline_at: o.deadline_at,
  deadline_precision: o.deadline_precision as never,
  opens_at: o.opens_at,
  is_rolling: o.is_rolling,
});

const closed = facts.state === "closed" || o.status === "expired";

const prize =
  o.prize_amount && o.prize_currency
    ? `${o.prize_currency} ${Number(o.prize_amount).toLocaleString("en")}`
    : null;

const team =
  o.team_size_min && o.team_size_max
    ? `${o.team_size_min}–${o.team_size_max}`
    : o.team_required === false
      ? "Individual"
      : null;

/**
 * The facts worth a cell, and only those.
 *
 * `Closes` is deliberately NOT among them. §5.1's diagram carries the countdown inside
 * the grid, but this row also renders it above at `countdown-sm` in black, because §1.2
 * makes it "the single most typographically prominent thing on any card". Keeping both
 * printed the deadline twice, four millimetres apart — "4 days left" and then
 * "Closes / 4 Days Left" — which is the kind of duplication that makes a dense list feel
 * padded rather than informative.
 *
 * A fact we do not have is omitted rather than rendered as an em dash. A grid of
 * "Format —" and "Team —" tells the reader nothing and costs them a cell they have to
 * read to discover that. §6.4's instinct about empty states applies inside a row too.
 */
const candidates: ([string, string] | null)[] = [
  o.participation_mode === "unknown"
    ? null
    : ["Format", o.participation_mode.replace(/_/g, " ")],
  team ? ["Team", team] : null,
  prize ? ["Prize", prize] : null,
  // Cost last, and only when stated. Invariant 13 turns on this field, so `unknown` is
  // shown as nothing rather than implied to be free.
  o.cost === "free" ? ["Cost", "Free"] : o.cost === "paid" ? ["Cost", "Has a cost"] : null,
];

const known = candidates.filter((c): c is [string, string] => c !== null);

/**
 * §10: in low-data mode the grid collapses to "the two most important facts (countdown,
 * eligibility)" — the ones a decision turns on, not the first two that happen to exist.
 *
 * The countdown is one of them and is already rendered above, so it costs this grid
 * nothing. Of what remains, only cost can change whether someone should apply at all:
 * invariant 13 turns on that field. Format and team size are context, and context is
 * what a reader paying by the kilobyte is choosing not to buy.
 */
const cells: [string, string][] = lowData
  ? known.filter(([label]) => label === "Cost")
  : known;
---

<article
  class={`relative flex gap-0 border-b border-line bg-surface transition-colors hover:bg-sunken ${closed ? "opacity-60" : ""}`}
>
  <!-- Status rail: 3px, full height. Neutral until a verdict exists for the
       reader (see the note at the top of this file). -->
  <span class={`w-[3px] shrink-0 ${VERDICTS.unknown.rail}`} aria-hidden="true"></span>

  <div class={`flex-1 px-3 ${lowData ? "min-h-[64px] py-2" : "min-h-[88px] py-3"}`}>
    <h3 class="text-dense font-semibold">
      <!-- Whole row is the link; the save control below has its own hit area. -->
      <a href={`/opportunities/${o.slug}`} class="text-ink no-underline hover:underline">
        {o.title}
      </a>
    </h3>

    <p class="mt-[2px] text-meta text-ink-2">
      {o.organisations?.name ?? "Organisation not identified"}
      <span aria-hidden="true"> · </span>
      <span>{o.verification}</span>
    </p>

    <!-- Countdown: black, tabular, weight by urgency. Not a badge — urgency is
         typographic, never a coloured pill (DESIGN_SYSTEM.md §5.5). -->
    <p
      class={`mt-2 text-countdown-sm ${closed ? "text-ink-3 line-through" : "text-absolute"}`}
      style={`font-weight:${countdownWeight(facts.daysRemaining)}`}
    >
      {closed ? "Closed" : countdownLabel(facts)}
    </p>

    <!-- Fact grid: labelled cells with hairlines, never a middle-dot string. Absent
         entirely when there is no fact to put in it, rather than drawn empty. -->
    {
      cells.length > 0 && (
        <dl class="mt-2 grid grid-cols-2 border-t border-line md:grid-cols-4">
          {cells.map(([label, value]) => (
            <div class="border-b border-r border-line px-2 py-1 last:border-r-0">
              <dt class="text-micro font-semibold text-ink-2">{label}</dt>
              <dd class="text-dense capitalize">{value}</dd>
            </div>
          ))}
        </dl>
      )
    }

    <p class="mt-2 flex items-center justify-between gap-3 text-meta text-ink-2">
      <!-- Freshness: monochrome, deliberately quiet. Dropped in low-data mode, where the
           reader is paying by the kilobyte and the detail page still carries it in full. -->
      <span>{lowData ? "" : freshnessLabel(o.last_verified_at)}</span>
      {
        !closed && (
          <a
            href={`/tracker?add=${o.slug}`}
            class="inline-flex min-h-11 items-center rounded-row border border-line-strong bg-surface px-3 font-semibold text-ink no-underline"
            >Save</a
          >
        )
      }
    </p>
  </div>
</article>
