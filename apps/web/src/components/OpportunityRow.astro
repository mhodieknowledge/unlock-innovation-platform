---
// The primary object, redesigned as a card. Kept in this file (and its Props
// shape) unchanged so every existing call site — the homepage, the listing
// page, categories, countries, organisation pages — picks up the new design
// with no changes elsewhere.
//
// The old row optimised for density: a fact grid of up to four cells on every
// card, plus a separate "checked N days ago" line. That is exactly the
// "database record" reading this redesign removes. A card now shows the
// things a reader decides on — what it is, who runs it, when it closes, one
// standout fact — and nothing else. Team size, format and the full
// verification story move to the opportunity detail page, where there is
// room to earn them.

import type { OpportunityRow as Row } from "../lib/db";
import { countdownLabel, countdownWeight, deadlineFacts } from "../lib/deadline";
import { verificationLabel } from "../lib/verification";

import Icon from "./Icon.astro";

interface Props {
  opportunity: Row;
  /** Low-data mode drops the standout-fact badge; everything else is already minimal. */
  lowData?: boolean;
}

const { opportunity: o, lowData = false } = Astro.props;

const facts = deadlineFacts({
  deadline_at: o.deadline_at,
  deadline_precision: o.deadline_precision as never,
  opens_at: o.opens_at,
  is_rolling: o.is_rolling,
});

const closed = facts.state === "closed" || o.status === "expired";
const urgent = !closed && facts.daysRemaining !== null && facts.daysRemaining <= 2;

const closesOn =
  facts.effectiveAt && !closed && o.deadline_precision !== "month_only"
    ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", timeZone: "UTC" }).format(
        facts.effectiveAt,
      )
    : null;

const prize =
  o.prize_amount && o.prize_currency
    ? `${o.prize_currency} ${Number(o.prize_amount).toLocaleString("en")}`
    : null;

// One standout fact, in priority order — a prize figure beats a plain "free", which
// beats a paid notice. This is the single badge the brief asks for, not a grid of four.
const standoutFact: string | null = prize
  ? prize
  : o.cost === "free"
    ? "Free to apply"
    : o.cost === "paid"
      ? "Has a cost"
      : null;

const categoryLabel = o.categories?.name && o.categories.code !== "other" ? o.categories.name : null;
const verLabel = verificationLabel(o.verification);
---

<article
  class={`group relative flex flex-col rounded-sheet border border-line bg-surface p-4 shadow-card transition-shadow hover:shadow-card-hover ${closed ? "opacity-60" : ""}`}
>
  {/* Badge row: category + one standout fact. Neutral, not a colour wash — the brief's
      restraint applies here too; colour is spent on the primary action only. */}
  <div class="flex flex-wrap items-center gap-[6px]">
    {
      categoryLabel && (
        <span class="eyebrow rounded-row bg-sunken px-2 py-1 text-ink-2">{categoryLabel}</span>
      )
    }
    {
      !lowData && standoutFact && (
        <span class="eyebrow rounded-row border border-line-strong px-2 py-1 text-ink-2">
          {standoutFact}
        </span>
      )
    }
    {
      /* §10: one fact cell, not four. Cost is the only one a decision turns on, so it is the
         one kept when every other byte is being counted. */
      lowData && (
        <span class="eyebrow rounded-row bg-sunken px-2 py-1 text-ink-2">
          <span>Cost</span>: {o.cost === "free" ? "Free" : o.cost === "paid" ? "Has a cost" : "Not stated"}
        </span>
      )
    }
  </div>

  <h3 class="mt-[10px] line-clamp-2 text-[17px] leading-[23px] font-semibold tracking-[-0.01em]">
    <a href={`/opportunities/${o.slug}`} class="text-ink no-underline after:absolute after:inset-0">
      {o.title}
    </a>
  </h3>

  {/*
    ORGANISER AND HOW IT WAS CHECKED, on one line, with only the organiser allowed to
    truncate.

    `truncate` used to be on the whole line, which sets `white-space: nowrap` and an
    ellipsis on everything inside it — so a long organiser name ate the verification. On
    the live board "African Leadership Institute (AFLI) Archbishop Tutu Fellowship"
    rendered with no verification at all, and it is one of the two facts that tell a
    reader whether this listing has been looked at. A flex row with `min-w-0` on the name
    and `shrink-0` on the status truncates the part that can afford it.
  */}
  <p class="mt-1 flex items-center gap-1 text-meta text-ink-2">
    <span class="min-w-0 truncate">{o.organisations?.name ?? "Organisation not identified"}</span>
    {
      verLabel && (
        <span class="flex shrink-0 items-center gap-1 text-ink-3">
          <span aria-hidden="true">·</span>
          <Icon name="check" size={20} class="h-3 w-3" />
          <span class="whitespace-nowrap">{verLabel}</span>
        </span>
      )
    }
  </p>

  <div class="mt-auto flex items-end justify-between gap-3 pt-3">
    <p class="flex flex-col">
      <span
        class={`text-countdown-sm ${closed ? "text-ink-3 line-through" : urgent ? "text-noteligible" : "text-ink"}`}
        style={`font-weight:${countdownWeight(facts.daysRemaining)}`}
      >
        {closed ? "Closed" : countdownLabel(facts)}
      </span>
      {closesOn && <span class="text-meta text-ink-3">Closes {closesOn}</span>}
    </p>

    {
      !closed && (
        <a
          href={`/tracker?add=${o.slug}`}
          class="relative z-10 inline-flex min-h-11 shrink-0 items-center gap-[6px] rounded-monogram border border-line-strong bg-surface px-3 text-meta font-semibold text-ink no-underline hover:bg-sunken"
        >
          <Icon name="tracker" size={20} class="h-[15px] w-[15px]" />
          Save
        </a>
      )
    }
  </div>
</article>
