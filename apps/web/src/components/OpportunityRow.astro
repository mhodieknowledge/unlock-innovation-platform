---
// The primary object, as a card, on every surface that lists one. Kept in this
// file so the homepage, the listing page, categories, countries and
// organisation pages share one definition of what a listing shows.
//
// A BORDERLESS LIST ROW WAS TRIED HERE AND REVERTED. The argument for it was
// DESIGN_SYSTEM.md §1's own rejection table ("Identical rounded cards with the
// same soft grey shadow → No. Rows with a status rail") plus the observation
// that a border has nothing to separate in a single column. Both are true on
// paper. Built and looked at, the page read as a spreadsheet: hairlines are
// not enough to group four facts into one object, so the eye has to do the
// grouping itself on every row, and the board stopped looking like somewhere
// a person would want to spend time. The card's border is not decoration —
// it is the thing that says "these four facts are one opportunity".
//
// What survived from that pass is in the page, not here: the board scrolls
// vertically instead of sideways, and the photographic category bands are
// gone. Those were the real complaints. The card was not.
//
// The old row optimised for density: a fact grid of up to four cells on every
// card, plus a separate "checked N days ago" line. That is exactly the
// "database record" reading this redesign removes. A card now shows the
// things a reader decides on — what it is, who runs it, when it closes, one
// standout fact — and nothing else. Team size, format and the full
// verification story move to the opportunity detail page, where there is
// room to earn them.

import type { OpportunityRow as Row } from "../lib/db";
import { countdownLabel, countdownWeight, deadlineFacts } from "../lib/deadline";
import { categoryIcon } from "../lib/categories";
import { verificationLabel } from "../lib/verification";

import Icon from "./Icon.astro";

interface Props {
  opportunity: Row;
  /** Low-data mode drops the standout-fact badge; everything else is already minimal. */
  lowData?: boolean;
  /**
   * Drop the category label. For a section that is already under a category heading, where
   * "AI CHALLENGE" on all five cards of the "AI challenges" section is the heading read
   * back five times in a smaller font.
   */
  hideCategory?: boolean;
}

const { opportunity: o, lowData = false, hideCategory = false } = Astro.props;

const facts = deadlineFacts({
  deadline_at: o.deadline_at,
  deadline_precision: o.deadline_precision as never,
  opens_at: o.opens_at,
  is_rolling: o.is_rolling,
});

const closed = facts.state === "closed" || o.status === "expired";
const urgent = !closed && facts.daysRemaining !== null && facts.daysRemaining <= 2;

const closesOn =
  facts.effectiveAt && !closed && o.deadline_precision !== "month_only"
    ? new Intl.DateTimeFormat("en-GB", { day: "numeric", month: "short", timeZone: "UTC" }).format(
        facts.effectiveAt,
      )
    : null;

const prize =
  o.prize_amount && o.prize_currency
    ? `${o.prize_currency} ${Number(o.prize_amount).toLocaleString("en")}`
    : null;

// One standout fact, in priority order — a prize figure beats a plain "free", which
// beats a paid notice. This is the single badge the brief asks for, not a grid of four.
const standoutFact: string | null = prize
  ? prize
  : o.cost === "free"
    ? "Free to apply"
    : o.cost === "paid"
      ? "Has a cost"
      : null;

const categoryLabel =
  !hideCategory && o.categories?.name && o.categories.code !== "other" ? o.categories.name : null;
/**
 * WHAT THE CARD SAYS ABOUT HOW THIS LISTING WAS CHECKED — AND WHEN IT SAYS NOTHING.
 *
 * `auto` is suppressed here. "Checked automatically" was on the large majority of cards on
 * the board, which is the definition of a label that is not telling anyone anything: a fact
 * true of nearly every row cannot help a reader choose between rows. It was also the weakest
 * claim in the set, spending a line of every card to say that nobody had looked yet.
 *
 * The rest still show, and the ones that are NOT reassuring matter most: `stale`,
 * `community_flagged` and `disputed` are the states MODERATION_AND_TRUST.md §2.2 puts a
 * listing into the moment a scam or payment report arrives, and a board that hid those to
 * look tidier would be the wrong trade in the one place this product cannot afford it.
 *
 * Nothing is lost for `auto`: the detail page prints the full verification story in its
 * "Source & verification" section, where there is room to say what an automated check is
 * and — per /verification's promise — that it is pending rather than verified.
 */
const verLabel = o.verification === "auto" ? null : verificationLabel(o.verification);

/**
 * A TICK IS NOT A NEUTRAL BULLET, so the mark follows the state rather than the position.
 *
 * Every one of these rendered `check` — including "Disputed", which MODERATION_AND_TRUST.md
 * §2.2 sets the moment a scam or payment report arrives. A green-adjacent tick beside the
 * word Disputed does not read as punctuation; it reads as "checked, and fine", which is the
 * opposite of what the field is saying. It went unnoticed while `auto` covered most of the
 * board and the tick was, in practice, always beside an innocuous label.
 *
 * `official` and `verified` are the only two states that are an endorsement. The rest are
 * warnings or absences of confirmation, and take the alert mark in the warning colour.
 */
const verPositive = o.verification === "official" || o.verification === "verified";

/**
 * THE PICTURE, AND THE FACT THAT MOST LISTINGS DO NOT HAVE ONE.
 *
 * `image_url` is the `og:image` the source published on its own page (migration 0038), and it
 * is null for the majority of listings because most sources publish no such tag.
 *
 * That asymmetry is the whole design problem, and this page has now got it wrong twice in
 * other forms: a category grid that was half photographs and half tinted boxes, and before
 * that a band whose photograph decided which category got featured. Both times the lesson was
 * the same — when only some cards have a picture, the ones without read as BROKEN rather than
 * as a deliberate variant, and the eye goes to the pictures rather than to the deadlines.
 *
 * So the header is not optional. Every card has one, at the same 16:9, and what fills it is
 * either the source's photograph or a brand-tinted panel carrying the category mark. Neither
 * pretends to be the other, and a reader scanning the board is comparing listings rather than
 * noticing which ones came with artwork.
 *
 * In low-data mode there is no header at all — not a placeholder, not a wash. PRODUCT_SPEC.md
 * §25.2 suppresses all images, and a decorative panel that costs nothing to send still costs
 * a third of a screen to scroll past on a phone someone is paying for by the megabyte.
 *
 * THE RATIO IS SHORTER ON A PHONE, and that is a measurement rather than a preference. At
 * 16:9 a full-width card header is 201px on a 390px screen; across the eighteen cards this
 * page carries, the board grew from 6,134px to 9,666px — half a page of scrolling bought with
 * artwork. 5:2 gives a banner of 143px and returns most of it. Above `md` the cards are
 * narrow columns rather than the full width, so 16:9 costs little and crops the source's
 * picture less.
 */
const showHeader = !lowData;
const categoryIconName = categoryIcon(o.categories?.code);
const hasPicture = showHeader && typeof o.image_url === "string" && o.image_url.length > 0;
---

<article
  class={`group relative flex flex-col rounded-sheet border border-line bg-surface p-4 shadow-card transition-shadow hover:shadow-card-hover ${closed ? "opacity-60" : ""}`}
>
{
  showHeader && (
    <div class="-mx-4 -mt-4 mb-3 aspect-[5/2] overflow-hidden rounded-t-sheet bg-brand-wash md:aspect-[16/9]">
      {hasPicture ? (
        /*
          SERVED FROM OUR OWN ORIGIN, never from the source's CDN — see pages/img/[slug].ts.
          The `src` is a slug, not a URL: the route looks the URL up rather than accepting one,
          which is what keeps this from being a server-side request forgery endpoint.

          `alt=""` and aria-hidden, deliberately. This is the organiser's promotional artwork,
          and we have not read it — describing it would mean inventing a description, which is
          the one thing this product does not do with a source's material. Everything a reader
          needs is in the text below, so a screen reader loses nothing by skipping it.

          Width and height are the 16:9 box rather than the real file's dimensions, which we do
          not record: the container fixes the aspect ratio and `object-cover` crops to it, so
          these exist to reserve the space and stop the card shifting when the picture lands.
        */
        <img
          src={`/img/${o.slug}`}
          alt=""
          aria-hidden="true"
          width="480"
          height="270"
          loading="lazy"
          decoding="async"
          class="h-full w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
        />
      ) : (
        /* The same box, with the category's mark instead. Not a "missing image" state — a
           card that never had a picture and is not pretending otherwise. */
        <div class="flex h-full w-full items-center justify-center bg-gradient-to-br from-brand-wash to-sunken text-brand/40">
          <Icon name={categoryIconName} size={24} class="h-8 w-8" />
        </div>
      )}
    </div>
  )
}

{/* Badge row: category + one standout fact. Neutral, not a colour wash — the brief's
    restraint applies here too; colour is spent on the primary action only. */}
<div class="flex flex-wrap items-center gap-[6px]">
  {categoryLabel && (
    <span class="eyebrow rounded-row bg-sunken px-2 py-1 text-ink-2">{categoryLabel}</span>
  )}
  {!lowData && standoutFact && (
    <span class="eyebrow rounded-row border border-line-strong px-2 py-1 text-ink-2">
      {standoutFact}
    </span>
  )}
  {/* §10: one fact cell, not four. Cost is the only one a decision turns on, so it is
      the one kept when every other byte is being counted. */}
  {lowData && (
    <span class="eyebrow rounded-row bg-sunken px-2 py-1 text-ink-2">
      <span>Cost</span>: {o.cost === "free" ? "Free" : o.cost === "paid" ? "Has a cost" : "Not stated"}
    </span>
  )}
</div>

<h3 class="mt-[10px] line-clamp-2 text-[17px] leading-[23px] font-semibold tracking-[-0.01em]">
  <a href={`/opportunities/${o.slug}`} class="text-ink no-underline after:absolute after:inset-0">
    {o.title}
  </a>
</h3>

{/*
  ORGANISER AND HOW IT WAS CHECKED, on one line, with only the organiser allowed to
  truncate.

  `truncate` used to be on the whole line, which sets `white-space: nowrap` and an
  ellipsis on everything inside it — so a long organiser name ate the verification. On
  the live board "African Leadership Institute (AFLI) Archbishop Tutu Fellowship"
  rendered with no verification at all, and it is one of the two facts that tell a
  reader whether this listing has been looked at. A flex row with `min-w-0` on the name
  and `shrink-0` on the status truncates the part that can afford it.
*/}
<p class="mt-1 flex items-center gap-1 text-meta text-ink-2">
  <span class="min-w-0 truncate">{o.organisations?.name ?? "Organisation not identified"}</span>
  {verLabel && (
    <span class={`flex shrink-0 items-center gap-1 ${verPositive ? "text-ink-3" : "text-unclear"}`}>
      <span aria-hidden="true">·</span>
      <Icon name={verPositive ? "check" : "alert"} size={20} class="h-3 w-3" />
      <span class="whitespace-nowrap">{verLabel}</span>
    </span>
  )}
</p>

<div class="mt-auto flex items-end justify-between gap-3 pt-3">
  <p class="flex flex-col">
    <span
      class={`text-countdown-sm ${closed ? "text-ink-3 line-through" : urgent ? "text-noteligible" : "text-ink"}`}
      style={`font-weight:${countdownWeight(facts.daysRemaining)}`}
    >
      {closed ? "Closed" : countdownLabel(facts)}
    </span>
    {closesOn && <span class="text-meta text-ink-3">Closes {closesOn}</span>}
  </p>

  {!closed && (
    <a
      href={`/tracker?add=${o.slug}`}
      class="relative z-10 inline-flex min-h-11 shrink-0 items-center gap-[6px] rounded-monogram border border-line-strong bg-surface px-3 text-meta font-semibold text-ink no-underline hover:bg-sunken"
    >
      <Icon name="tracker" size={20} class="h-[15px] w-[15px]" />
      Save
    </a>
  )}
</div>
</article>
