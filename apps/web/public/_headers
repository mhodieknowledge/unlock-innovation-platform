# Cloudflare Pages/Workers response headers. SECURITY.md §5.
#
# CSP carries no `unsafe-inline` — stylesheets are external (see
# astro.config.mjs) and no inline script is emitted. `connect-src` is widened
# per-environment at deploy time for the Supabase origin.

/*
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; form-action 'self'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), camera=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin

# Content-hashed assets: immutable, cached for a year.
/_a/*
  Cache-Control: public, max-age=31536000, immutable

# API_SPEC.md §1.4 — authenticated and evaluation endpoints are never cached.
/api/*
  Cache-Control: private, no-store

# SYSTEM_ARCHITECTURE.md §3.4. A service worker that outlives a deploy keeps serving the
# previous shell, so neither the worker nor the file it imports may be cached: `no-cache`
# still allows a 304, so the cost of revalidating is a few bytes. Browsers cap service-worker
# script caching at 24 hours anyway; this makes it zero, which is what a deploy needs.
/sw.js
  Cache-Control: no-cache
  Service-Worker-Allowed: /

/sw-routes.js
  Cache-Control: no-cache

/sw-register.js
  Cache-Control: no-cache

# The manifest and the app icon change about once a year and are 1 KB together.
/manifest.webmanifest
  Cache-Control: public, max-age=3600

/icon.svg
  Cache-Control: public, max-age=604800

# The static social card (SEO.md §4). One file for the whole site, fetched by crawlers and
# messaging apps rather than by readers, and it changes about as often as the brand does.
/og.png
  Cache-Control: public, max-age=604800
